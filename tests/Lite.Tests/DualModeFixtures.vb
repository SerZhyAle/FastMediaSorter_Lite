#If Not NETFRAMEWORK Then
Option Strict On

Imports System.Collections.Generic
Imports System.IO
Imports System.Linq
Imports System.Security.Cryptography
Imports System.Text
Imports System.Text.RegularExpressions
Imports Xunit

''' <summary>
''' The committed "today" baseline of ticket 177 (dual mode) - what the programs did BEFORE any exchange client
''' code existed - and the one place that reads it. It lives in <c>TestData\dual-mode</c> beside a
''' <c>PROVENANCE.txt</c> whose SHA-256 of every other file is checked FIRST, by every test that reads a
''' fixture: a baseline that was edited by hand to fit a change proves nothing.
'''
''' Compiled into Lite.Tests and linked into Companion.Tests (like the log-package tests), because the
''' viewer's capture and the Share Manager's export belong to different programs and one rule reads both.
''' </summary>
Friend Module DualModeFixtures

    ''' <summary>The one folder the generators write when this variable names it (a hand run, never a default run).</summary>
    Friend Const GeneratorVariable As String = "FMS_WRITE_DUAL_MODE_BASELINE"

    ''' <summary>A registry value name or a log word of the CLIENT side of the exchange. A machine with no account
    ''' has none of these (177 section 2, "Registry" and "Files").</summary>
    Friend ReadOnly ExchangeValuePattern As New Regex(
        "(^|\\)(Exchange_(DeviceId|Account|Login|Server|Endpoint|Pin|Agent|Features|Paired|Enrolled)|Exchange.?Client|FmsX_|DeviceExchange)",
        RegexOptions.IgnoreCase Or RegexOptions.CultureInvariant)

    Friend Function FixtureDirectory() As String
        Return Path.Combine(AppContext.BaseDirectory, "TestData", "dual-mode")
    End Function

    Friend Function FixturePath(name As String) As String
        Return Path.Combine(FixtureDirectory(), name)
    End Function

    Friend Function Sha256Hex(bytes As Byte()) As String
        Using sha As SHA256 = SHA256.Create()
            Return BitConverter.ToString(sha.ComputeHash(bytes)).Replace("-", "").ToLowerInvariant()
        End Using
    End Function

    ''' <summary>Fails the calling test unless PROVENANCE.txt names exactly the files in the folder and every
    ''' SHA-256 matches. Every test that reads a fixture calls this as its first line.</summary>
    Friend Sub VerifyProvenance()
        Dim provenance As String = FixturePath("PROVENANCE.txt")
        Assert.True(File.Exists(provenance), "TestData\dual-mode\PROVENANCE.txt is missing: " & provenance)
        Dim listed As New Dictionary(Of String, String)(StringComparer.OrdinalIgnoreCase)
        For Each line As String In File.ReadAllLines(provenance, Encoding.UTF8)
            If line.Length = 0 OrElse line(0) = "#"c Then Continue For
            Dim parts As String() = line.Split(ControlChars.Tab)
            Assert.True(parts.Length = 2, "a malformed PROVENANCE line: " & line)
            listed(parts(0)) = parts(1).Trim()
        Next
        Dim present As List(Of String) = Directory.GetFiles(FixtureDirectory()).
            Select(Function(f) Path.GetFileName(f)).
            Where(Function(n) Not String.Equals(n, "PROVENANCE.txt", StringComparison.OrdinalIgnoreCase)).
            OrderBy(Function(n) n, StringComparer.OrdinalIgnoreCase).ToList()
        Assert.Equal(listed.Keys.OrderBy(Function(n) n, StringComparer.OrdinalIgnoreCase).ToList(), present)
        For Each pair As KeyValuePair(Of String, String) In listed
            Dim actual As String = Sha256Hex(File.ReadAllBytes(FixturePath(pair.Key)))
            Assert.True(String.Equals(actual, pair.Value, StringComparison.OrdinalIgnoreCase),
                        pair.Key & " no longer matches PROVENANCE.txt (" & actual & " against " & pair.Value &
                        "): a baseline is regenerated by its tool, never edited.")
        Next
    End Sub

End Module

''' <summary>A fact that needs one of the committed fixtures: skipped, loudly and by name, while the file is not
''' there - never a pass. The Share Manager's capture, for one, cannot be taken on a machine where a Share
''' Manager already runs (its single-instance mutex is machine-session wide), so its file may be absent.</summary>
Public NotInheritable Class FactWhenFixtureAttribute
    Inherits FactAttribute

    Public Sub New(fileName As String)
        If Not File.Exists(DualModeFixtures.FixturePath(fileName)) Then
            Skip = "the fixture " & fileName & " is not committed: run tests\Integration\ExchangeBaseline.ps1 on a machine where it can be captured"
        End If
    End Sub
End Class

''' <summary>A generator: skipped unless <see cref="DualModeFixtures.GeneratorVariable"/> names a folder.</summary>
Public NotInheritable Class GeneratorFactAttribute
    Inherits FactAttribute

    Public Sub New()
        If String.IsNullOrEmpty(Environment.GetEnvironmentVariable(DualModeFixtures.GeneratorVariable)) Then
            Skip = "a generator: set " & DualModeFixtures.GeneratorVariable & " to the TestData\dual-mode folder to write the fixtures"
        End If
    End Sub
End Class
#End If
