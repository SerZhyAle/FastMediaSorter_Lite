#If Not NETFRAMEWORK Then
Option Strict On

Imports System.Globalization
Imports System.IO
Imports System.Linq
Imports System.Security.Cryptography
Imports System.Text
Imports System.Text.Json
Imports Xunit

''' <summary>
''' Conformance of the FDSEC reader against the catalog's committed vectors
''' (026_SPECIFICATION_SECURE_CONTAINER_FD_SEC_DOTNET10.md §13, FDSEC-BEHAVIOUR §12.2).
'''
''' This is the part of the feature that decides correctness, and it is the one place in
''' the repository where "the code looks right" is worth nothing: a one-byte deviation
''' anywhere in the derivation, the mask, the associated data or the endianness produces a
''' reader that is perfectly self-consistent and opens nothing anyone else made. So the
''' inputs are somebody else's bytes - two complete containers and every intermediate,
''' generated by the reference implementation - and the vendored copies are checked
''' against their recorded digests before a single one is trusted.
'''
''' The interoperability claim of FDSEC-BEHAVIOUR §12.3 may be stated only after this run
''' passes, with its output cited - never because the code reads correctly.
'''
''' Modern-only: on the net48 leg src/Secure and this file compile to nothing.
''' </summary>
Public Class FdSecConformanceTests

    ' The credential of both reference containers, published in vectors.json. 28 UTF-8
    ' bytes, so it is below the threshold of 64 and takes the Argon2id branch.
    Private Const SlowCredential As String = "correct horse battery staple"

    ' vectors.json publishes root_fast_branch but not the credential behind it - the
    ' catalog's generator holds that string. It is pinned here and PROVEN below against
    ' the published root, so the fast branch is checked rather than assumed. 92 UTF-8
    ' bytes, comfortably at or above the threshold.
    Private Const FastCredential As String =
        "a deliberately long passphrase of more than sixty-four UTF-8 bytes, carrying its own entropy"

    Private Shared ReadOnly VectorDirectory As String =
        Path.Combine(AppContext.BaseDirectory, "TestData", "fdsec-vectors")

    Private Shared ReadOnly Vectors As JsonElement = LoadVectors()

    Private Shared Function LoadVectors() As JsonElement
        Using document As JsonDocument = JsonDocument.Parse(File.ReadAllBytes(Path.Combine(VectorDirectory, "vectors.json")))
            Return document.RootElement.Clone()
        End Using
    End Function

    Private Shared Function Container(name As String) As JsonElement
        Return Vectors.GetProperty("containers").GetProperty(name)
    End Function

    Private Shared Function HexOf(element As JsonElement, ParamArray path As String()) As Byte()
        Dim current As JsonElement = element
        For Each step_ As String In path
            current = current.GetProperty(step_)
        Next
        Return FromHex(current.GetString())
    End Function

    Private Shared Function FromHex(text As String) As Byte()
        If String.IsNullOrEmpty(text) Then Return Array.Empty(Of Byte)()
        Dim bytes(text.Length \ 2 - 1) As Byte
        For i As Integer = 0 To bytes.Length - 1
            bytes(i) = Convert.ToByte(text.Substring(i * 2, 2), 16)
        Next
        Return bytes
    End Function

    Private Shared Function ToHex(bytes As Byte()) As String
        Return String.Concat(bytes.Select(Function(b) b.ToString("x2")))
    End Function

    Private Shared Function ContainerBytes(name As String) As Byte()
        Return File.ReadAllBytes(Path.Combine(VectorDirectory, Container(name).GetProperty("file").GetString()))
    End Function

    ''' <summary>
    ''' A reference container's bytes. "empty" and "onebyte" ship as files; 1.1's three-chunk
    ''' "multi" is published only as its layout fields, so it is assembled from them in
    ''' file order - head, sealed metadata, alignment pad, payload, tail pad - and the result
    ''' is held to the published length and file digest before anything opens it.
    ''' </summary>
    Private Shared Function ReferenceBytes(name As String) As Byte()
        Dim vector As JsonElement = Container(name)
        Dim fileProperty As JsonElement
        If vector.TryGetProperty("file", fileProperty) Then Return ContainerBytes(name)
        Return {"header_on_disk", "slots_on_disk", "sealed_metadata", "align_pad", "payload", "tail_pad"}.
            SelectMany(Function(field) HexOf(vector, "layout", field)).ToArray()
    End Function

    ' ------------------------------------------------------------- provenance ----

    ''' <summary>
    ''' The vendored artifacts still are what PROVENANCE.txt says they are. Without this
    ''' a regenerated or edited vector file would quietly redefine "conformant" and every
    ''' test below would keep passing.
    ''' </summary>
    <Fact>
    Public Sub Vendored_vectors_match_their_recorded_digests()
        Dim provenance As String = File.ReadAllText(Path.Combine(VectorDirectory, "PROVENANCE.txt"))
        Dim checked As Integer = 0

        For Each fileName As String In {"vectors.json", "container-empty.fd-sec", "container-onebyte.fd-sec"}
            Dim actual As String
            Using sha As SHA256 = SHA256.Create()
                actual = ToHex(sha.ComputeHash(File.ReadAllBytes(Path.Combine(VectorDirectory, fileName))))
            End Using
            Assert.Contains("SHA-256  " & actual & "  " & fileName, provenance)
            checked += 1
        Next

        Assert.Equal(3, checked)
    End Sub

    ''' <summary>The profile is a property of the format VERSION, not of the file, so a
    ''' vector set generated under different numbers is a different format and every
    ''' derivation below would be answering a question we are not asking.</summary>
    <Fact>
    Public Sub Published_kdf_profile_is_the_one_this_reader_implements()
        Dim profile As JsonElement = Vectors.GetProperty("kdf_profile")
        Assert.Equal(FdSecProfile.V1.Threshold, profile.GetProperty("threshold").GetInt32())
        Assert.Equal(FdSecProfile.V1.MemoryKib, profile.GetProperty("m_kib").GetInt32())
        Assert.Equal(FdSecProfile.V1.Iterations, profile.GetProperty("t").GetInt32())
        Assert.Equal(FdSecProfile.V1.Lanes, profile.GetProperty("p").GetInt32())
    End Sub

    ' ------------------------------------------------------- both root branches ----

    ''' <summary>
    ''' Both root-key branches, against the published roots, under the empty container's
    ''' salt - and that includes the Argon2id branch with the real work factor, which is
    ''' the only thing that proves porting mistake 1 was avoided: libsodium's crypto_pwhash
    ''' cannot produce this format's parallelism of 4 at all, and a library pinned to the
    ''' wrong Argon2 version or reading the memory as bytes instead of KiB produces a
    ''' plausible root and an unreadable container.
    ''' </summary>
    <Fact>
    Public Sub Both_root_branches_match_the_published_vectors()
        Dim salt As Byte() = HexOf(Container("empty"), "random_inputs", "salt")

        Dim slow As Byte() = FdSecKdf.DeriveRoot(FdSecKdf.NormalizeCredential(SlowCredential), salt, Nothing)
        Assert.Equal(Vectors.GetProperty("root_slow_branch").GetString(), ToHex(slow))
        Assert.True(FdSecKdf.NormalizeCredential(SlowCredential).Length < FdSecProfile.V1.Threshold,
                    "the slow-branch vector credential must be below the threshold")

        Dim fastBytes As Byte() = FdSecKdf.NormalizeCredential(FastCredential)
        Assert.True(fastBytes.Length >= FdSecProfile.V1.Threshold,
                    "the fast-branch vector credential must be at or above the threshold")
        Dim fast As Byte() = FdSecKdf.DeriveRoot(fastBytes, salt, Nothing)
        Assert.Equal(Vectors.GetProperty("root_fast_branch").GetString(), ToHex(fast))
    End Sub

    ''' <summary>
    ''' An EMPTY credential takes the slow branch - the threshold is at least 1, so it
    ''' always does - and produces a container that is obfuscation with no secrecy. It is
    ''' accepted here rather than refused, because refusing it would make this reader
    ''' unable to open files the format says are valid; saying so at the point of entry is
    ''' the dialog's job, not this function's.
    ''' </summary>
    <Fact>
    Public Sub Empty_credential_takes_the_slow_branch_and_opens_its_container()
        Dim salt(FdSecFormat.SaltSize - 1) As Byte
        Dim viaEmpty As Byte() = FdSecKdf.DeriveRoot(FdSecKdf.NormalizeCredential(""), salt, FdSecTestContainer.FastProfile)
        Dim viaBlake As Byte() = FdSecPrimitives.Blake2b(512, salt, Array.Empty(Of Byte)())
        ' If the empty credential had taken the FAST branch, the root would be the first
        ' 32 bytes of this BLAKE2b-512. It must not be.
        Assert.NotEqual(ToHex(viaBlake.Take(32).ToArray()), ToHex(viaEmpty))

        Dim packed As Byte() = FdSecTestContainer.Pack(Encoding.UTF8.GetBytes("open"), "a.bin", "", FdSecTestContainer.FastProfile)
        Using container As FdSecContainer = OpenPacked(packed, "")
            Assert.Equal("a.bin", container.Metadata.Name)
        End Using
    End Sub

    ''' <summary>
    ''' 1.1's third root vector (FDSEC-FORMAT §16 item 1): the EMPTY credential under the
    ''' version-1 profile, against the published root. The test above only proves which
    ''' branch it takes; this proves the bytes, so a reader that special-cased the empty
    ''' string - an empty Argon2 password is where libraries disagree - fails here.
    ''' </summary>
    <Fact>
    Public Sub Empty_credential_root_matches_the_published_vector()
        Dim salt As Byte() = HexOf(Container("empty"), "random_inputs", "salt")
        Dim root As Byte() = FdSecKdf.DeriveRoot(FdSecKdf.NormalizeCredential(""), salt, Nothing)
        Assert.Equal(Vectors.GetProperty("root_empty_credential").GetString(), ToHex(root))
    End Sub

    ' --------------------------------------------------------- sub-keys and mask ----

    ''' <summary>
    ''' The two sub-keys, for both reference containers. This is where porting mistake 2
    ''' shows up: keyed BLAKE2b is the primitive's OWN key input, not HMAC-BLAKE2b, and the
    ''' .NET type that does exactly the wrong thing is called HMACBlake2B. Either way you
    ''' get 32 stable bytes; only the vector says which 32.
    ''' </summary>
    <Theory>
    <InlineData("empty")>
    <InlineData("onebyte")>
    <InlineData("multi")>
    Public Sub Sub_keys_match_the_published_vectors(name As String)
        Dim vector As JsonElement = Container(name)
        Dim salt As Byte() = HexOf(vector, "random_inputs", "salt")

        Dim maskKey As Byte() = Nothing
        Dim kek As Byte() = Nothing
        FdSecKdf.DeriveKeys(FdSecKdf.NormalizeCredential(SlowCredential), salt, Nothing, maskKey, kek)

        Assert.Equal(ToHex(HexOf(vector, "layout", "mask_key")), ToHex(maskKey))
        Assert.Equal(ToHex(HexOf(vector, "layout", "kek")), ToHex(kek))
    End Sub

    ''' <summary>
    ''' The mask, verified in BOTH directions: on-disk unmasks to the published plaintext
    ''' head, and that plaintext re-masks to the published on-disk bytes.
    '''
    ''' This is the test that catches porting mistake 3. The head mask is RFC 8439 ChaCha20
    ''' with a twelve-byte zero nonce and the block counter starting at ZERO; some APIs
    ''' start it at 1 because that is what the AEAD construction needs, and the result is a
    ''' head that unmasks to noise under the right credential - which this format reports
    ''' as "wrong password, or not a container, or tampering", the least debuggable message
    ''' it has.
    ''' </summary>
    <Theory>
    <InlineData("empty")>
    <InlineData("onebyte")>
    <InlineData("multi")>
    Public Sub Mask_is_verified_in_both_directions(name As String)
        Dim vector As JsonElement = Container(name)
        Dim maskKey As Byte() = HexOf(vector, "layout", "mask_key")

        Dim onDisk As Byte() = FdSecHead.Concat(HexOf(vector, "layout", "header_on_disk"),
                                                HexOf(vector, "layout", "slots_on_disk"))
        Dim plain As Byte() = FdSecHead.Concat(HexOf(vector, "layout", "header_unmasked"),
                                               HexOf(vector, "layout", "slots_unmasked"))
        Assert.Equal(FdSecFormat.HeadSize, onDisk.Length)
        Assert.Equal(FdSecFormat.HeadSize, plain.Length)

        Dim unmasked As Byte() = CType(onDisk.Clone(), Byte())
        FdSecPrimitives.ChaCha20Xor(maskKey, New Byte(11) {}, unmasked, FdSecFormat.MaskOffset, FdSecFormat.MaskLength)
        Assert.Equal(ToHex(plain), ToHex(unmasked))

        Dim remasked As Byte() = CType(plain.Clone(), Byte())
        FdSecPrimitives.ChaCha20Xor(maskKey, New Byte(11) {}, remasked, FdSecFormat.MaskOffset, FdSecFormat.MaskLength)
        Assert.Equal(ToHex(onDisk), ToHex(remasked))
    End Sub

    ''' <summary>
    ''' The unmasked head says exactly what the format says it should, and the type-1 key
    ''' slot ends in SEVEN reserved zero bytes - 1 + 24 + 48 = 73 of an 80-byte record.
    ''' FDSEC-FORMAT §5 said six until the erratum of 2026-09-22; the vectors agree with
    ''' the arithmetic, and a reader that validated six would accept a container with a
    ''' nonzero byte where none may be.
    ''' </summary>
    <Fact>
    Public Sub Unmasked_head_has_the_published_shape()
        Dim vector As JsonElement = Container("onebyte")
        Dim header As Byte() = HexOf(vector, "layout", "header_unmasked")
        Assert.Equal(FdSecFormat.HeaderSize, header.Length)
        Assert.Equal(FdSecFormat.FormatVersion, header(16))
        Assert.Equal(FdSecFormat.SuiteId, header(17))
        Assert.Equal(FdSecFormat.ConformanceFlags, FdSecPrimitives.ReadUInt16Le(header, 18))
        Assert.Equal(1048576UI, FdSecPrimitives.ReadUInt32Le(header, 20))
        Assert.Equal(4096UI, FdSecPrimitives.ReadUInt32Le(header, 24))

        Dim slots As Byte() = HexOf(vector, "layout", "slots_unmasked")
        Assert.Equal(FdSecFormat.SlotsSize, slots.Length)
        Assert.Equal(FdSecFormat.SlotTypeCredentialWrap, slots(0))
        For i As Integer = 1 + FdSecFormat.NonceSize + FdSecFormat.WrappedSize To FdSecFormat.SlotSize - 1
            Assert.Equal(CByte(0), slots(i))
        Next
        For i As Integer = FdSecFormat.SlotSize To FdSecFormat.SlotsSize - 1
            Assert.Equal(CByte(0), slots(i))
        Next
    End Sub

    ' ------------------------------------------- the two reference containers ----

    ''' <summary>
    ''' Both reference containers open, and their metadata and payload match the published
    ''' values byte for byte. This one assertion exercises the whole chain - derivation,
    ''' mask, header digest, slot-0 unwrap, metadata nonce and AD, chunk nonce and AD,
    ''' length arithmetic - against bytes produced by a different implementation in a
    ''' different language.
    ''' </summary>
    <Theory>
    <InlineData("empty")>
    <InlineData("onebyte")>
    <InlineData("multi")>
    Public Sub Reference_container_opens_with_the_published_metadata_and_payload(name As String)
        Dim vector As JsonElement = Container(name)
        Using container As FdSecContainer = OpenPacked(ReferenceBytes(name), SlowCredential)
            Assert.Equal(vector.GetProperty("name").GetString(), container.Metadata.Name)
            Assert.Equal(vector.GetProperty("size").GetInt64(), container.Metadata.Size)

            Assert.Equal(Utc(vector, "encoded_at"), container.Metadata.EncodedAt.Value)
            Assert.Equal(Utc(vector, "created_at"), container.Metadata.CreatedAt.Value)
            Assert.Equal(Utc(vector, "accessed_at"), container.Metadata.AccessedAt.Value)
            Assert.Equal(Utc(vector, "modified_at"), container.Metadata.ModifiedAt.Value)

            Dim expected As Byte() = HexOf(vector, "content")
            Using content As Stream = container.OpenContentStream()
                Using recovered As New MemoryStream()
                    content.CopyTo(recovered)
                    Assert.Equal(ToHex(expected), ToHex(recovered.ToArray()))
                End Using
            End Using

            ' The full guarantee the streaming reader gives up: every chunk read in order
            ' and the recovered bytes checked against the digest sealed at pack time.
            container.VerifyAll()
        End Using
    End Sub

    ''' <summary>
    ''' The published chunk-0 vector of the one-byte container: its derived nonce, its
    ''' associated data and its ciphertext. This is what pins porting mistake 6 -
    ''' little-endian everywhere, including the u64 inside the nonce CONTEXT string and
    ''' inside the associated data, where a big-endian slip is invisible at index 0 in
    ''' every field except the length.
    ''' </summary>
    <Fact>
    Public Sub Chunk_nonce_and_associated_data_match_the_published_vector()
        Dim vector As JsonElement = Container("onebyte")
        Dim fileKey As Byte() = HexOf(vector, "random_inputs", "file_key")
        Dim headerDigest As Byte() = FdSecPrimitives.Blake2b(256, HexOf(vector, "layout", "header_unmasked"))

        Assert.Equal(ToHex(HexOf(vector, "chunk0", "nonce")), ToHex(FdSecHead.ChunkNonce(fileKey, 0)))
        Assert.Equal(ToHex(HexOf(vector, "chunk0", "associated_data")),
                     ToHex(FdSecHead.ChunkAssociatedData(headerDigest, 0, 1, True, 1)))
        Assert.Equal(ToHex(HexOf(vector, "chunk0", "ciphertext")), ToHex(HexOf(vector, "layout", "payload")))
    End Sub

    ''' <summary>
    ''' 1.1's multi-chunk vector (FDSEC-FORMAT §16 item 5): the assembled container is the
    ''' one the catalog published - its length, payload offset and file digest - and each
    ''' of its three chunks carries the published nonce, associated data and ciphertext.
    ''' The one-byte container only ever pins index 0 and the last-chunk flag together;
    ''' this is where a slip in a non-zero index or a full, non-final chunk would show.
    ''' </summary>
    <Fact>
    Public Sub Multi_chunk_vector_matches_chunk_by_chunk()
        Dim vector As JsonElement = Container("multi")
        Dim layout As JsonElement = vector.GetProperty("layout")
        Dim packed As Byte() = ReferenceBytes("multi")

        Assert.Equal(layout.GetProperty("total_len").GetInt64(), CLng(packed.Length))
        Assert.Equal(ToHex(HexOf(layout, "blake2b256_of_file")), ToHex(FdSecPrimitives.Blake2b(256, packed)))

        Dim fileKey As Byte() = HexOf(vector, "random_inputs", "file_key")
        Dim headerDigest As Byte() = FdSecPrimitives.Blake2b(256, HexOf(layout, "header_unmasked"))
        Dim payloadOffset As Integer = layout.GetProperty("payload_offset").GetInt32()
        Dim chunks As JsonElement() = vector.GetProperty("chunks").EnumerateArray().ToArray()
        Assert.Equal(3, chunks.Length)

        Using container As FdSecContainer = OpenPacked(packed, SlowCredential)
            Assert.Equal(CLng(chunks.Length), container.ChunkCount)
            Dim capacity As Long = container.ChunkCapacity
            Dim cursor As Integer = payloadOffset
            For index As Integer = 0 To chunks.Length - 1
                Dim isLast As Boolean = (index = chunks.Length - 1)
                Dim plainLength As Long = If(isLast, container.ContentLength - index * capacity, capacity)
                Assert.Equal(ToHex(HexOf(chunks(index), "nonce")), ToHex(FdSecHead.ChunkNonce(fileKey, index)))
                Assert.Equal(ToHex(HexOf(chunks(index), "associated_data")),
                             ToHex(FdSecHead.ChunkAssociatedData(headerDigest, index, chunks.Length, isLast, plainLength)))

                Dim ciphertext As Byte() = HexOf(chunks(index), "ciphertext")
                Assert.Equal(CInt(plainLength) + FdSecFormat.TagSize, ciphertext.Length)
                Assert.Equal(ToHex(ciphertext), ToHex(packed.Skip(cursor).Take(ciphertext.Length).ToArray()))
                cursor += ciphertext.Length
            Next
        End Using
    End Sub

    ''' <summary>An empty original is exactly one chunk, of length zero - not zero chunks,
    ''' which is the arithmetic every implementation gets wrong first.</summary>
    <Fact>
    Public Sub Empty_original_is_one_zero_length_chunk()
        Using container As FdSecContainer = OpenPacked(ContainerBytes("empty"), SlowCredential)
            Assert.Equal(1L, container.ChunkCount)
            Assert.Equal(0L, container.ContentLength)
            Assert.Empty(container.ReadChunk(0))
        End Using
    End Sub

    ' ------------------------------------------------------- multi-chunk round trip ----

    ''' <summary>
    ''' A multi-chunk original round-trips. Run under the lowered test profile with a small
    ''' alignment and chunk size, which is the seam FDSEC-BEHAVIOUR §13.3 allows precisely
    ''' so a suite like this one stays fast - and which no shipped path may touch, because
    ''' a container written under a lowered profile is readable only under it.
    ''' </summary>
    <Fact>
    Public Sub Multi_chunk_original_round_trips()
        Dim content As Byte() = PatternBytes(5000)
        Dim packed As Byte() = FdSecTestContainer.Pack(content, "big.bin", SlowCredential, FdSecTestContainer.FastProfile)

        Using container As FdSecContainer = OpenPacked(packed, SlowCredential)
            Assert.True(container.ChunkCount > 1, "the test container must actually span several chunks")
            Assert.Equal(content.Length, CInt(container.ContentLength))
            Using content_ As Stream = container.OpenContentStream()
                Using recovered As New MemoryStream()
                    content_.CopyTo(recovered)
                    Assert.Equal(ToHex(content), ToHex(recovered.ToArray()))
                End Using
            End Using
            container.VerifyAll()
        End Using
    End Sub

    ' ------------------------------------------------------------ tamper detection ----

    ''' <summary>
    ''' One flipped bit in the head is the first outcome class - and NOT "damaged": a head
    ''' byte is either the salt, which changes every derived key, or a masked byte bound
    ''' into the header digest, and either way nothing downstream authenticates. With no
    ''' marker and no stored verifier, damage inside the head is indistinguishable from a
    ''' wrong credential, and a message that picked one would be lying half the time.
    '''
    ''' The offsets are the salt, the version byte, the last header byte and the middle of
    ''' the wrapped key. A byte inside an EMPTY key slot is deliberately not among them:
    ''' those bytes are checked after the container has authenticated, so they are damage,
    ''' which the row below covers.
    ''' </summary>
    <Theory>
    <InlineData(0)>
    <InlineData(16)>
    <InlineData(27)>
    <InlineData(100)>
    Public Sub One_flipped_bit_in_the_head_is_credential_or_tamper(offset As Integer)
        Dim packed As Byte() = FdSecTestContainer.Pack(PatternBytes(64), "a.bin", SlowCredential, FdSecTestContainer.FastProfile)
        packed(offset) = packed(offset) Xor CByte(1)
        Assert.Equal(FdSecOutcome.CredentialOrTamper, OutcomeOf(packed, SlowCredential))
    End Sub

    ''' <summary>
    ''' A nonzero byte in a key slot that must be empty is DAMAGE, because by the time it
    ''' can be seen the container has already authenticated - the credential is proven
    ''' right and cannot be blamed. This is the other half of the row above, and keeping
    ''' the two apart is the whole discipline of the outcome classes.
    ''' </summary>
    <Fact>
    Public Sub A_nonzero_byte_in_an_empty_key_slot_is_damaged()
        Dim packed As Byte() = RepackHead(Sub(plain) plain(FdSecFormat.HeaderSize + FdSecFormat.SlotSize + 5) = 7)
        Assert.Equal(FdSecOutcome.Damaged, OutcomeOf(packed, SlowCredential))
    End Sub

    ''' <summary>A flipped bit in the sealed metadata is tampering. The credential is
    ''' already proven right by key slot 0 at this point, so this must never be reported as
    ''' a password problem.</summary>
    <Fact>
    Public Sub One_flipped_bit_in_the_metadata_is_tamper()
        Dim packed As Byte() = FdSecTestContainer.Pack(PatternBytes(64), "a.bin", SlowCredential, FdSecTestContainer.FastProfile)
        Dim offset As Integer = FdSecFormat.HeadSize + 10
        packed(offset) = packed(offset) Xor CByte(1)
        Assert.Equal(FdSecOutcome.CredentialOrTamper, OutcomeOf(packed, SlowCredential))
    End Sub

    ''' <summary>A flipped bit inside a chunk is tampering, localised to that chunk - the
    ''' container still OPENS, and the failure arrives when that chunk is read.</summary>
    <Fact>
    Public Sub One_flipped_bit_in_a_chunk_is_tamper_localised_to_that_chunk()
        Dim packed As Byte() = FdSecTestContainer.Pack(PatternBytes(5000), "a.bin", SlowCredential, FdSecTestContainer.FastProfile)
        Dim offset As Integer = FdSecTestContainer.ChunkOffset(1, 512, 1024) + 4
        packed(offset) = packed(offset) Xor CByte(1)

        Using container As FdSecContainer = OpenPacked(packed, SlowCredential)
            Assert.NotEmpty(container.ReadChunk(0))
            Dim failure As FdSecException = Assert.Throws(Of FdSecException)(Sub() container.ReadChunk(1))
            Assert.Equal(FdSecOutcome.CredentialOrTamper, failure.Outcome)
        End Using
    End Sub

    ''' <summary>Two chunks swapped is tampering: the chunk index is bound into the
    ''' associated data, so a chunk read at the wrong offset fails its own tag.</summary>
    <Fact>
    Public Sub Two_swapped_chunks_are_tamper()
        Dim packed As Byte() = FdSecTestContainer.Pack(PatternBytes(5000), "a.bin", SlowCredential, FdSecTestContainer.FastProfile)
        Dim first As Integer = FdSecTestContainer.ChunkOffset(0, 512, 1024)
        Dim second As Integer = FdSecTestContainer.ChunkOffset(1, 512, 1024)
        Dim scratch(1023) As Byte
        Array.Copy(packed, first, scratch, 0, 1024)
        Array.Copy(packed, second, packed, first, 1024)
        Array.Copy(scratch, 0, packed, second, 1024)

        Using container As FdSecContainer = OpenPacked(packed, SlowCredential)
            Dim failure As FdSecException = Assert.Throws(Of FdSecException)(Sub() container.VerifyAll())
            Assert.Equal(FdSecOutcome.CredentialOrTamper, failure.Outcome)
        End Using
    End Sub

    ''' <summary>A chunk spliced in from ANOTHER container made with the same credential is
    ''' tampering - that is what binding the header digest into the associated data buys,
    ''' and it is the case a per-chunk MAC without that binding would happily accept.</summary>
    <Fact>
    Public Sub A_chunk_spliced_from_another_container_is_tamper()
        Dim mine As Byte() = FdSecTestContainer.Pack(PatternBytes(5000), "a.bin", SlowCredential, FdSecTestContainer.FastProfile, seed:="one")
        Dim theirs As Byte() = FdSecTestContainer.Pack(PatternBytes(5000), "a.bin", SlowCredential, FdSecTestContainer.FastProfile, seed:="two")
        Dim offset As Integer = FdSecTestContainer.ChunkOffset(0, 512, 1024)
        Array.Copy(theirs, offset, mine, offset, 1024)

        Using container As FdSecContainer = OpenPacked(mine, SlowCredential)
            Dim failure As FdSecException = Assert.Throws(Of FdSecException)(Sub() container.ReadChunk(0))
            Assert.Equal(FdSecOutcome.CredentialOrTamper, failure.Outcome)
        End Using
    End Sub

    ''' <summary>The final chunk removed and the length fixed up to look plausible is
    ''' DAMAGED, not tampering: the arithmetic of the sealed size against the file's own
    ''' length catches it before a single tag is checked.</summary>
    <Fact>
    Public Sub A_removed_final_chunk_with_a_plausible_length_is_damaged()
        Dim packed As Byte() = FdSecTestContainer.Pack(PatternBytes(5000), "a.bin", SlowCredential, FdSecTestContainer.FastProfile)
        Dim shortened(packed.Length - 1024 - 1) As Byte
        Array.Copy(packed, shortened, shortened.Length)
        Assert.Equal(0, shortened.Length Mod 512)
        Assert.Equal(FdSecOutcome.Damaged, OutcomeOf(shortened, SlowCredential))
    End Sub

    ''' <summary>A truncation mid-chunk is damaged as well - and the file is still a whole
    ''' number of clusters, so the length screen alone would never have seen it.</summary>
    <Fact>
    Public Sub A_truncation_mid_chunk_is_damaged()
        Dim packed As Byte() = FdSecTestContainer.Pack(PatternBytes(5000), "a.bin", SlowCredential, FdSecTestContainer.FastProfile)
        Dim shortened(packed.Length - 512 - 1) As Byte
        Array.Copy(packed, shortened, shortened.Length)
        Assert.Equal(FdSecOutcome.Damaged, OutcomeOf(shortened, SlowCredential))
    End Sub

    ''' <summary>A wrong credential is the first class and NEVER "damaged". This is
    ''' invariant 9 of FDSEC-BEHAVIOUR §6 in one assertion.</summary>
    <Fact>
    Public Sub A_wrong_credential_is_never_damaged()
        Dim packed As Byte() = FdSecTestContainer.Pack(PatternBytes(64), "a.bin", SlowCredential, FdSecTestContainer.FastProfile)
        Assert.Equal(FdSecOutcome.CredentialOrTamper, OutcomeOf(packed, "not the password"))
    End Sub

    ''' <summary>A random file of plausible length never crashes and never produces a
    ''' confident "not a container" - the reader has no way to know that, and saying so
    ''' would be the one claim this format cannot support.</summary>
    <Fact>
    Public Sub A_random_file_of_plausible_length_is_credential_or_tamper()
        Dim noise As Byte() = PatternBytes(12288)
        Assert.True(FdSecScreen.CouldBeContainer(noise.Length))
        Assert.Equal(FdSecOutcome.CredentialOrTamper, OutcomeOf(noise, SlowCredential))
    End Sub

    ''' <summary>
    ''' The length screen: 5631 bytes, and a length that is not a whole number of 512-byte
    ''' clusters, are both damaged - and are refused WITHOUT asking for a credential. That
    ''' is the whole of what a reader may conclude about a file it has no password for.
    ''' </summary>
    <Theory>
    <InlineData(0)>
    <InlineData(5631)>
    <InlineData(12289)>
    Public Sub Impossible_lengths_are_refused_before_any_credential(length As Long)
        Assert.False(FdSecScreen.CouldBeContainer(length))
    End Sub

    <Theory>
    <InlineData(5632)>
    <InlineData(12288)>
    Public Sub Possible_lengths_pass_the_screen_and_still_say_nothing(length As Long)
        Assert.True(FdSecScreen.CouldBeContainer(length))
    End Sub

    ' ------------------------------------------- the remaining porting mistakes ----

    ''' <summary>
    ''' Mistake 4: XChaCha20-Poly1305, not the IETF ChaCha20-Poly1305 - the nonce is 24
    ''' bytes, and the sub-key derivation that gets us there is the one construction we
    ''' wrote ourselves. It is proven end to end by the reference containers above; this
    ''' pins it directly so a failure names the right forty lines.
    ''' </summary>
    <Fact>
    Public Sub Xchacha_seal_and_open_round_trip_under_a_24_byte_nonce()
        Dim key As Byte() = FdSecPrimitives.Blake2b(256, Encoding.UTF8.GetBytes("key"))
        Dim nonce As Byte() = Enumerable.Range(0, 24).Select(Function(i) CByte(i)).ToArray()
        Dim ad As Byte() = Encoding.UTF8.GetBytes("associated")
        Dim plain As Byte() = Encoding.UTF8.GetBytes("the quick brown fox")

        Dim sealed_ As Byte() = FdSecPrimitives.XChaChaSeal(key, nonce, ad, plain)
        Assert.Equal(plain.Length + FdSecFormat.TagSize, sealed_.Length)
        Assert.Equal(ToHex(plain), ToHex(FdSecPrimitives.XChaChaOpen(key, nonce, ad, sealed_)))

        ' A different nonce, a different AD and a flipped byte each fail, and failing is
        ' Nothing rather than an exception - the caller decides which outcome that is.
        Dim otherNonce As Byte() = CType(nonce.Clone(), Byte())
        otherNonce(0) = 99
        Assert.Null(FdSecPrimitives.XChaChaOpen(key, otherNonce, ad, sealed_))
        Assert.Null(FdSecPrimitives.XChaChaOpen(key, nonce, Encoding.UTF8.GetBytes("other"), sealed_))
        sealed_(0) = sealed_(0) Xor CByte(1)
        Assert.Null(FdSecPrimitives.XChaChaOpen(key, nonce, ad, sealed_))
    End Sub

    ''' <summary>
    ''' Mistake 5: NFC, and NO trimming. The same credential written in decomposed form
    ''' opens the container; the same credential with a trailing space does not, because a
    ''' leading or trailing space IS part of the credential. A credential that round-trips
    ''' on one machine and fails on another is almost always this.
    ''' </summary>
    <Fact>
    Public Sub Credentials_are_normalized_to_nfc_and_never_trimmed()
        Dim composed As String = "pa" & ChrW(&HE9) & "sse"              ' one precomposed e-acute, NFC
        Dim decomposed As String = "pa" & "e" & ChrW(&H301) & "sse"     ' the same text, NFD

        Dim packed As Byte() = FdSecTestContainer.Pack(PatternBytes(32), "a.bin", composed, FdSecTestContainer.FastProfile)
        Using container As FdSecContainer = OpenPacked(packed, decomposed)
            Assert.Equal("a.bin", container.Metadata.Name)
        End Using

        Assert.Equal(FdSecOutcome.CredentialOrTamper, OutcomeOf(packed, composed & " "))
        Assert.Equal(FdSecOutcome.CredentialOrTamper, OutcomeOf(packed, " " & composed))
    End Sub

    ''' <summary>
    ''' Mistake 7: FILETIME, not Unix seconds, and ZERO MEANS UNKNOWN. A reader that treats
    ''' 0 as a date writes 1601 onto restored files and shows it on screen; here it stays
    ''' Nothing and the surface simply does not show a date it does not have.
    ''' </summary>
    <Fact>
    Public Sub Filetime_zero_means_unknown_and_never_1601()
        Assert.Null(FdSecMetadata.FromFileTime(0UL))
        Dim known As Date = New Date(2026, 8, 19, 23, 59, 59, DateTimeKind.Utc)
        Assert.Equal(known, FdSecMetadata.FromFileTime(CULng(known.ToFileTimeUtc())).Value)

        ' And the reference container's own timestamps are the published ones, which no
        ' Unix-epoch reading could produce.
        Using container As FdSecContainer = OpenPacked(ContainerBytes("onebyte"), SlowCredential)
            Assert.Equal(2025, container.Metadata.CreatedAt.Value.Year)
            Assert.Equal(2026, container.Metadata.ModifiedAt.Value.Year)
        End Using
    End Sub

    ''' <summary>
    ''' An unknown version, suite, flag bit or key-slot type in a container that DID
    ''' authenticate is UNSUPPORTED, refused by name - never called damage, and never
    ''' called a wrong password. That refusal is what lets a reserved field be brought into
    ''' use later without a format version bump.
    ''' </summary>
    <Theory>
    <InlineData(16, CByte(2))>    ' format version
    <InlineData(17, CByte(2))>    ' suite id
    <InlineData(18, CByte(3))>    ' a reserved flag bit set
    <InlineData(28, CByte(2))>    ' key-slot type 2, the reserved recovery slot
    Public Sub An_unknown_field_in_an_authenticating_container_is_unsupported(offset As Integer, value As Byte)
        Dim packed As Byte() = RepackWithHeadByte(offset, value)
        Assert.Equal(FdSecOutcome.Unsupported, OutcomeOf(packed, SlowCredential))
    End Sub

    ''' <summary>A structural rule broken after the credential proved right is DAMAGE, and
    ''' the difference from the row above is the whole point of keeping the two classes
    ''' apart: one says "this was made by something newer", the other says "these bytes are
    ''' wrong".</summary>
    <Fact>
    Public Sub A_broken_structural_rule_after_authentication_is_damaged()
        ' A cluster alignment of 3 is not a power of two, so it is structurally impossible
        ' rather than a field from the future.
        Dim packed As Byte() = RepackWithHeadWord(24, 3UI)
        Assert.Equal(FdSecOutcome.Damaged, OutcomeOf(packed, SlowCredential))
    End Sub

    ' ------------------------------------------------------------------ helpers ----

    ''' <summary>Rebuilds a container with one byte of the PLAINTEXT head changed, then
    ''' re-masks it, so key slot 0 still authenticates and the reader reaches the
    ''' validation it is being asked about.</summary>
    Private Shared Function RepackWithHeadByte(offset As Integer, value As Byte) As Byte()
        Return RepackHead(Sub(plain) plain(offset) = value)
    End Function

    Private Shared Function RepackWithHeadWord(offset As Integer, value As UInteger) As Byte()
        Return RepackHead(Sub(plain) FdSecPrimitives.WriteUInt32Le(plain, offset, value))
    End Function

    Private Shared Function RepackHead(edit As Action(Of Byte())) As Byte()
        ' A plain byte edit never reaches the validation being asked about: the head is
        ' masked, and the header digest is the associated data of key slot 0, so changing
        ' a header field stops the slot authenticating and the answer comes back as the
        ' merged first class instead. So the head is unmasked, edited, re-wrapped and
        ' re-masked - which is exactly what another writer would have produced.
        Dim packed As Byte() = FdSecTestContainer.Pack(PatternBytes(64), "a.bin", SlowCredential, FdSecTestContainer.FastProfile)

        Dim salt(FdSecFormat.SaltSize - 1) As Byte
        Array.Copy(packed, salt, FdSecFormat.SaltSize)
        Dim maskKey As Byte() = Nothing
        Dim kek As Byte() = Nothing
        FdSecKdf.DeriveKeys(FdSecKdf.NormalizeCredential(SlowCredential), salt, FdSecTestContainer.FastProfile, maskKey, kek)

        Dim head(FdSecFormat.HeadSize - 1) As Byte
        Array.Copy(packed, head, FdSecFormat.HeadSize)
        FdSecPrimitives.ChaCha20Xor(maskKey, New Byte(11) {}, head, FdSecFormat.MaskOffset, FdSecFormat.MaskLength)

        edit(head)

        Dim headerBytes(FdSecFormat.HeaderSize - 1) As Byte
        Array.Copy(head, headerBytes, FdSecFormat.HeaderSize)
        Dim digest As Byte() = FdSecPrimitives.Blake2b(256, headerBytes)

        Dim wrapNonce(FdSecFormat.NonceSize - 1) As Byte
        Array.Copy(head, FdSecFormat.HeaderSize + 1, wrapNonce, 0, FdSecFormat.NonceSize)
        ' Any file key will do: such a container is only ever asked for its outcome class,
        ' and the refusal fires before the metadata is ever opened.
        Dim fileKey As Byte() = FdSecPrimitives.Blake2b(256, Encoding.UTF8.GetBytes("repack"))
        Dim wrapped As Byte() = FdSecPrimitives.XChaChaSeal(kek, wrapNonce, FdSecHead.Slot0AssociatedData(digest), fileKey)
        Array.Copy(wrapped, 0, head, FdSecFormat.HeaderSize + 1 + FdSecFormat.NonceSize, wrapped.Length)

        FdSecPrimitives.ChaCha20Xor(maskKey, New Byte(11) {}, head, FdSecFormat.MaskOffset, FdSecFormat.MaskLength)
        Array.Copy(head, packed, FdSecFormat.HeadSize)
        Return packed
    End Function

    ''' <summary>A published timestamp, read as the UTC instant it names regardless of the
    ''' machine's own time zone.</summary>
    Private Shared Function Utc(vector As JsonElement, field As String) As Date
        Return Date.Parse(vector.GetProperty(field).GetString(), CultureInfo.InvariantCulture,
                          DateTimeStyles.AdjustToUniversal Or DateTimeStyles.AssumeUniversal)
    End Function

    Private Shared Function PatternBytes(count As Integer) As Byte()
        Dim bytes(count - 1) As Byte
        For i As Integer = 0 To count - 1
            bytes(i) = CByte((i * 31 + 7) And &HFF)
        Next
        Return bytes
    End Function

    Private Shared Function OpenPacked(packed As Byte(), credential As String) As FdSecContainer
        Return FdSecContainer.Open(New MemoryStream(packed, writable:=False), credential,
                                   ownsSource:=True, profile:=ProfileFor(packed))
    End Function

    ''' <summary>The reference containers were packed under the version-1 profile; anything
    ''' this suite builds itself uses the lowered test profile. The two are told apart by
    ''' length and salt: a test-built container never reuses a reference salt.</summary>
    Private Shared Function ProfileFor(packed As Byte()) As FdSecProfile
        Return If(IsReference(packed), Nothing, FdSecTestContainer.FastProfile)
    End Function

    Private Shared Function IsReference(packed As Byte()) As Boolean
        For Each name As String In {"empty", "onebyte", "multi"}
            Dim reference As Byte() = ReferenceBytes(name)
            If reference.Length <> packed.Length Then Continue For
            Dim same As Boolean = True
            For i As Integer = 0 To FdSecFormat.SaltSize - 1
                If reference(i) <> packed(i) Then
                    same = False
                    Exit For
                End If
            Next
            If same Then Return True
        Next
        Return False
    End Function

    Private Shared Function OutcomeOf(packed As Byte(), credential As String) As FdSecOutcome
        Try
            Using container As FdSecContainer = OpenPacked(packed, credential)
                container.VerifyAll()
                Return FdSecOutcome.Ok
            End Using
        Catch ex As FdSecException
            Return ex.Outcome
        End Try
    End Function

End Class
#End If
