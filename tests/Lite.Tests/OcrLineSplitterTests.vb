Option Strict On

Imports System.Drawing
Imports Xunit

' The stitched-line split and the column regrouping
' (SPECIFICATION_OCR_OVERLAY_ACCURACY.md, stage S7). Both legs: an overlay plate drawn
' across the artwork is a DEFECT, and the translator receiving two texts as one sentence
' carries it into every language, so the fix ships in both viewers.
'
' EVERY fixture below is real recognizer output. It was produced by running Tesseract 5.2.0
' (LSTM, PSM 3 - the engine and mode the app itself uses) over scenes generated by this
' repository's own harness, and the word boxes, texts and confidences are copied from that
' dump unchanged. That matters more here than anywhere else in the suite: the whole rule is
' a ratio between two measured quantities, and hand-drawn boxes would let it pass against
' geometry no engine produces. The scenes and the numbers are in section 18.2 of the
' specification.
Public Class OcrLineSplitterTests

    ' --- fixtures --------------------------------------------------------------

    Private Shared Function W(text As String, x As Integer, y As Integer, width As Integer, height As Integer,
                              conf As Single) As OcrWord
        Return New OcrWord With {.Text = text, .Box = New Rectangle(x, y, width, height), .Confidence = conf}
    End Function

    ''' <summary>A line built the way the engine hands one over: the box is the union of the
    ''' words, the text is what GetText(TextLine) returned.</summary>
    Private Shared Function MakeLine(text As String, box As Rectangle, conf As Single,
                                 ParamArray words As OcrWord()) As OcrLine
        Return New OcrLine With {
            .Text = text, .Box = box, .Confidence = conf,
            .Words = New List(Of OcrWord)(words)
        }
    End Function

    ''' <summary>
    ''' two-g-one-line-each-side.png, 2048x1400: one balloon either side of a figure, one line
    ''' of speech each. Tesseract returned BOTH as a single 1574x189 text line - the reported
    ''' defect, reproduced on this repository's own engine.
    '''
    ''' Note the fourth word. The figure between the balloons came back as "©" with a 189 px
    ''' box while the real words are 40-42 px: that one artefact IS the line box's height, and
    ''' it is why the rule weighs the gap against the median WORD height (section 16.2).
    ''' </summary>
    Private Shared Function StitchedBalloons() As OcrLine
        Return MakeLine("WHO GOES THERE © ONLY THE WIND", New Rectangle(210, 561, 1574, 189), 0.891F,
            W("WHO", 210, 611, 136, 42, 0.9549F),
            W("GOES", 368, 611, 156, 42, 0.9579F),
            W("THERE", 544, 612, 186, 40, 0.9632F),
            W("©", 930, 561, 190, 189, 0.485F),
            W("ONLY", 1342, 611, 149, 42, 0.9592F),
            W("THE", 1508, 612, 109, 40, 0.9539F),
            W("WIND", 1636, 612, 148, 40, 0.9627F))
    End Function

    ''' <summary>
    ''' one-h-chapter-rule.png, 1200x600: "PART ONE     THE ARRIVAL" - one line to a reader,
    ''' set with a wide internal space. Its 74 px gap over a 36 px median word height is 2.06x,
    ''' the widest genuine gap in the corpus and the lower end of the bracket.
    ''' </summary>
    Private Shared Function WidestGenuineLine() As OcrLine
        Return MakeLine("PART ONE THE ARRIVAL", New Rectangle(162, 290, 656, 38), 0.703F,
            W("PART", 162, 291, 130, 36, 0.9418F),
            W("ONE", 310, 290, 104, 38, 0.0564F),
            W("THE", 488, 291, 97, 36, 0.8554F),
            W("ARRIVAL", 601, 291, 217, 36, 0.9584F))
    End Function

    ''' <summary>
    ''' rtl-two-captions.png, 1600x600, recognized with `ara`: two Arabic captions standing
    ''' side by side, returned as ONE line. The words arrive in reading order, so their boxes
    ''' run RIGHT to left - the case a left-to-right gap would read as -814 px and never cut.
    ''' </summary>
    Private Shared Function StitchedArabic() As OcrLine
        Return MakeLine("الجسر مغلق الآن المحطة القديمة", New Rectangle(291, 292, 1217, 52), 0.922F,
            W("الجسر", 1401, 296, 107, 48, 0.922F),
            W("مغلق", 1283, 296, 100, 48, 0.9304F),
            W("الآن", 1198, 292, 64, 52, 0.9254F),
            W("المحطة", 448, 296, 140, 36, 0.9196F),
            W("القديمة", 291, 296, 136, 44, 0.9249F))
    End Function

    ''' <summary>
    ''' two-k-two-balloons-tight.png, 1600x1000: two balloons of two lines each, either side of
    ''' a figure. BOTH rows came back stitched, which is what makes this the interleaving case -
    ''' cutting alone turns 2 bars into 4 runs that read left, right, left, right.
    ''' </summary>
    Private Shared Function TightBalloonRows() As List(Of OcrLine)
        Return New List(Of OcrLine) From {
            MakeLine("| SAW IT NO YOU DID NOT", New Rectangle(191, 308, 1130, 32), 0.945F,
                W("|", 191, 308, 4, 32, 0.8987F),
                W("SAW", 213, 308, 97, 32, 0.9586F),
                W("IT", 329, 308, 34, 32, 0.9581F),
                W("NO", 960, 308, 61, 32, 0.9441F),
                W("YOU", 1035, 308, 90, 32, 0.9441F),
                W("DID", 1144, 308, 71, 32, 0.9556F),
                W("NOT", 1232, 308, 89, 32, 0.9556F)),
            MakeLine("MOVE AGAIN GO BACK TO BED", New Rectangle(190, 374, 1138, 32), 0.9541F,
                W("MOVE", 190, 374, 124, 32, 0.952F),
                W("AGAIN", 328, 374, 132, 32, 0.952F),
                W("GO", 959, 374, 64, 32, 0.9585F),
                W("BACK", 1040, 374, 116, 32, 0.9532F),
                W("TO", 1169, 374, 57, 32, 0.9544F),
                W("BED", 1243, 374, 85, 32, 0.9544F))
        }
    End Function

    ''' <summary>
    ''' two-h-caption-and-note.png, 1800x1200: a caption bottom left and a credit bottom right,
    ''' returned as one line - plus the empty full-page "line" the engine also hands back, box
    ''' 1800x1200, text "". It reaches no plate, but as a COLUMN it would overlap both real ones
    ''' and chain them into a single column.
    ''' </summary>
    Private Shared Function CaptionAndNotePage() As List(Of OcrLine)
        Return New List(Of OcrLine) From {
            MakeLine("Platform nine at dusk photograph by the author", New Rectangle(160, 987, 1464, 37), 0.9636F,
                W("Platform", 160, 987, 143, 29, 0.9599F),
                W("nine", 319, 987, 69, 29, 0.9631F),
                W("at", 401, 988, 32, 28, 0.9631F),
                W("dusk", 445, 987, 81, 29, 0.9655F),
                W("photograph", 1189, 987, 195, 37, 0.966F),
                W("by", 1398, 987, 40, 37, 0.9667F),
                W("the", 1448, 987, 53, 29, 0.9602F),
                W("author", 1514, 987, 110, 29, 0.9645F)),
            MakeLine("", New Rectangle(0, 0, 1800, 1200), 0.95F)
        }
    End Function

    ' --- the cut ---------------------------------------------------------------

    <Fact>
    Public Sub StitchedLine_IsCutIntoItsTexts()
        Dim runs As List(Of OcrLine) = OcrLineSplitter.SplitLine(StitchedBalloons())

        ' Three, not two: the figure read as "©" stands between the balloons with a wide gap on
        ' BOTH sides, so it is its own run - and the confidence floor then drops it, which is
        ' the outcome that leaves one plate per balloon and nothing over the artwork.
        Assert.Equal(3, runs.Count)
        Assert.Equal("WHO GOES THERE", runs(0).Text)
        Assert.Equal("©", runs(1).Text)
        Assert.Equal("ONLY THE WIND", runs(2).Text)

        ' Each run is boxed to ITS OWN words. Handing both halves the stitch's box back would
        ' leave the clustering exactly where it started.
        Assert.Equal(Rectangle.FromLTRB(210, 611, 730, 653), runs(0).Box)
        Assert.Equal(Rectangle.FromLTRB(1342, 611, 1784, 653), runs(2).Box)
        Assert.True(runs(0).Box.Right < runs(2).Box.Left,
                    "the two runs must not overlap - that is the whole point of the cut")

        ' ..and to its own mean confidence, not the stitched line's 0.891.
        Assert.Equal((0.9549F + 0.9579F + 0.9632F) / 3.0F, runs(0).Confidence, 4)
        Assert.Equal(0.485F, runs(1).Confidence, 4)
    End Sub

    <Fact>
    Public Sub OrdinaryLine_IsReturnedUnchangedByIdentity()
        ' The common path must not rebuild anything: every page would otherwise pay for a
        ' defect that appears on a few.
        Dim line As OcrLine = WidestGenuineLine()
        Dim runs As List(Of OcrLine) = OcrLineSplitter.SplitLine(line)

        Assert.Single(runs)
        Assert.Same(line, runs(0))
    End Sub

    <Fact>
    Public Sub TheBracket_HoldsAtBothEnds()
        ' The two ends the constant was measured between (section 18.2). Written as one test
        ' on purpose: the number only means something as a gap between these two, and a pair
        ' of separate tests would let one end move without the other being looked at.
        Dim genuine As OcrLine = WidestGenuineLine()
        Dim stitch As OcrLine = StitchedBalloons()

        Dim genuineRatio As Double = WidestRatio(genuine)
        Dim stitchRatio As Double = WidestRatio(stitch)

        Assert.Equal(2.06, genuineRatio, 2)   ' 74 px over a 36 px median word height
        Assert.Equal(5.29, stitchRatio, 2)    ' 222 px over 42 px
        Assert.True(genuineRatio < OcrLineSplitter.MaxWordGapRatio,
                    "the widest genuine gap in the corpus must stay below the threshold")
        Assert.True(stitchRatio > OcrLineSplitter.MaxWordGapRatio,
                    "the narrowest measured stitch must stay above it")

        Assert.Single(OcrLineSplitter.SplitLine(genuine))
        Assert.True(OcrLineSplitter.SplitLine(stitch).Count > 1)
    End Sub

    <Fact>
    Public Sub TheGapIsWeighedAgainstTheWordMedian_NotTheLineBox()
        ' The line box of the stitched balloons is 189 px tall, because the figure between them
        ' came back as one 189 px "word". Against the line box the threshold would be 661 px and
        ' the 222 px stitch would survive - the fix would fail on the very scene it was written
        ' for. Against the 42 px median of the words it is 147 px and the line is cut.
        Dim line As OcrLine = StitchedBalloons()

        Assert.Equal(189, line.Box.Height)
        Assert.Equal(42, OcrLineSplitter.MedianWordHeight(line))
        Assert.True(222 > 42 * OcrLineSplitter.MaxWordGapRatio, "cut against the word median")
        Assert.True(222 < 189 * OcrLineSplitter.MaxWordGapRatio, "kept against the line box")
        Assert.True(OcrLineSplitter.SplitLine(line).Count > 1)
    End Sub

    <Fact>
    Public Sub RightToLeftLine_IsCut()
        ' Arabic, recognized with `ara`: the words arrive in reading order, so their boxes run
        ' right to left. Measured left-to-right the gap that matters is -814 px and no line in
        ' any RTL script would ever be cut - silently, which is the bad kind of never.
        Dim line As OcrLine = StitchedArabic()
        Assert.True(line.Words(3).Box.Left < line.Words(2).Box.Left, "fixture really is RTL")
        Assert.Equal(-814, line.Words(3).Box.Left - line.Words(2).Box.Right)
        Assert.Equal(610, OcrLineSplitter.GapBetween(line.Words(2).Box, line.Words(3).Box))

        Dim runs As List(Of OcrLine) = OcrLineSplitter.SplitLine(line)
        Assert.Equal(2, runs.Count)
        Assert.Equal(3, runs(0).Words.Count)
        Assert.Equal(2, runs(1).Words.Count)
    End Sub

    <Fact>
    Public Sub OverlappingWordBoxes_NeverCut()
        ' Overlapping boxes give a NEGATIVE gap. Taking an absolute value anywhere in the
        ' measurement would turn a heavy overlap into a wide gap and cut a word off its line.
        Dim a As New Rectangle(100, 100, 200, 40)
        Dim b As New Rectangle(150, 100, 200, 40)
        Assert.True(OcrLineSplitter.GapBetween(a, b) < 0)

        Dim line As OcrLine = MakeLine("over lapping", Rectangle.FromLTRB(100, 100, 350, 140), 0.9F,
            W("over", 100, 100, 200, 40, 0.9F),
            W("lapping", 150, 100, 200, 40, 0.9F))
        Assert.Single(OcrLineSplitter.SplitLine(line))
    End Sub

    <Fact>
    Public Sub LineWithoutWordGeometry_IsNeverCut()
        ' An engine that returns no word boxes leaves the rule with nothing to weigh the gap
        ' against. It must then do nothing, never guess: a clustering that gets stricter
        ' because a value is missing is the failure mode section 16.2 warns about.
        Dim line As OcrLine = MakeLine("two words", New Rectangle(0, 0, 500, 40), 0.9F,
            W("two", 0, 0, 100, 0, 0.9F),
            W("words", 480, 0, 20, 0, 0.9F))
        Assert.Equal(0, OcrLineSplitter.MedianWordHeight(line))
        Assert.Single(OcrLineSplitter.SplitLine(line))
    End Sub

    ' --- the tall-word cut (OCR-PIPELINE 1.7 A) --------------------------------
    ' The reference's own split cases are replayed in OcrPipelineVectorTests; what follows are the
    ' edges the amendment's text leaves to a reader, each one decided the way its words read.

    ''' <summary>A row of equal-looking words, 20 px tall, packed with 8 px gaps - so the gap rule
    ''' (3.5 x 20 = 70 px) has nothing to say and any cut in these tests is the height rule's.</summary>
    Private Shared Function Row(ParamArray heights As Integer()) As OcrLine
        Dim words As New List(Of OcrWord)
        Dim x As Integer = 10
        For i As Integer = 0 To heights.Length - 1
            words.Add(W("w" & i.ToString(), x, 100, 40, heights(i), 0.9F))
            x += 48
        Next
        Dim box As Rectangle = words(0).Box
        For Each word As OcrWord In words
            box = Rectangle.Union(box, word.Box)
        Next
        Return New OcrLine With {
            .Words = words, .Box = box, .Confidence = 0.9F,
            .Text = String.Join(" ", words.Select(Function(w) w.Text))
        }
    End Function

    <Fact>
    Public Sub TallWord_CutsBeforeItself_AndLeadsTheNextRun()
        ' "GEE, TH-THANKS, J OON'T DEPEND": the touching outlines of two balloons read as a 36 px
        ' token on a 15 px line (2.4x). No gap holds the boundary - the stroke is INSIDE the token's
        ' box - so the cut is before the token, and the token starts the run after it.
        Dim line As OcrLine = MakeLine("GEE, TH-THANKS, J OON'T DEPEND", Rectangle.FromLTRB(49, 602, 430, 637), 0.7F,
            W("GEE,", 49, 610, 63, 16, 0.95F),
            W("TH-THANKS,", 106, 610, 124, 15, 0.79F),
            W("J", 249, 602, 27, 35, 0.02F),
            W("OON'T", 283, 610, 61, 15, 0.83F),
            W("DEPEND", 351, 610, 79, 15, 0.88F))
        Assert.True(WidestRatio(line) < OcrLineSplitter.MaxWordGapRatio, "the gap rule must have nothing to say here")

        Dim runs As List(Of OcrLine) = OcrLineSplitter.SplitLine(line)

        Assert.Equal(2, runs.Count)
        Assert.Equal("GEE, TH-THANKS,", runs(0).Text)
        Assert.Equal("J OON'T DEPEND", runs(1).Text)
        ' Each run is boxed to its own words: the tall token is in the second, not shared.
        Assert.Equal(Rectangle.FromLTRB(49, 610, 230, 626), runs(0).Box)
        Assert.Equal(Rectangle.FromLTRB(249, 602, 430, 637), runs(1).Box)
    End Sub

    <Fact>
    Public Sub TallWord_IsCutOnlyWhenStrictlyTallerThanTheRatioTimesTheMedian()
        ' Median 20, limit 1.6 x 20 = 32. A word of exactly 32 stays; 33 goes.
        Assert.Equal(20, OcrLineSplitter.MedianWordHeight(Row(20, 20, 32, 20, 20)))
        Assert.Single(OcrLineSplitter.SplitLine(Row(20, 20, 32, 20, 20)))
        Assert.Equal(2, OcrLineSplitter.SplitLine(Row(20, 20, 33, 20, 20)).Count)
    End Sub

    <Fact>
    Public Sub HeightRatio_IsTheTypeSizeRatio_ByReference_NotACopy()
        ' 1.7's text prints "(2.5)" after "type-size ratio" - the section that defines it. The value
        ' is 1.6: a token at 2.3x and one at 2.1x the median are cut in the reference's own page,
        ' which a 2.5 would leave stitched. One number, taken by reference.
        Assert.Equal(1.6, OcrLineSplitter.MaxWordHeightRatio, 6)
        Assert.Equal(OcrBlockBuilder.TypeSizeRatio, OcrLineSplitter.MaxWordHeightRatio)
        Assert.True(2.1 > OcrLineSplitter.MaxWordHeightRatio AndAlso 2.1 < 2.5)
    End Sub

    <Fact>
    Public Sub FirstWordOfALine_IsNeverACut_EvenWhenItIsTall()
        ' Nothing stands before it: the cut is BEFORE a word, and a line that opens on a tall token
        ' already starts where the token starts. Returned by identity, like any uncut line.
        Dim line As OcrLine = Row(60, 20, 20, 20, 20)
        Dim runs As List(Of OcrLine) = OcrLineSplitter.SplitLine(line)
        Assert.Single(runs)
        Assert.Same(line, runs(0))
    End Sub

    <Fact>
    Public Sub TwoWordLine_IsNeverCutByTheHeightRule()
        ' An even count takes the upper middle as the median (the median the gap rule uses), so in
        ' a pair the taller word IS the median and is not taller than 1.6 times itself.
        Assert.Equal(40, OcrLineSplitter.MedianWordHeight(Row(15, 40)))
        Assert.Single(OcrLineSplitter.SplitLine(Row(15, 40)))
        Assert.Single(OcrLineSplitter.SplitLine(Row(40, 15)))
    End Sub

    <Fact>
    Public Sub LineOfOneSize_IsNeverCut_AndAOneWordLineHasNothingToCut()
        ' The guard case of the reference's own fixture: a real line whose words vary by a pixel or
        ' two (14-17 px here) is one size.
        Assert.Single(OcrLineSplitter.SplitLine(Row(15, 17, 16, 15, 14, 16)))
        Assert.Single(OcrLineSplitter.SplitLine(Row(90)))
    End Sub

    <Fact>
    Public Sub MostlyTallWords_AreTheLinesOwnSize()
        ' The median is over ALL the words, the tall ones included. A line set mostly in large type
        ' has a large median, and its one small word is not an "outlier" by this rule - which only
        ' ever looks for a word TALLER than the line.
        Dim line As OcrLine = Row(20, 100, 100, 100, 100)
        Assert.Equal(100, OcrLineSplitter.MedianWordHeight(line))
        Assert.Single(OcrLineSplitter.SplitLine(line))
    End Sub

    <Fact>
    Public Sub ConsecutiveTallWords_EachStartTheirOwnRun_TheLiteralReading()
        ' "cuts before such a word" read literally: every word over the limit has a cut before it,
        ' so two tall tokens in a row make a run of one between the neighbours. The amendment says
        ' nothing about a pair; the reading closest to the text is kept and recorded here.
        Dim runs As List(Of OcrLine) = OcrLineSplitter.SplitLine(Row(20, 20, 20, 60, 60, 20, 20, 20))
        Assert.Equal(3, runs.Count)
        Assert.Equal({"w0 w1 w2", "w3", "w4 w5 w6 w7"}, runs.Select(Function(r) r.Text).ToArray())
    End Sub

    <Fact>
    Public Sub TallToken_OnAPage_ReportsRegrouped_SoTheClusteringIsToldToKeepTheOrder()
        ' A cut by the height rule is a cut like any other to the stage that follows: the runs are
        ' regrouped into columns and the clustering must not re-sort them.
        Dim regrouped As Boolean = False
        Dim lines As List(Of OcrLine) = OcrLineSplitter.SplitStitchedLines(
            New List(Of OcrLine) From {Row(20, 20, 60, 20, 20)}, regrouped)
        Assert.True(regrouped)
        Assert.Equal(2, lines.Count)

        ' ..and a page of ordinary lines is still returned by identity.
        Dim plain As New List(Of OcrLine) From {Row(20, 20, 21, 20, 20)}
        Assert.Same(plain, OcrLineSplitter.SplitStitchedLines(plain, regrouped))
        Assert.False(regrouped)
    End Sub

    ' --- the reading order -----------------------------------------------------

    <Fact>
    Public Sub CutRuns_AreRegroupedIntoColumns()
        ' Cutting alone makes things worse. The four runs come out of the cut interleaved -
        ' left, right, left, right - and the clustering is a single pass that closes its open
        ' plate on the first line that does not belong to it, so each balloon would break into
        ' fragments. Regrouped, each column arrives whole and top to bottom.
        Dim regrouped As Boolean = False
        Dim lines As List(Of OcrLine) = OcrLineSplitter.SplitStitchedLines(TightBalloonRows(), regrouped)

        Assert.True(regrouped)
        Assert.Equal(4, lines.Count)
        Assert.Equal({"| SAW IT", "MOVE AGAIN", "NO YOU DID NOT", "GO BACK TO BED"},
                     lines.Select(Function(l) l.Text).ToArray())

        ' ..and the clustering, told to keep that order, gives one block per balloon.
        Dim blocks As List(Of OcrBlock) = OcrBlockBuilder.BuildBlocks(
            lines, New Size(1600, 1000), Nothing, preserveOrder:=True)
        Assert.Equal(2, blocks.Count)
        Assert.Equal("| SAW IT MOVE AGAIN", blocks(0).SourceText)
        Assert.Equal("NO YOU DID NOT GO BACK TO BED", blocks(1).SourceText)
    End Sub

    <Fact>
    Public Sub PageWithNoStitch_IsNotTouchedAtAll()
        ' A page this stage has no business touching must come back BY IDENTITY, with the
        ' engine's own order. That is what keeps S7 from being able to regress a scene that
        ' reads correctly today.
        Dim input As New List(Of OcrLine) From {WidestGenuineLine()}
        Dim regrouped As Boolean = True
        Dim result As List(Of OcrLine) = OcrLineSplitter.SplitStitchedLines(input, regrouped)

        Assert.False(regrouped)
        Assert.Same(input, result)
    End Sub

    <Fact>
    Public Sub FloorFailingFullPageLine_FormsNoColumn()
        ' The engine also returns an empty 1800x1200 "line" over an 1800x1200 scene. It reaches
        ' no plate, but as a column it overlaps both real ones and chains them into one - which
        ' sorts the page straight back into the interleaving the regrouping just undid.
        Dim regrouped As Boolean = False
        Dim lines As List(Of OcrLine) = OcrLineSplitter.SplitStitchedLines(CaptionAndNotePage(), regrouped)

        Assert.True(regrouped)
        Assert.Equal(3, lines.Count)
        Assert.Equal("Platform nine at dusk", lines(0).Text)
        Assert.Equal("photograph by the author", lines(1).Text)
        ' Parked at the end, where only the discard record reads it.
        Assert.Equal("", lines(2).Text)
        Assert.Equal(New Rectangle(0, 0, 1800, 1200), lines(2).Box)

        ' The proof that it was excluded rather than merely sorted last: it overlaps both real
        ' runs, so had it formed a column they would all be one, and the caption would come out
        ' after the credit.
        Assert.True(OcrBlockBuilder.SharesColumn(lines(2).Box, lines(0).Box))
        Assert.True(OcrBlockBuilder.SharesColumn(lines(2).Box, lines(1).Box))
    End Sub

    <Fact>
    Public Sub BuildBlocks_WithoutPreserveOrder_StillSorts()
        ' The flag is opt-in, and the default has to stay exactly what every scene in the
        ' existing corpus was measured against.
        Dim lines As New List(Of OcrLine) From {
            MakeLine("second line here", New Rectangle(100, 300, 400, 30), 0.9F),
            MakeLine("first line here", New Rectangle(100, 100, 400, 30), 0.9F)
        }
        Dim sorted As List(Of OcrBlock) = OcrBlockBuilder.BuildBlocks(lines, New Size(800, 600), Nothing)
        Assert.Equal("first line here", sorted(0).Lines(0).Text)

        Dim kept As List(Of OcrBlock) = OcrBlockBuilder.BuildBlocks(
            lines, New Size(800, 600), Nothing, preserveOrder:=True)
        Assert.Equal("second line here", kept(0).Lines(0).Text)
    End Sub

    ' --- helpers ---------------------------------------------------------------

    ''' <summary>The measured quantity itself: widest gap between consecutive word boxes over
    ''' the median word height.</summary>
    Private Shared Function WidestRatio(line As OcrLine) As Double
        Dim widest As Integer = Integer.MinValue
        For i As Integer = 1 To line.Words.Count - 1
            widest = Math.Max(widest, OcrLineSplitter.GapBetween(line.Words(i - 1).Box, line.Words(i).Box))
        Next
        Return widest / CDbl(OcrLineSplitter.MedianWordHeight(line))
    End Function

End Class
