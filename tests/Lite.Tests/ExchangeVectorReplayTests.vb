#If Not NETFRAMEWORK Then
Option Strict On

Imports System.Collections.Generic
Imports System.IO
Imports System.Linq
Imports System.Text
Imports System.Text.Json
Imports System.Threading
Imports System.Threading.Tasks
Imports Xunit

''' <summary>A fact that needs the Go module's generated frames: skipped, loudly and by name, when the file is not there. A
''' skip is the honest answer - a vector this test made up would prove only that the VB codec agrees with itself.</summary>
Public NotInheritable Class ExchangeVectorFactAttribute
    Inherits FactAttribute

    Public Sub New()
        If Not File.Exists(ExchangeVectorCorpus.Path()) Then
            Skip = "the Go module's generated frames are absent (exchange-server/internal/wire/testdata/vectors.json); run `go test ./internal/wire -update-golden` in exchange-server"
        End If
    End Sub
End Class

''' <summary>The same, for the transcripts of ticket 178 (exchange-server/testdata/vectors/frames-v2.json): skipped by name when they are not generated yet.</summary>
Public NotInheritable Class ExchangeTranscriptFactAttribute
    Inherits FactAttribute

    Public Sub New()
        If Not File.Exists(ExchangeVectorCorpus.TranscriptPath()) Then
            Skip = "the Go module's transcripts are absent (exchange-server/testdata/vectors/frames-v2.json); run `go run ./cmd/exchange-vectors -out testdata/vectors` in exchange-server"
        End If
    End Sub
End Class

Friend NotInheritable Class ExchangeVectorCorpus

    Private Sub New()
    End Sub

    Friend Shared Function TranscriptPath() As String
        Dim root As String = ExchangeWireTestKit.RepoRoot()
        If root.Length = 0 Then Return ""
        Return System.IO.Path.Combine(root, "exchange-server", "testdata", "vectors", "frames-v2.json")
    End Function

    Friend Shared Function Path() As String
        Dim root As String = ExchangeWireTestKit.RepoRoot()
        If root.Length = 0 Then Return ""
        Return System.IO.Path.Combine(root, "exchange-server", "internal", "wire", "testdata", "vectors.json")
    End Function

    Friend NotInheritable Class Vector
        Public ReadOnly Name As String
        Public ReadOnly Json As String
        Public ReadOnly Hex As String

        Public Sub New(name As String, json As String, hex As String)
            Me.Name = name
            Me.Json = json
            Me.Hex = hex
        End Sub
    End Class

    ''' <summary>Every vector of the file, as written: name, the body, the whole frame in hex.</summary>
    Friend Shared Function Load() As List(Of Vector)
        Dim list As New List(Of Vector)
        Using doc As JsonDocument = JsonDocument.Parse(File.ReadAllText(Path(), New UTF8Encoding(False)))
            For Each item As JsonElement In doc.RootElement.EnumerateArray()
                list.Add(New Vector(item.GetProperty("name").GetString(), item.GetProperty("json").GetString(), item.GetProperty("hex").GetString()))
            Next
        End Using
        Return list
    End Function

End Class

''' <summary>
''' Ticket 180 T-1: the VB codec is a second implementation of the wire, held to the SAME generated frames as the Go server
''' (exchange-server/internal/wire/testdata/vectors.json, one single-frame vector per envelope type, regenerated by
''' <c>go test -update-golden</c>). For every vector the body decodes, encodes back to the very same bytes, and the frame the
''' library builds equals the recorded hex. The file is replayed as it stands - if the Go owner regenerates it, the next run
''' replays the new one; nothing here is copied from it.
''' </summary>
Public Class ExchangeVectorReplayTests

    Private Shared Function HexOf(bytes As Byte()) As String
        Return Convert.ToHexString(bytes).ToLowerInvariant()
    End Function

    <ExchangeVectorFact>
    Public Sub Every_vector_decodes_and_encodes_back_to_the_same_bytes_and_the_same_frame()
        Dim vectors As List(Of ExchangeVectorCorpus.Vector) = ExchangeVectorCorpus.Load()
        Assert.NotEmpty(vectors)
        For Each v As ExchangeVectorCorpus.Vector In vectors
            Dim body As Byte() = Encoding.UTF8.GetBytes(v.Json)
            Dim env As ExchangeEnvelope = ExchangeEnvelopeCodec.Decode(body)
            Assert.True(env.IsKnown, v.Name & ": the table does not know its type")

            Dim again As Byte() = ExchangeEnvelopeCodec.Encode(env)
            Assert.True(body.SequenceEqual(again), v.Name & ": body differs" & vbLf & v.Json & vbLf & Encoding.UTF8.GetString(again))

            Dim frame As Byte() = ExchangeFrameWriter.BuildFrame(env, ExchangeWire.MaxFrameAuthenticated)
            Assert.Equal(v.Hex.ToLowerInvariant(), HexOf(frame))
        Next
    End Sub

    <ExchangeVectorFact>
    Public Async Function Every_vector_frame_is_read_back_by_the_frame_reader() As Task
        For Each v As ExchangeVectorCorpus.Vector In ExchangeVectorCorpus.Load()
            Dim bytes As Byte() = Convert.FromHexString(v.Hex)
            Dim reader As New ExchangeFrameReader(New MemoryStream(bytes))
            reader.MarkAuthenticated()   ' a few vectors are authenticated-stream frames; none is larger than the pre-auth limit, which the next test checks
            Dim body As Byte() = Await reader.ReadBodyAsync(CancellationToken.None)
            Assert.Equal(v.Json, Encoding.UTF8.GetString(body))
        Next
    End Function

    <ExchangeVectorFact>
    Public Sub The_vectors_cover_every_type_of_the_table_and_the_table_every_type_of_the_vectors()
        Dim seen As New HashSet(Of String)(StringComparer.Ordinal)
        For Each v As ExchangeVectorCorpus.Vector In ExchangeVectorCorpus.Load()
            Using doc As JsonDocument = JsonDocument.Parse(v.Json)
                seen.Add(doc.RootElement.GetProperty("type").GetString())
            End Using
        Next
        For Each typeName As String In ExchangeEnvelopeTable.Types()
            Assert.True(seen.Contains(typeName), "no vector for type " & typeName)
        Next
        For Each typeName As String In seen
            Assert.True(ExchangeEnvelopeTable.Find(typeName) IsNot Nothing, "a vector of type " & typeName & " is not in the table")
        Next
    End Sub

    ''' <summary>The transcripts of ticket 178 (frames-v2.json), when the Go module has generated them: every frame of every transcript is classified, and a frame the
    ''' wire says is an envelope round-trips byte for byte and frame for frame.</summary>
    <ExchangeTranscriptFact>
    Public Sub Every_frame_of_the_generated_transcripts_replays_through_the_codec()
        Dim problems As New List(Of String)
        Dim replayed As Integer = 0
        Dim notEnvelopes As New List(Of String)
        Using doc As JsonDocument = JsonDocument.Parse(File.ReadAllText(ExchangeVectorCorpus.TranscriptPath(), New UTF8Encoding(False)))
            Dim limit As Integer = doc.RootElement.GetProperty("constants").GetProperty("maxFrameAuth").GetInt32()
            Assert.Equal(ExchangeWire.MaxFrameAuthenticated, limit)
            Assert.Equal(ExchangeWire.MaxFramePreAuth, doc.RootElement.GetProperty("constants").GetProperty("maxFrame").GetInt32())
            Assert.Equal(ExchangeWire.MaxChunkLengthField, doc.RootElement.GetProperty("constants").GetProperty("maxChunkLength").GetInt32())
            For Each transcript As JsonElement In doc.RootElement.GetProperty("transcripts").EnumerateArray()
                Dim name As String = transcript.GetProperty("name").GetString()
                Dim index As Integer = 0
                For Each stepEl As JsonElement In transcript.GetProperty("steps").EnumerateArray()
                    index += 1
                    Dim json As JsonElement = Nothing
                    Dim hex As JsonElement = Nothing
                    If Not stepEl.TryGetProperty("json", json) OrElse Not stepEl.TryGetProperty("hex", hex) Then Continue For
                    Dim where As String = name & " step " & index.ToString()
                    Dim body As Byte() = Encoding.UTF8.GetBytes(json.GetString())
                    Dim env As ExchangeEnvelope
                    Try
                        env = ExchangeEnvelopeCodec.Decode(body)
                    Catch ex As ExchangeWireException
                        ' a frame that is not a valid version-2 envelope: it is in a transcript to show the server's reaction, not to be replayed
                        notEnvelopes.Add(where & " (" & ex.Error.ToString() & ")")
                        Continue For
                    End Try
                    If Not env.IsKnown Then
                        notEnvelopes.Add(where & " (unknown type " & env.Type & ")")
                        Continue For
                    End If
                    Dim again As Byte() = ExchangeEnvelopeCodec.Encode(env)
                    If Not body.SequenceEqual(again) Then problems.Add(where & ": body differs")
                    Dim frame As Byte() = ExchangeFrameWriter.BuildFrame(env, ExchangeWire.MaxFrameAuthenticated)
                    If Not String.Equals(hex.GetString(), HexOf(frame), StringComparison.OrdinalIgnoreCase) Then problems.Add(where & ": frame differs")
                    replayed += 1
                Next
            Next
        End Using
        Assert.True(problems.Count = 0, String.Join(vbLf, problems.Take(20)))
        Assert.True(replayed > 100, "only " & replayed.ToString() & " frames replayed; the transcripts were expected to hold far more (not envelopes: " & String.Join("; ", notEnvelopes.Take(10)) & ")")
    End Sub

    ''' <summary>The relay chunk vectors of the same file: what a reader accepts, what ends a broadcast and what closes the stream (DEVICE-EXCHANGE 7.6, item U).</summary>
    <ExchangeTranscriptFact>
    Public Async Function Every_chunk_vector_reads_and_builds_as_the_server_says() As Task
        Dim checked As Integer = 0
        Using doc As JsonDocument = JsonDocument.Parse(File.ReadAllText(ExchangeVectorCorpus.TranscriptPath(), New UTF8Encoding(False)))
            For Each v As JsonElement In doc.RootElement.GetProperty("chunks").EnumerateArray()
                Dim name As String = v.GetProperty("name").GetString()
                Dim bytes As Byte() = Convert.FromHexString(v.GetProperty("hex").GetString())
                Dim verdict As String = v.GetProperty("verdict").GetString()
                Dim el As JsonElement = Nothing
                Select Case verdict
                    Case "ends-the-broadcast"
                        Assert.Null(Await ExchangeChunks.ReadAsync(New MemoryStream(bytes), CancellationToken.None))
                    Case "closes-the-stream"
                        Await Assert.ThrowsAsync(Of ExchangeWireException)(Function() ExchangeChunks.ReadAsync(New MemoryStream(bytes), CancellationToken.None))
                    Case Else   ' ordinary, joinable, header
                        Dim chunk As ExchangeChunk = Await ExchangeChunks.ReadAsync(New MemoryStream(bytes), CancellationToken.None)
                        Assert.NotNull(chunk)
                        Dim flags As Integer = If(v.TryGetProperty("flags", el), el.GetInt32(), 0)
                        Assert.Equal(CByte(flags), chunk.Flags)
                        Dim payload As Byte() = If(v.TryGetProperty("payloadHex", el), Convert.FromHexString(el.GetString()), Array.Empty(Of Byte)())
                        Assert.Equal(payload, chunk.Payload)
                        Assert.Equal(bytes, ExchangeChunks.Build(CByte(flags), payload))
                        Assert.Equal(verdict = "header", chunk.IsHeader)
                End Select
                checked += 1
            Next
            ' and the chunks of the upload transcript are built by the very same function
            For Each transcript As JsonElement In doc.RootElement.GetProperty("transcripts").EnumerateArray()
                For Each stepEl As JsonElement In transcript.GetProperty("steps").EnumerateArray()
                    Dim c As JsonElement = Nothing
                    If Not stepEl.TryGetProperty("chunk", c) Then Continue For
                    Dim recorded As String = c.GetProperty("hex").GetString()
                    If recorded = "00000000" Then
                        ' the clean end of a broadcast: a zero length, no flag byte
                        Assert.Equal(recorded, Convert.ToHexString(ExchangeChunks.EndMarker()).ToLowerInvariant())
                    Else
                        Dim flags As Byte = CByte(c.GetProperty("flags").GetInt32())
                        Dim payload As Byte() = Convert.FromHexString(c.GetProperty("payloadHex").GetString())
                        Assert.Equal(recorded, Convert.ToHexString(ExchangeChunks.Build(flags, payload)).ToLowerInvariant())
                    End If
                    checked += 1
                Next
            Next
        End Using
        Assert.True(checked >= 10)
    End Function

    <ExchangeVectorFact>
    Public Sub No_vector_frame_needs_more_than_the_pre_authentication_limit()
        ' the generated frames are single small frames; if one grows past 16384 the pre-auth reader above would hide it
        For Each v As ExchangeVectorCorpus.Vector In ExchangeVectorCorpus.Load()
            Assert.True(Encoding.UTF8.GetByteCount(v.Json) <= ExchangeWire.MaxFramePreAuth, v.Name)
        Next
    End Sub

End Class
#End If
