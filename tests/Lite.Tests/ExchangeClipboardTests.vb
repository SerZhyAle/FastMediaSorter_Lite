                                                   Await c.WriteAsync(ValueEnvelope(payload, "file"))
                                                   Await c.Stream.WriteAsync(payload, 0, payload.Length, c.Token)
                                               End Function)
            Using cts As CancellationTokenSource = ExchangeWireTestKit.Cts()
                Dim failed As ExchangeClipboardResult = Await ExchangeClipboardClient.GetAsync(ExchangeTlsTransport.Instance, Target(srv), srv.Fingerprint,
                    Creds(), "1", "", Function(v) New FailingSink(), cts.Token)
                Assert.Equal(ExchangeClipboardOutcome.LocalFailure, failed.Outcome)
            End Using
        End Using
    End Function

    Private NotInheritable Class FailingSink
        Inherits MemoryStream

        Public Overrides Function WriteAsync(buffer() As Byte, offset As Integer, count As Integer, cancellationToken As CancellationToken) As Task
            Throw New IOException("disk full")
        End Function
    End Class

    <Fact>
    Public Async Function A_server_that_sends_the_value_and_then_stalls_ends_the_get_inside_the_idle_bound() As Task
        Dim payload As Byte() = Pattern(1000)
        Using srv As New ExchangeStubTlsServer(Async Function(c)
                                                   Await AnswerHelloAsync(c, New List(Of String))
                                                   Await c.ReadAsync()
                                                   Await c.WriteAsync(ValueEnvelope(payload, "text"))
                                                   Await c.Stream.WriteAsync(payload, 0, 100, c.Token)
                                                   Await c.Stream.FlushAsync(c.Token)
                                                   Try
                                                       Await Task.Delay(Timeout.Infinite, c.Token)
                                                   Catch ex As OperationCanceledException
                                                   End Try
                                               End Function)
            Using cts As CancellationTokenSource = ExchangeWireTestKit.Cts()
                Dim result As ExchangeClipboardResult = Await ExchangeClipboardClient.GetAsync(ExchangeTlsTransport.Instance, Target(srv), srv.Fingerprint,
                    Creds(), "1", "", Function(v) New MemoryStream(), cts.Token, TimeSpan.FromMilliseconds(400))
                Assert.Equal(ExchangeClipboardOutcome.Transport, result.Outcome)
                Assert.Equal(ExchangeOpenOutcome.TimedOut, result.Open)
            End Using
        End Using
    End Function

    ' ---------------------------------------------------------------- state

    <Fact>
    Public Async Function A_state_carries_the_value_members_and_an_empty_one_has_none() As Task
        Dim value As String = "{""clipId"":""" & ExchangeWireTestKit.IdOf("C"c) & """,""size"":42,""sha256"":""" & New String("b"c, 64) &
            """,""storedAt"":""2026-10-15T09:30:00Z"",""sourceDeviceId"":""" & ExchangeWireTestKit.IdOf("S"c) & """,""sourceDeviceName"":""Laptop"",""kind"":""text"",""future"":{""x"":1}}"
        Dim calls As Integer = 0
        Using srv As New ExchangeStubTlsServer(Async Function(c)
                                                   Await AnswerHelloAsync(c, New List(Of String))
                                                   Dim info As ExchangeEnvelope = Await c.ReadAsync()
                                                   Assert.True(info.Is("clipboard-info"))
                                                   Interlocked.Increment(calls)
                                                   If Interlocked.CompareExchange(calls, 0, 0) = 1 Then
                                                       Await c.WriteAsync(New ExchangeEnvelope("clipboard-state").SetRecord("value", value))
                                                   Else
                                                       Await c.WriteAsync(New ExchangeEnvelope("clipboard-state"))
                                                   End If
                                               End Function)
            Using cts As CancellationTokenSource = ExchangeWireTestKit.Cts()
                Dim withValue As ExchangeClipboardResult = Await ExchangeClipboardClient.StateAsync(ExchangeTlsTransport.Instance, Target(srv), srv.Fingerprint, Creds(), "1", cts.Token)
                Assert.Equal(ExchangeClipboardOutcome.Done, withValue.Outcome)
                Assert.Equal(42L, withValue.Value.Size)
                Assert.Equal("Laptop", withValue.Value.SourceDeviceName)
                Assert.Equal(New DateTime(2026, 10, 15, 9, 30, 0, DateTimeKind.Utc), withValue.Value.StoredAtUtc)
                Dim empty As ExchangeClipboardResult = Await ExchangeClipboardClient.StateAsync(ExchangeTlsTransport.Instance, Target(srv), srv.Fingerprint, Creds(), "1", cts.Token)
                Assert.Equal(ExchangeClipboardOutcome.Empty, empty.Outcome)
            End Using
        End Using
    End Function

    ' ---------------------------------------------------------------- the member rules of item BW and the saved name of item CB

    <Fact>
    Public Sub The_name_and_mime_rules_of_item_BW_hold()
        Assert.True(ExchangeClipboardRules.IsValidName("report 2026.pdf"))
        Assert.True(ExchangeClipboardRules.IsValidName("файл.txt"))
        Assert.False(ExchangeClipboardRules.IsValidName(""))
        Assert.False(ExchangeClipboardRules.IsValidName("."))
        Assert.False(ExchangeClipboardRules.IsValidName(".."))
        Assert.False(ExchangeClipboardRules.IsValidName("a/b"))
        Assert.False(ExchangeClipboardRules.IsValidName("a\b"))
        Assert.False(ExchangeClipboardRules.IsValidName("a" & vbTab & "b"))
        Assert.True(ExchangeClipboardRules.IsValidName(New String("x"c, 255)))
        Assert.False(ExchangeClipboardRules.IsValidName(New String("x"c, 256)))
        Assert.False(ExchangeClipboardRules.IsValidName(New String("я"c, 128)))     ' 256 bytes of UTF-8
        Assert.True(ExchangeClipboardRules.IsValidMime("image/png"))
        Assert.True(ExchangeClipboardRules.IsValidMime("application/vnd.ms-excel"))
        Assert.False(ExchangeClipboardRules.IsValidMime("png"))
        Assert.False(ExchangeClipboardRules.IsValidMime("image/"))
        Assert.False(ExchangeClipboardRules.IsValidMime("/png"))
        Assert.False(ExchangeClipboardRules.IsValidMime("image/png; charset=x"))
        Assert.False(ExchangeClipboardRules.IsValidMime("a/b/c"))
        Assert.False(ExchangeClipboardRules.IsValidMime("image/" & New String("p"c, 130)))
    End Sub

    <Fact>
    Public Sub A_sender_names_a_file_by_its_base_name_cut_at_a_character_boundary()
        Assert.Equal("a.pdf", ExchangeClipboardRules.NameForSend("C:\Users\me\Docs\a.pdf"))
        Assert.Equal("a.pdf", ExchangeClipboardRules.NameForSend("/home/me/a.pdf"))
        Assert.Equal("", ExchangeClipboardRules.NameForSend(""))
        Dim long_ As String = New String("я"c, 200) & ".txt"        ' 404 bytes
        Dim cut As String = ExchangeClipboardRules.NameForSend(long_)
        Assert.True(Encoding.UTF8.GetByteCount(cut) <= 255)
        Assert.True(ExchangeClipboardRules.IsValidName(cut))
    End Sub

    <Fact>
    Public Sub A_receiver_saves_under_a_base_name_with_refused_characters_replaced_and_makes_one_when_there_is_none()
        Dim at As New DateTime(2026, 10, 15, 9, 5, 7, DateTimeKind.Utc)
        Assert.Equal("a.pdf", ExchangeClipboardRules.ReceivedFileName("a.pdf", at, "application/pdf"))
        Assert.Equal("evil.exe", ExchangeClipboardRules.ReceivedFileName("..\..\Windows\evil.exe", at, ""))
        Assert.Equal("a_b.txt", ExchangeClipboardRules.ReceivedFileName("a:b.txt", at, ""))
        Assert.Equal("_CON.txt", ExchangeClipboardRules.ReceivedFileName("CON.txt", at, ""))
        Assert.Equal("clipboard-20261015-090507.png", ExchangeClipboardRules.ReceivedFileName("", at, "image/png"))
        Assert.Equal("clipboard-20261015-090507.png", ExchangeClipboardRules.ReceivedFileName("...", at, "image/png"))
        Assert.Equal("clipboard-20261015-090507.bin", ExchangeClipboardRules.ReceivedFileName("", at, "application/x-unknown"))
        Dim saved As String = ExchangeClipboardRules.ReceivedFileName(New String("z"c, 400) & ".txt", at, "")
        Assert.True(saved.Length <= 150)
        Assert.EndsWith(".txt", saved)
        Assert.Equal(-1, saved.IndexOfAny(Path.GetInvalidFileNameChars()))
    End Sub

    <Fact>
    Public Sub No_result_or_value_prints_a_member()
        Dim value As New ExchangeClipboardValue(ExchangeWireTestKit.IdOf("C"c), 5, New String("c"c, 64), "2026-10-15T10:00:00Z", "", "My Phone", "file", "application/pdf", "secret-plan.pdf")
        Dim result As New ExchangeClipboardResult(ExchangeClipboardOutcome.Done, ExchangeOpenOutcome.Connected, ExchangeRefusal.Unknown, value)
        For Each text As String In {value.ToString(), result.ToString()}
            Assert.DoesNotContain("secret-plan", text)
            Assert.DoesNotContain("My Phone", text)
            Assert.DoesNotContain(New String("c"c, 8), text)
            Assert.DoesNotContain(ExchangeWireTestKit.IdOf("C"c), text)
        Next
    End Sub

