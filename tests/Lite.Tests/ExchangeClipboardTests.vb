    Public Async Function A_server_without_the_feature_and_a_guest_account_are_not_offered_and_get_no_put(withClipboard As Boolean, guest As Boolean) As Task
        Dim seen As New List(Of String)
        Using srv As New ExchangeStubTlsServer(Async Function(c)
                                                   Await AnswerHelloAsync(c, seen, withClipboard, guest)
                                                   Dim next_ As ExchangeEnvelope = Nothing
                                                   Try
                                                       next_ = Await c.ReadAsync()
                                                       seen.Add(next_.Type)
                                                   Catch ex As Exception When TypeOf ex Is EndOfStreamException OrElse TypeOf ex Is IOException OrElse TypeOf ex Is OperationCanceledException
                                                   End Try
                                               End Function)
            Using cts As CancellationTokenSource = ExchangeWireTestKit.Cts()
                Using content As New PatternStream(10)
                    Dim result As ExchangeClipboardResult = Await ExchangeClipboardClient.PutAsync(ExchangeTlsTransport.Instance, Target(srv), srv.Fingerprint,
                        Creds(), "1", ExchangeClipboardKinds.Text, 10, "", "", content, cts.Token)
                    Assert.Equal(ExchangeClipboardOutcome.NotOffered, result.Outcome)
                    Assert.Equal(0, content.Reads)
                End Using
            End Using
            Await Task.Delay(100)
        End Using
        Assert.Equal({"hello"}, seen.ToArray())
    End Function

