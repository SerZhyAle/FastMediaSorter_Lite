    <Fact>
    Public Async Function A_get_whose_hash_differs_or_whose_stream_is_short_places_nothing() As Task
        For Each scenario As Integer In {0, 1, 2}
            Dim payload As Byte() = Pattern(5000)
            Using srv As New ExchangeStubTlsServer(Async Function(c)
                                                       Await AnswerHelloAsync(c, New List(Of String))
                                                       Await c.ReadAsync()
                                                       Select Case scenario
                                                           Case 0     ' a bad hash
                                                               Await c.WriteAsync(ValueEnvelope(payload, "text", New String("a"c, 64)))
                                                               Await c.Stream.WriteAsync(payload, 0, payload.Length, c.Token)
                                                           Case 1     ' fewer bytes than said, then the stream closes
                                                               Await c.WriteAsync(ValueEnvelope(payload, "text"))
                                                               Await c.Stream.WriteAsync(payload, 0, 4000, c.Token)
                                                           Case Else  ' the right count, one byte different
                                                               Dim bent As Byte() = DirectCast(payload.Clone(), Byte())
                                                               bent(2500) = CByte(bent(2500) Xor &H1)
                                                               Await c.WriteAsync(ValueEnvelope(payload, "text"))
                                                               Await c.Stream.WriteAsync(bent, 0, bent.Length, c.Token)
                                                       End Select
                                                       Await c.Stream.FlushAsync(c.Token)
                                                   End Function)
                Using cts As CancellationTokenSource = ExchangeWireTestKit.Cts()
                    Dim result As ExchangeClipboardResult = Await ExchangeClipboardClient.GetAsync(ExchangeTlsTransport.Instance, Target(srv), srv.Fingerprint,
                        Creds(), "1", "", Function(v) New MemoryStream(), cts.Token)
                    Assert.True(result.Outcome = ExchangeClipboardOutcome.Mismatch OrElse
                                (scenario = 1 AndAlso result.Outcome = ExchangeClipboardOutcome.Transport), "scenario " & scenario & ": " & result.Outcome.ToString())
                    Assert.False(result.IsDone)
                End Using
            End Using
        Next
    End Function

