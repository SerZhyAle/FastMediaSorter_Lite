''' <summary>
''' Spec 230 T-2: the clipboard client of DEVICE-EXCHANGE section 22 (items BW, BX, BY, CA) against a scripted TLS server. What is held:
''' the order and the members of the envelopes, that the content is raw bytes after `clipboard-ready` / `clipboard-value` and never an
''' envelope, that a send is reported done only on `clipboard-stored`, that a get never reports a partial value, that a refusal or a
''' silent server is a named outcome, and the member rules of item BW.
''' </summary>
Public Class ExchangeClipboardTests

    Private Shared Function Target(s As ExchangeStubTlsServer) As ExchangeServerAddress
        Return New ExchangeServerAddress("127.0.0.1", s.Port)
    End Function

    Private Shared Function Creds() As ExchangeDeviceCredentials
        Return New ExchangeDeviceCredentials(ExchangeWireTestKit.IdOf("D"c), ExchangeWireTestKit.TokenOf("T"c))
    End Function

    Private Shared Function Sha(bytes As Byte()) As String
        Return Convert.ToHexString(SHA256.HashData(bytes)).ToLowerInvariant()
    End Function

    Private Shared Function Pattern(length As Integer) As Byte()
        Dim b(length - 1) As Byte
        For i As Integer = 0 To length - 1
            b(i) = CByte((i * 31 + 7) Mod 251)
        Next
        Return b
    End Function

    ''' <summary>The server end of a successful `hello`, welcoming with the clipboard feature (or without, or as a guest).</summary>
    Private Shared Async Function AnswerHelloAsync(c As ExchangeStubConnection, seen As List(Of String),
                                                    Optional withClipboard As Boolean = True, Optional guest As Boolean = False) As Task
        Dim hello As ExchangeEnvelope = Await c.ReadAsync()
        seen.Add(hello.Type)
        Dim features As String() = If(withClipboard, New String() {"directory", "tunnel", "clipboard"}, New String() {"directory", "tunnel"})
        Dim welcome As ExchangeEnvelope = c.Welcome(features:=features)
        If guest Then welcome.SetText("accountKind", "guest")
        Await c.WriteAsync(welcome)
        c.Authenticated()
    End Function

    Private Shared Async Function ReadExactAsync(stream As Stream, count As Long, token As CancellationToken) As Task(Of Byte())
        Dim result(CInt(count) - 1) As Byte
        Dim got As Integer = 0
        While got < result.Length
            Dim n As Integer = Await stream.ReadAsync(result, got, result.Length - got, token)
            If n = 0 Then Exit While
            got += n
        End While
        If got < result.Length Then ReDim Preserve result(got - 1)
        Return result
    End Function

    ''' <summary>Reads `count` bytes and returns their SHA-256 without keeping them (a streamed file is not held whole).</summary>
    Private Shared Async Function HashExactAsync(stream As Stream, count As Long, token As CancellationToken) As Task(Of Tuple(Of Long, String))
        Dim buffer(65535) As Byte
        Dim got As Long = 0
        Using h As IncrementalHash = IncrementalHash.CreateHash(HashAlgorithmName.SHA256)
            While got < count
                Dim n As Integer = Await stream.ReadAsync(buffer, 0, CInt(Math.Min(count - got, CLng(buffer.Length))), token)
                If n = 0 Then Exit While
                h.AppendData(buffer, 0, n)
                got += n
            End While
            Return Tuple.Create(got, Convert.ToHexString(h.GetHashAndReset()).ToLowerInvariant())
        End Using
    End Function

    ''' <summary>A read-only stream of `length` generated bytes that remembers the largest single read it was asked for.</summary>
    Private NotInheritable Class PatternStream
        Inherits Stream

        Private ReadOnly _length As Long
        Private _position As Long
        Public MaxRead As Integer
        Public Reads As Integer

        Public Sub New(length As Long)
            _length = length
        End Sub

        Public Shared Function ByteAt(index As Long) As Byte
            Return CByte((index * 31 + 7) Mod 251)
        End Function

        Public Overrides ReadOnly Property CanRead As Boolean
            Get
                Return True
            End Get
        End Property
        Public Overrides ReadOnly Property CanSeek As Boolean
            Get
                Return False
            End Get
        End Property
        Public Overrides ReadOnly Property CanWrite As Boolean
            Get
                Return False
            End Get
        End Property
        Public Overrides ReadOnly Property Length As Long
            Get
                Return _length
            End Get
        End Property
        Public Overrides Property Position As Long
            Get
                Return _position
            End Get
            Set(value As Long)
                Throw New NotSupportedException()
            End Set
        End Property

        Public Overrides Function Read(buffer() As Byte, offset As Integer, count As Integer) As Integer
            Reads += 1
            MaxRead = Math.Max(MaxRead, count)
            Dim n As Integer = CInt(Math.Min(CLng(count), _length - _position))
            For i As Integer = 0 To n - 1
                buffer(offset + i) = ByteAt(_position + i)
            Next
            _position += n
            Return n
        End Function

        Public Overrides Sub Flush()
        End Sub
        Public Overrides Function Seek(offset As Long, origin As SeekOrigin) As Long
            Throw New NotSupportedException()
        End Function
        Public Overrides Sub SetLength(value As Long)
            Throw New NotSupportedException()
        End Sub
        Public Overrides Sub Write(buffer() As Byte, offset As Integer, count As Integer)
            Throw New NotSupportedException()
        End Sub
    End Class

    ' ---------------------------------------------------------------- send

    <Fact>
    Public Async Function A_text_put_is_hello_put_ready_raw_bytes_stored_and_the_bytes_are_not_an_envelope() As Task
        Dim seen As New List(Of String)
        Dim payload As Byte() = Encoding.UTF8.GetBytes("line one" & vbLf & "line two" & vbLf & "{""type"":""bye""}" & vbLf & "tail")
        Dim got As Byte() = Nothing
        Dim put As ExchangeEnvelope = Nothing
        Using srv As New ExchangeStubTlsServer(Async Function(c)
                                                   Await AnswerHelloAsync(c, seen)
                                                   put = Await c.ReadAsync()
                                                   seen.Add(put.Type)
                                                   Await c.WriteAsync(New ExchangeEnvelope("clipboard-ready"))
                                                   got = Await ReadExactAsync(c.Stream, put.Number("size"), c.Token)
                                                   Await c.WriteAsync(New ExchangeEnvelope("clipboard-stored").SetText("clipId", ExchangeWireTestKit.IdOf("C"c)).
                                                                      SetText("sha256", Sha(got)).SetText("storedAt", "2026-10-15T10:00:00Z"))
                                               End Function)
            Using cts As CancellationTokenSource = ExchangeWireTestKit.Cts()
                Using content As New MemoryStream(payload)
                    Dim result As ExchangeClipboardResult = Await ExchangeClipboardClient.PutAsync(ExchangeTlsTransport.Instance, Target(srv), srv.Fingerprint,
                        Creds(), "26.10.15.1", ExchangeClipboardKinds.Text, payload.Length, "", "", content, cts.Token)
                    Assert.Equal(ExchangeClipboardOutcome.Done, result.Outcome)
                    Assert.Equal(ExchangeWireTestKit.IdOf("C"c), result.Value.ClipId)
                    Assert.Equal(Sha(payload), result.Value.Sha256)
                End Using
            End Using
        End Using
        Assert.Equal({"hello", "clipboard-put"}, seen.ToArray())
        Assert.Equal("text", put.Text("kind"))
        Assert.Equal(CLng(payload.Length), put.Number("size"))
        Assert.Equal("", put.Text("mimeType"))
        Assert.Equal("", put.Text("name"))
        Assert.Equal(payload, got)
    End Function

    <Fact>
    Public Sub A_put_writes_its_members_in_the_order_of_the_table_and_leaves_out_the_ones_a_kind_does_not_have()
        Dim text As String = Encoding.UTF8.GetString(ExchangeEnvelopeCodec.Encode(ExchangeMessages.ClipboardPut("text", 12, "", "")))
        Assert.Equal("{""schemaVersion"":2,""type"":""clipboard-put"",""kind"":""text"",""size"":12}", text)
        Dim image As String = Encoding.UTF8.GetString(ExchangeEnvelopeCodec.Encode(ExchangeMessages.ClipboardPut("image", 3, "image/png", "")))
        Assert.Equal("{""schemaVersion"":2,""type"":""clipboard-put"",""kind"":""image"",""size"":3,""mimeType"":""image/png""}", image)
        Dim file As String = Encoding.UTF8.GetString(ExchangeEnvelopeCodec.Encode(ExchangeMessages.ClipboardPut("file", 9, "application/pdf", "a.pdf")))
        Assert.Equal("{""schemaVersion"":2,""type"":""clipboard-put"",""kind"":""file"",""size"":9,""mimeType"":""application/pdf"",""name"":""a.pdf""}", file)
        Assert.Equal("{""schemaVersion"":2,""type"":""clipboard-get""}", Encoding.UTF8.GetString(ExchangeEnvelopeCodec.Encode(ExchangeMessages.ClipboardGet(""))))
        Assert.Equal("{""schemaVersion"":2,""type"":""clipboard-info""}", Encoding.UTF8.GetString(ExchangeEnvelopeCodec.Encode(ExchangeMessages.ClipboardInfo())))
    End Sub

    <Fact>
    Public Async Function A_large_file_is_streamed_in_pieces_and_arrives_byte_for_byte() As Task
        Const Size As Long = 6L * 1024L * 1024L + 12345L
        Dim seen As New List(Of String)
        Dim received As Tuple(Of Long, String) = Nothing
        Dim put As ExchangeEnvelope = Nothing
        Using srv As New ExchangeStubTlsServer(Async Function(c)
                                                   Await AnswerHelloAsync(c, seen)
                                                   put = Await c.ReadAsync()
                                                   Await c.WriteAsync(New ExchangeEnvelope("clipboard-ready"))
                                                   received = Await HashExactAsync(c.Stream, put.Number("size"), c.Token)
                                                   Await c.WriteAsync(New ExchangeEnvelope("clipboard-stored").SetText("clipId", ExchangeWireTestKit.IdOf("C"c)).
                                                                      SetText("sha256", received.Item2).SetText("storedAt", "2026-10-15T10:00:00Z"))
                                               End Function)
            Using cts As CancellationTokenSource = ExchangeWireTestKit.Cts()
                Using content As New PatternStream(Size)
                    Dim result As ExchangeClipboardResult = Await ExchangeClipboardClient.PutAsync(ExchangeTlsTransport.Instance, Target(srv), srv.Fingerprint,
                        Creds(), "1", ExchangeClipboardKinds.File, Size, "application/octet-stream", "big.bin", content, cts.Token)
                    Assert.Equal(ExchangeClipboardOutcome.Done, result.Outcome)
                    Assert.True(content.MaxRead <= 81920, "a piece was " & content.MaxRead & " bytes: the file must not be read whole")
                    Assert.True(content.Reads > 50)
                End Using
            End Using
        End Using
        Assert.Equal("file", put.Text("kind"))
        Assert.Equal("big.bin", put.Text("name"))
        Assert.Equal(Size, received.Item1)
        Dim expected As Byte() = New Byte(CInt(Size) - 1) {}
        For i As Integer = 0 To expected.Length - 1
            expected(i) = PatternStream.ByteAt(i)
        Next
        Assert.Equal(Sha(expected), received.Item2)
    End Function

    <Theory>
    <InlineData("limit-reached", "LimitReached")>
    <InlineData("not-permitted", "NotPermitted")>
    <InlineData("capacity", "Capacity")>
    Public Async Function A_refused_put_is_a_named_outcome_and_the_source_is_never_read(reason As String, expectedName As String) As Task
        Dim seen As New List(Of String)
        Using srv As New ExchangeStubTlsServer(Async Function(c)
                                                   Await AnswerHelloAsync(c, seen)
                                                   Dim put As ExchangeEnvelope = Await c.ReadAsync()
                                                   seen.Add(put.Type)
                                                   Await c.Refuse(reason)
                                               End Function)
            Using cts As CancellationTokenSource = ExchangeWireTestKit.Cts()
                Using content As New PatternStream(1000)
                    Dim result As ExchangeClipboardResult = Await ExchangeClipboardClient.PutAsync(ExchangeTlsTransport.Instance, Target(srv), srv.Fingerprint,
                        Creds(), "1", ExchangeClipboardKinds.Text, 1000, "", "", content, cts.Token)
                    Assert.Equal(ExchangeClipboardOutcome.Refused, result.Outcome)
                    Assert.Equal(DirectCast([Enum].Parse(GetType(ExchangeRefusal), expectedName), ExchangeRefusal), result.Refusal)
                    Assert.Equal(reason, result.RefusalName)
                    Assert.Equal(0, content.Reads)
                End Using
            End Using
        End Using
        Assert.Equal({"hello", "clipboard-put"}, seen.ToArray())
    End Function

    <Theory>
    <InlineData(False, False)>
