    <Fact>
    Public Async Function A_put_that_breaks_the_member_rules_opens_no_stream() As Task
        Using srv As New ExchangeStubTlsServer(Function(c) Task.CompletedTask)
            Using cts As CancellationTokenSource = ExchangeWireTestKit.Cts()
                Using content As New MemoryStream(Pattern(8))
                    Dim bad As ExchangeClipboardResult() = {
                        Await ExchangeClipboardClient.PutAsync(ExchangeTlsTransport.Instance, Target(srv), srv.Fingerprint, Creds(), "1", "text", 8, "", "a.txt", content, cts.Token),
                        Await ExchangeClipboardClient.PutAsync(ExchangeTlsTransport.Instance, Target(srv), srv.Fingerprint, Creds(), "1", "image", 8, "", "", content, cts.Token),
                        Await ExchangeClipboardClient.PutAsync(ExchangeTlsTransport.Instance, Target(srv), srv.Fingerprint, Creds(), "1", "file", 8, "application/pdf", "", content, cts.Token),
                        Await ExchangeClipboardClient.PutAsync(ExchangeTlsTransport.Instance, Target(srv), srv.Fingerprint, Creds(), "1", "file", 8, "application/pdf", "a/b.pdf", content, cts.Token),
                        Await ExchangeClipboardClient.PutAsync(ExchangeTlsTransport.Instance, Target(srv), srv.Fingerprint, Creds(), "1", "text", 0, "", "", content, cts.Token),
                        Await ExchangeClipboardClient.PutAsync(ExchangeTlsTransport.Instance, Target(srv), srv.Fingerprint, Creds(), "1", "folder", 8, "", "", content, cts.Token)}
                    For Each r As ExchangeClipboardResult In bad
                        Assert.Equal(ExchangeClipboardOutcome.Invalid, r.Outcome)
                    Next
                End Using
            End Using
            Assert.Equal(0, srv.Accepted)
        End Using
    End Function

    ' ---------------------------------------------------------------- receive

    Private Shared Function ValueEnvelope(bytes As Byte(), kind As String, Optional sha256 As String = Nothing, Optional size As Long = -1) As ExchangeEnvelope
        Return New ExchangeEnvelope("clipboard-value").SetText("clipId", ExchangeWireTestKit.IdOf("C"c)).SetNumber("size", If(size < 0, bytes.Length, size)).
            SetText("sha256", If(sha256, Sha(bytes))).SetText("storedAt", "2026-10-15T10:00:00Z").
            SetText("sourceDeviceId", ExchangeWireTestKit.IdOf("S"c)).SetText("sourceDeviceName", "Phone").
            SetText("kind", kind).SetText("mimeType", If(kind = "text", "", "image/png"))
    End Function

    <Fact>
    Public Async Function A_get_is_hello_get_value_raw_bytes_and_the_bytes_land_in_the_sink() As Task
        Dim seen As New List(Of String)
        Dim payload As Byte() = Pattern(300000)
        Dim get_ As ExchangeEnvelope = Nothing
        Using srv As New ExchangeStubTlsServer(Async Function(c)
                                                   Await AnswerHelloAsync(c, seen)
                                                   get_ = Await c.ReadAsync()
                                                   seen.Add(get_.Type)
                                                   Await c.WriteAsync(ValueEnvelope(payload, "image"))
                                                   Await c.Stream.WriteAsync(payload, 0, payload.Length, c.Token)
                                                   Await c.Stream.FlushAsync(c.Token)
                                               End Function)
            Using cts As CancellationTokenSource = ExchangeWireTestKit.Cts()
                Using sink As New MemoryStream()
                    Dim seenValue As ExchangeClipboardValue = Nothing
                    Dim result As ExchangeClipboardResult = Await ExchangeClipboardClient.GetAsync(ExchangeTlsTransport.Instance, Target(srv), srv.Fingerprint,
                        Creds(), "1", "", Function(v)
                                              seenValue = v
                                              Return sink
                                          End Function, cts.Token)
                    Assert.Equal(ExchangeClipboardOutcome.Done, result.Outcome)
                    Assert.Equal(payload, sink.ToArray())
                    Assert.Equal("image", result.Value.Kind)
                    Assert.Equal("image/png", result.Value.MimeType)
                    Assert.Equal("Phone", result.Value.SourceDeviceName)
                    Assert.Equal(ExchangeWireTestKit.IdOf("S"c), result.Value.SourceDeviceId)
                    Assert.Equal(New DateTime(2026, 10, 15, 10, 0, 0, DateTimeKind.Utc), result.Value.StoredAtUtc)
                    Assert.Same(seenValue, result.Value)
                End Using
            End Using
        End Using
        Assert.Equal({"hello", "clipboard-get"}, seen.ToArray())
        Assert.Equal("", get_.Text("clipId"))
    End Function

