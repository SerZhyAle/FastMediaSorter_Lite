  <!-- The catalog's conformance vectors, vendored as ARTIFACTS beside a PROVENANCE.txt
       that names the contract, its version, the date taken and each file's SHA-256 - the
       tests check those digests before trusting a byte. A test that depends on a drive
       letter cannot run for anyone else, which is why they travel with the suite; the
       documents themselves stay in the catalog and are only cited. -->
  <ItemGroup>
    <None Include="TestData\resources\fmscfg\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>TestData\resources\fmscfg\%(Filename)%(Extension)</Link>
    </None>    <None Include="TestData\fdsec-vectors\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>TestData\fdsec-vectors\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <!-- Real 7z files made by 7-Zip (ArchiveSequentialTests): a solid and a non-solid one, a
         twelve-page solid one for the cache-budget rows, and two encrypted. manifest.txt lists
         what is inside (size + SHA-256), so a test proves WHAT came out, not only that
         something did. README.txt says how to make them again. -->
    <None Include="TestData\documents\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="TestData\archives\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>TestData\archives\%(Filename)%(Extension)</Link>
    </None>
    <None Include="TestData\icon-vocabulary\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>TestData\icon-vocabulary\%(Filename)%(Extension)</Link>
    </None>
    <None Include="TestData\user-playlist-vectors\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>TestData\user-playlist-vectors\%(Filename)%(Extension)</Link>
    </None>
    <!-- LETTERBOX-BARS / LETTERBOX-HALO rung 1 vectors (ticket 183), beside their PROVENANCE.txt, which
         LetterboxFillConformanceTests checks before it trusts a byte. -->
    <None Include="TestData\letterbox-vectors\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>TestData\letterbox-vectors\%(Filename)%(Extension)</Link>
    </None>
    <!-- INPUT-CHORD rung 1 token vectors (ticket 183), beside their PROVENANCE.txt, which
         InputChordConformanceTests checks before it trusts a byte. -->
    <None Include="TestData\input-chord-vectors\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>TestData\input-chord-vectors\%(Filename)%(Extension)</Link>
    </None>
    <!-- OCR-PIPELINE 1.7 A / 1.8 shared cases (ticket 183), beside their PROVENANCE.txt, which
         OcrPipelineVectorTests checks before it trusts a byte. -->
    <None Include="TestData\ocr-pipeline-vectors\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>TestData\ocr-pipeline-vectors\%(Filename)%(Extension)</Link>
    </None>
    <!-- Ticket 170 T-1: the ANYWHERE-ACCESS rung 1 vectors (the FMSSFTP1/2 code), beside their PROVENANCE.txt. -->
    <None Include="TestData\anywhere-descriptor-vectors\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>TestData\anywhere-descriptor-vectors\%(Filename)%(Extension)</Link>
    </None>
    <!-- Ticket 177: the committed "today" baseline of the exchange dual-mode regression (a capture of the
         viewer started on a clean profile before any exchange client code existed, and its PROVENANCE.txt,
         which DualModeFixtures checks first). Captured by tests\Integration\ExchangeBaseline.ps1. -->
    <None Include="TestData\exchange-vectors\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="TestData\dual-mode\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>TestData\dual-mode\%(Filename)%(Extension)</Link>
    </None>
    <None Include="..\..\assets\glyphs\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>TestData\glyphs\%(Filename)%(Extension)</Link>
    </None>
    <None Include="..\..\assets\glyphs\PROVENANCE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>TestData\glyphs\PROVENANCE.txt</Link>
    </None>
  </ItemGroup>

  <!-- Ticket 180 T-1: the client library of the device exchange. Every file is whole-file "#If Not NETFRAMEWORK", so on the
       net48 leg they compile to nothing (and the net48 viewer project lists none of them - ExchangeClientGuardTests). -->
  <ItemGroup>
    <Compile Include="..\..\src\Exchange\*.vb" Link="Linked\Exchange\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Specification 169: profile reset pure models and runner. Whole-file "#If Not NETFRAMEWORK". -->
  <ItemGroup>
    <Compile Include="..\..\src\ProfileReset\*.vb" Link="Linked\ProfileReset\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Context-help tests consume the shipped corpus as an explicit fixture, independent
       of the test output folder's depth (including SDK artifact isolation). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <None Include="..\..\docs\help\**\*" Link="help\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Each leg gets the SAME image decoder its viewer ships with, so the tests exercise
       the real decoder pair (specification 270): net48 = WIC + the committed libwebp
       decoder, laid out as the viewer's x86\ and x64\ folders (the test host is 64-bit,
       LegacyLibWebp loads by process bitness), net10 = Magick.NET. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <None Include="..\..\payload\libwebp\x86\libwebpdecoder.dll" Link="x86\libwebpdecoder.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\payload\libwebp\x64\libwebpdecoder.dll" Link="x64\libwebpdecoder.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\payload\libwebp\PROVENANCE.txt" Link="libwebp\PROVENANCE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <PackageReference Include="Magick.NET-Q8-x64" Version="15.0.0" />
    <!-- ArchiveSession reads through the very library the mainline ships with, so the
         archive tests exercise the shipping path rather than a stand-in. Modern leg
         only: the archive files compile to nothing on net48. -->
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <!-- The same cryptography library the mainline ships with, so the conformance run
         exercises the shipping code path rather than a stand-in. Modern leg only:
         src/Secure compiles to nothing on net48. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- Managed half only (no VideoLAN.LibVLC.Windows: the natives are not copied here). Used by
         LiveVlcMedia and the hand-run latency measurement of specification 023 phase 1, which load the
         libvlc of the built viewer by path when FMS_LIVE_LATENCY=1. -->
    <PackageReference Include="LibVLCSharp" Version="3.9.3" />
  </ItemGroup>

</Project>
