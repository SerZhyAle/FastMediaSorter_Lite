<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for viewer-unique pure logic (net48). The Share subsystem is covered
       by Companion.Tests (same ported code); this project targets code that lives
       ONLY in the viewer - currently Utils (array ops, contrast colour, and the header-only
       GetImageDimensions parser the background worker relies on). Source files are
       LINKED (not project-referenced) so the tests don't drag in the whole ILMerge/
       LibVLC/Tesseract viewer assembly. RootNamespace matches the viewer (fmsl) so the linked
       modules resolve by their real names. -->
  <PropertyGroup>
    <!-- Multi-targeted ON PURPOSE. The linked sources compile into BOTH shipped
         viewers (net48 x86 + the .NET 10 x64 mainline), so the same logic must be
         proven under BOTH runtimes - a net48-only run would have said nothing about
         the exe most users get. `dotnet test` runs every TFM listed here. -->
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>fmsl</RootNamespace>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <OptionCompare>Binary</OptionCompare>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- net48 leg: mirrors src/FastMediaSorter.vbproj. SDK-style projects targeting
       net48 do NOT define NETFRAMEWORK implicitly, and the linked sources are full
       of "#If NETFRAMEWORK" seams (CLAUDE.md "Two builds, one source tree") - without
       this the seam would compile its .NET 10 branch into a net48 run. WPF is only
       here because the legacy decoder reads WEBP through WIC. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <DefineConstants>NETFRAMEWORK=True,DOCUMENT_PREVIEW_TESTS=True</DefineConstants>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- ProtectedData lives in System.Security.dll on net48 (inbox on net10.0-windows): the
       linked DpapiSecrets needs it, and it comes along only because OcrTranslateSettings -
       the OCR code mapping the language-naming tests use - does. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <!-- The same project-level imports both viewer vbprojs declare. The linked sources
       are written against them (FileManager.vb says "Image", not
       "System.Drawing.Image"), so without these they do not compile here. -->
  <ItemGroup>
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.16" />
    <PackageReference Include="QRCoder" Version="1.4.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Link the production source directly (same assembly => Friend members visible). -->
    <Compile Include="..\..\src\Archives\ArchiveWriteManifest.vb" Link="Linked\Archives\ArchiveWriteManifest.vb" />
    <Compile Include="..\..\src\Archives\VerifiedZipWriter.vb" Link="Linked\Archives\VerifiedZipWriter.vb" />
    <Compile Include="..\..\src\Archives\ArchiveExtractionPlan.vb" Link="Linked\Archives\ArchiveExtractionPlan.vb" />
    <Compile Include="..\..\src\Archives\ArchiveExtractionReader.vb" Link="Linked\Archives\ArchiveExtractionReader.vb" />
    <Compile Include="..\..\src\FileManager\ManagerArchiveCommands.vb" Link="Linked\FileManager\ManagerArchiveCommands.vb" />
    <Compile Include="..\..\src\FileManager\ManagerArchiveForm.vb" Link="Linked\FileManager\ManagerArchiveForm.vb" />
    <Compile Include="..\..\src\FileManager\ManagerDestinationForm.vb" Link="Linked\FileManager\ManagerDestinationForm.vb" />
    <Compile Include="..\..\src\FileManager\ManagerExchangePlaces.vb" Link="Linked\FileManager\ManagerExchangePlaces.vb" />
    <Compile Include="..\..\src\FileManager\ManagerExchangeAccess.vb" Link="Linked\FileManager\ManagerExchangeAccess.vb" />
    <Compile Include="..\..\src\FileManager\ManagerTransferPreflight.vb" Link="Linked\FileManager\ManagerTransferPreflight.vb" />
    <Compile Include="..\..\src\Main_Form.WindowPinning.vb"><Link>Linked\Main_Form.WindowPinning.vb</Link></Compile>
    <Compile Include="..\..\src\SettingsUiContext.vb"><Link>Linked\SettingsUiContext.vb</Link></Compile>
    <Compile Include="..\..\src\Help\ContextHelp.vb"><Link>Linked\ContextHelp.vb</Link></Compile>
    <Compile Include="..\..\src\Help\ContextHelpUi.vb"><Link>Linked\ContextHelpUi.vb</Link></Compile>
    <EmbeddedResource Include="..\..\assets\exchange-mark\png\*.png"><LogicalName>FmsPayloadexchange-mark/png/%(Filename)%(Extension)</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\exchange-mark\svg\*.svg"><LogicalName>FmsPayloadexchange-mark/svg/%(Filename)%(Extension)</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\help-map.json"><LogicalName>help-map.json</LogicalName></EmbeddedResource>
    <Compile Include="..\..\src\SettingsCollapsibleGroup.vb"><Link>Linked\SettingsCollapsibleGroup.vb</Link></Compile>
