<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for LITE-unique pure logic (net48). The Share subsystem is covered
       by Companion.Tests (same ported code); this project targets code that lives
       ONLY in LITE - currently Utils (array ops, contrast colour, and the header-only
       GetImageDimensions parser the background worker relies on). Source files are
       LINKED (not project-referenced) so the tests don't drag in the whole ILMerge/
       LibVLC/Tesseract LITE assembly. RootNamespace matches LITE (fmsl) so the linked
       modules resolve by their real names. -->
  <PropertyGroup>
    <!-- Multi-targeted ON PURPOSE. The linked sources compile into BOTH shipped
         viewers (net48 x86 + the .NET 10 x64 mainline), so the same logic must be
         proven under BOTH runtimes - a net48-only run would have said nothing about
         the exe most users get. `dotnet test` runs every TFM listed here. -->
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>fmsl</RootNamespace>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <OptionCompare>Binary</OptionCompare>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- net48 leg: mirrors src/FastMediaSorter.vbproj. SDK-style projects targeting
       net48 do NOT define NETFRAMEWORK implicitly, and the linked sources are full
       of "#If NETFRAMEWORK" seams (CLAUDE.md "Two builds, one source tree") - without
       this the seam would compile its .NET 10 branch into a net48 run. WPF is only
       here because the legacy decoder reads WEBP through WIC. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <DefineConstants>NETFRAMEWORK=True</DefineConstants>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- ProtectedData lives in System.Security.dll on net48 (inbox on net10.0-windows): the
       linked DpapiSecrets needs it, and it comes along only because OcrTranslateSettings -
       the OCR code mapping the language-naming tests use - does. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Security" />
  </ItemGroup>

  <!-- The same project-level imports both viewer vbprojs declare. The linked sources
       are written against them (FileManager.vb says "Image", not
       "System.Drawing.Image"), so without these they do not compile here. -->
  <ItemGroup>
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Link the production source directly (same assembly => Friend members visible). -->
    <Compile Include="..\..\src\Utils.vb">
      <Link>Linked\Utils.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Icons\IconMap.vb">
      <Link>Linked\Icons\IconMap.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Icons\SvgPathData.vb">
      <Link>Linked\Icons\SvgPathData.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Icons\GlyphRenderer.vb">
      <Link>Linked\Icons\GlyphRenderer.vb</Link>
    </Compile>
    <!-- Utils.GetImageDimensions probes WEBP through the IImageDecoder seam, so the
         seam has to come along. The modern decoder file compiles to nothing here
         (its whole body is "#If Not NETFRAMEWORK"), and the legacy one is the WIC +
         ImageSharp 2 path the net48 viewer really uses. -->
    <Compile Include="..\..\src\Imaging\ImageDecoder.vb">
      <Link>Linked\Imaging\ImageDecoder.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Imaging\LegacyWicImageDecoder.vb">
      <Link>Linked\Imaging\LegacyWicImageDecoder.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Imaging\ModernImageSharpDecoder.vb">
      <Link>Linked\Imaging\ModernImageSharpDecoder.vb</Link>
    </Compile>
    <!-- The writing half of the seam (SPECIFICATION_IMAGE_EDITOR_DOTNET10.md §9). This is
         the dangerous half of the editor - it writes over the user's originals - and it is
         deliberately UI-free so exactly that can be proven here. All three are whole-file
         "#If Not NETFRAMEWORK", so on the net48 leg they and their tests compile to
         nothing, matching the shipped shape. -->
    <Compile Include="..\..\src\Imaging\ImageEncoder.vb">
      <Link>Linked\Imaging\ImageEncoder.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Imaging\ModernImageSharpEncoder.vb">
      <Link>Linked\Imaging\ModernImageSharpEncoder.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Imaging\ImageFileWriter.vb">
      <Link>Linked\Imaging\ImageFileWriter.vb</Link>
    </Compile>
    <!-- The one place Magick's resource limits are set (audit 052 G-20): a disk limit of
         zero, so a decrypted picture never spills into a %TEMP% pixel cache. -->
    <Compile Include="..\..\src\Imaging\MagickResourceLimits.vb">
      <Link>Linked\Imaging\MagickResourceLimits.vb</Link>
    </Compile>
    <!-- The decode cache (SPECIFICATION_DECODE_CACHE_AND_ANIMATION_TO_VIDEO_DOTNET10.md
         §3-§7). Linked because the whole feature rests on ONE discipline - a key that
         changes whenever the answer does - and on a store that must turn every kind of
         damaged entry into a plain miss. Neither is provable by looking at a picture: a
         stale hit shows a perfectly good image, just the wrong one. All five are
         whole-file "#If Not NETFRAMEWORK", so they and their tests compile to nothing on
         the net48 leg, matching the shipped shape. They pull in nothing new - AppPaths and
         DiskCacheTrim are already here. -->
    <Compile Include="..\..\src\Imaging\ImageDecodePayload.vb">
      <Link>Linked\Imaging\ImageDecodePayload.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Imaging\DecodeCacheKey.vb">
      <Link>Linked\Imaging\DecodeCacheKey.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Imaging\DecodeCachePolicy.vb">
      <Link>Linked\Imaging\DecodeCachePolicy.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Imaging\DecodeCacheStore.vb">
      <Link>Linked\Imaging\DecodeCacheStore.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Imaging\DecodeCache.vb">
      <Link>Linked\Imaging\DecodeCache.vb</Link>
    </Compile>
    <!-- "Replace with video" (same specification, §9-§10). Only the PURE half is linked:
         AnimationToVideo spawns a process and Main_Form.ToVideo owns the window, and keeping
         both out is exactly what lets the two dangerous questions be answered here without
         FFmpeg and without a real photo - what the encoder is asked to do, and when the
         ORIGINAL may be deleted. Whole-file "#If Not NETFRAMEWORK", so this and its tests
         compile to nothing on the net48 leg. It needs ImageFileWriter (already above) for the
         shared temp-name marker. -->
    <Compile Include="..\..\src\Video\VideoConvertPlan.vb">
      <Link>Linked\Video\VideoConvertPlan.vb</Link>
    </Compile>
    <!-- The zoom geometry of the .NET 10 viewer. Whole-file "#If Not NETFRAMEWORK",
         so on the net48 leg this - and ZoomMathTests - compile to nothing, which is
         the honest shape: the classic zoom model does not exist in the x86 viewer. -->
    <Compile Include="..\..\src\ZoomMath.vb">
      <Link>Linked\ZoomMath.vb</Link>
    </Compile>
    <!-- Window geometry (APP-BEHAVIOUR rule 10, ticket 028 Ф-2): which rectangle to
         remember and where a remembered one goes when its monitor is gone. Pure, and
         whole-file "#If Not NETFRAMEWORK" like ZoomMath. -->
    <Compile Include="..\..\src\WindowPlacement.vb">
      <Link>Linked\WindowPlacement.vb</Link>
    </Compile>
    <!-- The application theme's pure half (spec 060, APP-STYLE rules 2-4): the mode codec,
         its resolution and the one palette table. Whole-file "#If Not NETFRAMEWORK". -->
    <Compile Include="..\..\src\Theming\ThemePalette.vb">
      <Link>Linked\Theming\ThemePalette.vb</Link>
    </Compile>
    <!-- Failure cause from the exception's type (APP-BEHAVIOUR rule 6, ticket 028 Ф-3).
         Both legs: net48 keeps the raw text, net10 names a cause. -->
    <Compile Include="..\..\src\FailureText.vb">
      <Link>Linked\FailureText.vb</Link>
    </Compile>
    <!-- Where the editor lays the picture on its canvas. Built on ZoomMath.FitFactor
         above, and kept out of the editor window for the same reason ZoomMath is kept
         out of Main_Form.Zoom.vb: it is a pure function, and every stroke the editor
         will ever draw is placed relative to what it returns. -->
    <Compile Include="..\..\src\EditorGeometry.vb">
      <Link>Linked\EditorGeometry.vb</Link>
    </Compile>
    <!-- The crop itself (Ф-4). Outside the window for the same reason: "the kept pixels
         arrive unchanged, at the right offset" is exact and checkable, while an off-by-one
         or a quietly resampled crop looks perfectly right on a canvas scaled to a fifth of
         the picture and is found later, in the saved file. -->
    <Compile Include="..\..\src\EditorImageOps.vb">
      <Link>Linked\EditorImageOps.vb</Link>
    </Compile>
    <!-- The editor's undo history. Here rather than in the window because its whole
         reason to exist is a budget: twenty snapshots of a 6000x4000 photo are 1.9 GB,
         and "does it really evict" is a question for a test with small pictures and a
         small budget, not for a person watching Task Manager. -->
    <Compile Include="..\..\src\EditorUndoStack.vb">
      <Link>Linked\EditorUndoStack.vb</Link>
    </Compile>
    <!-- "Open URL.." address handling - modern-only for the same reason. -->
    <Compile Include="..\..\src\MediaUrl.vb">
      <Link>Linked\MediaUrl.vb</Link>
    </Compile>
    <!-- Audit 050. RuntimeInstallPlan is the disk half of the runtime installer (staging,
         the .complete marker, entry containment, the pinned digests) and is shared, so
         both legs prove it. PlaybackRules (repeat, the track cycle, the sleep deadline) is
         whole-file "#If Not NETFRAMEWORK", like the LibVLC paths that use it. -->
    <Compile Include="..\..\src\RuntimeInstallPlan.vb">
      <Link>Linked\RuntimeInstallPlan.vb</Link>
    </Compile>
    <Compile Include="..\..\src\PlaybackRules.vb">
      <Link>Linked\PlaybackRules.vb</Link>
    </Compile>
    <!-- The custom-shortcut model (SPECIFICATION_SETTINGS_EXPANSION.md §3.5). Here rather
         than in the dialog because everything that can go wrong with a remapping is a
         rule about strings: which combinations may be assigned, who already owns one, and
         whether the key an action was moved OFF still does its old job. Whole-file
         "#If Not NETFRAMEWORK", so it and its tests compile to nothing on the net48 leg. -->
    <Compile Include="..\..\src\CustomHotkeys.vb">
      <Link>Linked\CustomHotkeys.vb</Link>
    </Compile>
    <!-- File operations. RenameFile is where "photo2.jpg" once landed on disk as
         "photo2.jpg.jpg" while the viewer recorded the name it had asked for - the
         file then dropped out of the list, so this contract is worth pinning down.
         It brings no new dependencies: the decoder seam, the logger and
         Common_Module are all here already. -->
    <Compile Include="..\..\src\FileManager.vb">
      <Link>Linked\FileManager.vb</Link>
    </Compile>
    <!-- The x86 video page's one value from outside - the file name - encoded for its
         attribute (audit 046 D-06). Whole-file "#If NETFRAMEWORK": it and its test run
         on the net48 leg only, which is the shipped shape. -->
    <Compile Include="..\..\src\WebVideoMarkup.vb">
      <Link>Linked\WebVideoMarkup.vb</Link>
    </Compile>
    <!-- Tail of that dependency: the legacy decoder logs a failed WEBP decode (this
         is the log line the Server 2025 bug was diagnosed from - worth keeping), and
         the logger reads two name constants from Common_Module. Both are small leaf
         modules - declarations and P/Invoke - so this still does not drag in the
         LibVLC/Tesseract/ILMerge machinery the project comment warns about. -->
    <Compile Include="..\..\src\AppFileLogger.vb">
      <Link>Linked\AppFileLogger.vb</Link>
    </Compile>
    <Compile Include="..\..\src\MultiWindowPolicy.vb">
      <Link>Linked\MultiWindowPolicy.vb</Link>
    </Compile>
    <!-- The WM_COPYDATA hand-off rules between the viewer processes (053 F-03/F-06/F-07). -->
    <Compile Include="..\..\src\SingleInstanceProtocol.vb">
      <Link>Linked\SingleInstanceProtocol.vb</Link>
    </Compile>
    <!-- The .NET 10 preference block. Linked for the resume option
         (SPECIFICATION_RESUME_LAST_PLAYBACK_DOTNET10 §8.1): "off unless asked for" is
         exactly the kind of default that is easy to get wrong and impossible to notice.
         Whole-file "#If Not NETFRAMEWORK", so it and its tests compile to nothing on the
         net48 leg, and it needs nothing new - Common_Module and MultiWindowPolicy above
         are its only dependencies. -->
    <Compile Include="..\..\src\ModernViewerPreferences.vb">
      <Link>Linked\ModernViewerPreferences.vb</Link>
    </Compile>
    <Compile Include="..\..\src\AudioMetadata.vb">
      <Link>Linked\AudioMetadata.vb</Link>
    </Compile>
    <!-- Where the app keeps state on disk, and the archive cache built on it. The two
         Archives files are whole-file "#If Not NETFRAMEWORK", so they and their tests
         compile to nothing on the net48 leg - the honest shape, since archive browsing
         does not exist in the x86 viewer. They pull in nothing new: AppFileLogger and
         Common_Module are already here, and no archive library is needed to prove the
         naming rule or the orphan sweep. -->
    <Compile Include="..\..\src\AppPaths.vb">
      <Link>Linked\AppPaths.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Archives\ArchivePaths.vb">
      <Link>Linked\Archives\ArchivePaths.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Archives\ArchiveTempStore.vb">
      <Link>Linked\Archives\ArchiveTempStore.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Archives\ArchiveEntryFilter.vb">
      <Link>Linked\Archives\ArchiveEntryFilter.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Archives\ArchiveSession.vb">
      <Link>Linked\Archives\ArchiveSession.vb</Link>
    </Compile>
    <!-- The provider layer (006_SPECIFICATION_FILESYSTEM_PROVIDER_LAYER_DOTNET10.md).
         FileManager's verbs ask ResourceRouting first, so linking FileManager needs these;
         all whole-file "#If Not NETFRAMEWORK", like the feature, and built on the archive
         cache files just above. -->
    <Compile Include="..\..\src\Resources\IFileSystemProvider.vb">
      <Link>Linked\Resources\IFileSystemProvider.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Resources\LocalProvider.vb">
      <Link>Linked\Resources\LocalProvider.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Resources\RemoteCachePaths.vb">
      <Link>Linked\Resources\RemoteCachePaths.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Resources\RemoteCacheStore.vb">
      <Link>Linked\Resources\RemoteCacheStore.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Resources\ResourceRegistry.vb">
      <Link>Linked\Resources\ResourceRegistry.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Resources\ResourceSession.vb">
      <Link>Linked\Resources\ResourceSession.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Resources\ResourceTransfer.vb">
      <Link>Linked\Resources\ResourceTransfer.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Resources\ResourceRouting.vb">
      <Link>Linked\Resources\ResourceRouting.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Common_Module.vb">
      <Link>Linked\Common_Module.vb</Link>
    </Compile>
    <!-- The log package behind Settings -> About -> "send the logs to the author".
         Whole-file "#If Not NETFRAMEWORK", so on the net48 leg this - and
         LogPackageTests - compile to nothing, matching the shipped shape. -->
    <Compile Include="..\..\src\Support\LogPackage.vb">
      <Link>Linked\Support\LogPackage.vb</Link>
    </Compile>
    <!-- Common_Module.Author_Email is MailSender.AuthorAddress (ticket 028 Ф-3: the
         Share Manager links MailSender and writes to the same address). -->
    <Compile Include="..\..\src\Support\MailSender.vb">
      <Link>Linked\Support\MailSender.vb</Link>
    </Compile>
    <!-- Site page URLs (ticket 037): TrustPageContractTests holds every language's
         trust link to a page that exists in the repository. -->
    <Compile Include="..\..\src\Support\SitePages.vb">
      <Link>Linked\Support\SitePages.vb</Link>
    </Compile>
    <!-- The 13-language localization layer. Linked whole, tables included: the parity
         test's whole job is to look at the real shipped table, and running it on BOTH
         legs also proves the #If NETFRAMEWORK seam cuts Codes to RU+EN on net48 while
         leaving the string tables shared. -->
    <Compile Include="..\..\src\Localization\*.vb">
      <Link>Linked\Localization\%(Filename)%(Extension)</Link>
    </Compile>
    <!-- Long-run stability (SPECIFICATION_LONG_RUN_STABILITY.md). All three are leaf
         modules with no WinForms dependency, which is exactly why the logic lives in
         them rather than inside Main_Form:
           AutoSkipPolicy  - the chain bound whose old form was also the recursion depth,
                             so a dropped share crashed the process (A-2).
           DiskCacheTrim   - the eviction the OCR and browser-translate caches never had,
                             and the budget the settings window displayed but nobody
                             enforced (D-1, D-3).
           FileOpQueue     - modern-only (whole-file "#If Not NETFRAMEWORK"), so on the
                             net48 leg this and its tests compile to nothing. Its
                             post-drain refusal used to be silent while the UI reported
                             success (B-2). -->
    <Compile Include="..\..\src\AutoSkipPolicy.vb">
      <Link>Linked\AutoSkipPolicy.vb</Link>
    </Compile>
    <!-- Ticket 047: the rename-name rule, the list stamp, and the input guards (the
         Ctrl/Alt gate, auto-repeat, the wheel accumulator, the overlay double-click).
         Shared, so both legs prove them. -->
    <Compile Include="..\..\src\FileOpRules.vb">
      <Link>Linked\FileOpRules.vb</Link>
    </Compile>
    <Compile Include="..\..\src\InputGuards.vb">
      <Link>Linked\InputGuards.vb</Link>
    </Compile>
    <!-- Ticket 049 B-10: the monotonic throttle clock. Shared, so both legs prove it. -->
    <Compile Include="..\..\src\MonotonicClock.vb">
      <Link>Linked\MonotonicClock.vb</Link>
    </Compile>
    <!-- Ticket 048: the pure navigation/decode rules (slideshow order, prefetch acceptance,
         extension keys, decode budget). Shared, so both legs prove them. -->
    <Compile Include="..\..\src\SlideshowOrder.vb">
      <Link>Linked\SlideshowOrder.vb</Link>
    </Compile>
    <Compile Include="..\..\src\NavigationRules.vb">
      <Link>Linked\NavigationRules.vb</Link>
    </Compile>
    <Compile Include="..\..\src\FolderScan.vb">
      <Link>Linked\FolderScan.vb</Link>
    </Compile>
    <!-- Ticket 086 (audit 057 S01-6): the display path's in-flight decode registry - join,
         never duplicate, one owner per result. Pure, both legs. -->
    <Compile Include="..\..\src\InFlightDecodeRegistry.vb">
      <Link>Linked\InFlightDecodeRegistry.vb</Link>
    </Compile>
    <!-- The classifier that decides whether a read failure is about the FILE (drop it from
         the list, as always) or about everything between us and it (keep it - a dropped SMB
         session used to shred a healthy folder one file per keypress). It is here rather
         than inside Main_Form precisely because the decision hangs on exception DERIVATION -
         FileNotFoundException is an IOException and UnauthorizedAccessException is not - and
         that is a question for a test, not for whoever edits the Select Case next. Compiled
         on both legs: the enum is shared, only the behaviour is fenced. -->
    <Compile Include="..\..\src\PathFailure.vb">
      <Link>Linked\PathFailure.vb</Link>
    </Compile>
    <!-- The cache policy behind "a dead slot costs one probe, not twenty SMB timeouts"
         (SLOT_HEALTH Ф2, invariant 5). Linked because the promise is entirely about a
         clock: the scene it replaces is "put the NAS to sleep and press 3 twenty times",
         and handing the policy the time turns that into arithmetic. The probe itself -
         the half that touches the network - stays in Main_Form.SlotHealth.vb and is
         deliberately not here. Whole-file "#If Not NETFRAMEWORK", so it and its tests
         compile to nothing on the net48 leg. -->
    <Compile Include="..\..\src\SlotHealth.vb">
      <Link>Linked\SlotHealth.vb</Link>
    </Compile>
    <!-- Whether a deletion can go to the Recycle Bin, and - when it cannot - why. Only the
         PURE half is linked: DeleteVolumeProbe reads the registry and DriveInfo, and keeping
         it out of this file is exactly what lets the rule matrix be proven without a NAS and
         a USB stick. Whole-file "#If Not NETFRAMEWORK", so this and DeletePolicyTests compile
         to nothing on the net48 leg - the honest shape, since the x86 viewer's DEL is still a
         bare File.Delete. -->
    <Compile Include="..\..\src\DeletePolicy.vb">
      <Link>Linked\DeletePolicy.vb</Link>
    </Compile>
    <!-- The other pure half of the same feature: what the Recycle Bin's own $I record says,
         and which record belongs to the deletion U is taking back. Linked for the same
         reason - the impure half (RecycleBinIo) enumerates a per-user, per-volume system
         folder, and pinning "an unknown record version is REFUSED, never guessed at" must
         not require deleting a real file first. Whole-file "#If Not NETFRAMEWORK". -->
    <Compile Include="..\..\src\RecycleBinIndex.vb">
      <Link>Linked\RecycleBinIndex.vb</Link>
    </Compile>
    <!-- The history behind U, and the table saying what U can promise. FileOpKind left
         Main_Form precisely so this could be tested: the rule "an undo is never itself
         undoable" has to hold for kinds nobody has written yet, and a Select Case inside a
         form is not where that gets noticed. UndoStack.vb is modern-only; FileOpKind.vb is
         shared and compiles on both legs, like the enum in the shipped x86 viewer. -->
    <Compile Include="..\..\src\FileOpKind.vb">
      <Link>Linked\FileOpKind.vb</Link>
    </Compile>
    <Compile Include="..\..\src\UndoStack.vb">
      <Link>Linked\UndoStack.vb</Link>
    </Compile>
    <Compile Include="..\..\src\DiskCacheTrim.vb">
      <Link>Linked\DiskCacheTrim.vb</Link>
    </Compile>
    <Compile Include="..\..\src\FileOpQueue.vb">
      <Link>Linked\FileOpQueue.vb</Link>
    </Compile>
    <!-- OCR overlay accuracy (SPECIFICATION_OCR_OVERLAY_ACCURACY.md). Pure logic, kept
         out of Main_Form exactly so it can be proven here: line clustering, the
         translatability filter and the font/growth ladder are all decisions a user would
         otherwise have to catch by eye on a comic page. OcrModels carries the data shapes
         they operate on (and OcrPipelineVersion, the cache key's guard against a stale
         document built by the previous algorithm). None of them pulls in Tesseract or
         WinForms - that is the point of the split. -->
    <Compile Include="..\..\src\Ocr\OcrModels.vb">
      <Link>Linked\Ocr\OcrModels.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Ocr\OcrBlockBuilder.vb">
      <Link>Linked\Ocr\OcrBlockBuilder.vb</Link>
    </Compile>
    <!-- The stitched-line split (S7). Linked for the same reason as the clustering it runs in
         front of: it is pure geometry over the recognizer's output, and its whole argument is
         a measured ratio - the kind of thing that has to be checked against real word boxes,
         not judged by eye on a comic page. It needs no Tesseract: the fixtures in
         OcrLineSplitterTests are the engine's own output, recorded. -->
    <Compile Include="..\..\src\Ocr\OcrLineSplitter.vb">
      <Link>Linked\Ocr\OcrLineSplitter.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Ocr\OcrOverlayFit.vb">
      <Link>Linked\Ocr\OcrOverlayFit.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Ocr\OcrTextFilter.vb">
      <Link>Linked\Ocr\OcrTextFilter.vb</Link>
    </Compile>
    <!-- The refusal of OCR-OVERLAY rule 10: an ASSUMED source language that the run's own
         discard record says could not read the page produces no overlay and a message naming
         the fix. Pure - it reads the record rule 12 already writes and needs no engine - which
         is the whole reason it is a module and not three lines inside the pipeline. -->
    <Compile Include="..\..\src\Ocr\OcrLanguageGuard.vb">
      <Link>Linked\Ocr\OcrLanguageGuard.vb</Link>
    </Compile>
    <!-- Whole-file "#If Not NETFRAMEWORK", so this and OcrPlateColorsTests compile to
         nothing on the net48 leg - the honest shape: sampled plate colours are a mainline
         improvement the x86 fallback does not get. -->
    <Compile Include="..\..\src\Ocr\OcrPlateColors.vb">
      <Link>Linked\Ocr\OcrPlateColors.vb</Link>
    </Compile>
    <!-- Audit 051 and ticket 033. Every decision here either throws text away, keeps a
         failure, or files a result under a key - none of which shows on screen as anything
         but a plausible-looking overlay, so each is held by a test:
           ITranslator          - the per-segment result, language names, the punctuation
                                  whitelist that lost its curly quotes (E-10), RTL (E-11)
                                  and LibreTranslate's codes (E-13);
           TranslationQuality   - what counts as a refusal or an acceptable echo (E-03);
           OcrResultPolicy      - the cache key with the displayed grid (E-01) and "only a
                                  complete translation is cached" (E-02);
           OcrImageScale        - a tall strip keeps readable lettering (E-05) and buffers
                                  are built only when asked for (E-08);
           OcrDiagnostics       - rule 14's null-versus-empty and rule 17's "changes
                                  nothing" (033 Ф-8). Whole-file modern-only, so it and its
                                  tests compile to nothing on the net48 leg;
           DocHtmlTranslateLauncher - the OCR-INVOCATION command line (033 Ф-7);
           OcrLanguageCatalog (+ RuntimeBootstrap for its flag loader, OcrTranslateSettings
                                  and DpapiSecrets for the code mapping) - every target and
                                  UI language has a name (E-06), and a missing pack is
                                  named (033 Ф-6). -->
    <Compile Include="..\..\src\Translate\ITranslator.vb">
      <Link>Linked\Translate\ITranslator.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Translate\TranslationQuality.vb">
      <Link>Linked\Translate\TranslationQuality.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Translate\OcrResultPolicy.vb">
      <Link>Linked\Translate\OcrResultPolicy.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Ocr\OcrImageScale.vb">
      <Link>Linked\Ocr\OcrImageScale.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Ocr\OcrDiagnostics.vb">
      <Link>Linked\Ocr\OcrDiagnostics.vb</Link>
    </Compile>
    <Compile Include="..\..\src\DocHtmlTranslateLauncher.vb">
      <Link>Linked\DocHtmlTranslateLauncher.vb</Link>
    </Compile>
    <Compile Include="..\..\src\OcrLanguageCatalog.vb">
      <Link>Linked\OcrLanguageCatalog.vb</Link>
    </Compile>
    <Compile Include="..\..\src\RuntimeBootstrap.vb">
      <Link>Linked\RuntimeBootstrap.vb</Link>
    </Compile>
    <Compile Include="..\..\src\OcrTranslateSettings.vb">
      <Link>Linked\OcrTranslateSettings.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Security\DpapiSecrets.vb">
      <Link>Linked\Security\DpapiSecrets.vb</Link>
    </Compile>
    <!-- Secure containers (026_SPECIFICATION_SECURE_CONTAINER_FD_SEC_DOTNET10.md §13).
         This is the one subsystem in the repository where being ALMOST right produces a
         reader that opens nothing anyone else made and says nothing useful about why -
         so the whole of src/Secure is linked and run against the catalog's committed
         vectors. All eight are whole-file "#If Not NETFRAMEWORK", so they and their
         tests compile to nothing on the net48 leg, which is the shipped shape. -->
    <Compile Include="..\..\src\Secure\FdSecOutcome.vb">
      <Link>Linked\Secure\FdSecOutcome.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Secure\FdSecPrimitives.vb">
      <Link>Linked\Secure\FdSecPrimitives.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Secure\FdSecKdf.vb">
      <Link>Linked\Secure\FdSecKdf.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Secure\FdSecHead.vb">
      <Link>Linked\Secure\FdSecHead.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Secure\FdSecMetadata.vb">
      <Link>Linked\Secure\FdSecMetadata.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Secure\FdSecScreen.vb">
      <Link>Linked\Secure\FdSecScreen.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Secure\FdSecContainer.vb">
      <Link>Linked\Secure\FdSecContainer.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Secure\FdSecStream.vb">
      <Link>Linked\Secure\FdSecStream.vb</Link>
    </Compile>
    <!-- The outcome-to-words map, outside the form precisely so "three classes, three
         messages, never merged" is something a test can hold it to. -->
    <Compile Include="..\..\src\SecureMessages.vb">
      <Link>Linked\SecureMessages.vb</Link>
    </Compile>
    <!-- The pure decisions of the viewer's container side (audit 052 G-07, G-10, G-13):
         when to ask for a password, which name a failure may show, whether a translator
         endpoint stays on this machine. Whole-file "#If Not NETFRAMEWORK". -->
    <Compile Include="..\..\src\SecurePolicy.vb">
      <Link>Linked\SecurePolicy.vb</Link>
    </Compile>
    <!-- What a secure playback may delete from LibVLC's art cache (audit 046 G-04). The
         planning half is pure and deletes files, so its narrowness is held by a test.
         Whole-file "#If Not NETFRAMEWORK". -->
    <Compile Include="..\..\src\VlcArtCache.vb">
      <Link>Linked\VlcArtCache.vb</Link>
    </Compile>
    <!-- The one classifier. A container is its own kind until it opens, and its sealed
         TRUE name then goes through this same function - so there is one answer to "what
         kind of file is this" and not two. Whole-file "#If Not NETFRAMEWORK". -->
    <Compile Include="..\..\src\MediaKind.vb">
      <Link>Linked\MediaKind.vb</Link>
    </Compile>
  </ItemGroup>

  <!-- The catalog's conformance vectors, vendored as ARTIFACTS beside a PROVENANCE.txt
       that names the contract, its version, the date taken and each file's SHA-256 - the
       tests check those digests before trusting a byte. A test that depends on a drive
       letter cannot run for anyone else, which is why they travel with the suite; the
       documents themselves stay in the catalog and are only cited. -->
  <ItemGroup>
    <None Include="TestData\fdsec-vectors\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>TestData\fdsec-vectors\%(Filename)%(Extension)</Link>
    </None>
    <None Include="TestData\icon-vocabulary\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>TestData\icon-vocabulary\%(Filename)%(Extension)</Link>
    </None>
    <None Include="..\..\assets\glyphs\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>TestData\glyphs\%(Filename)%(Extension)</Link>
    </None>
    <None Include="..\..\assets\glyphs\PROVENANCE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>TestData\glyphs\PROVENANCE.txt</Link>
    </None>
  </ItemGroup>

  <!-- Each leg gets the SAME ImageSharp its viewer ships with, so the tests exercise
       the real decoder pair: net48 = WIC + ImageSharp 2 fallback, net10 = ImageSharp 3
       (the one that decodes animated WEBP with no OS codec). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <!-- ModernImageSharpDecoder uses Magick.NET for AVIF/HEIC/HEIF fallback. -->
    <PackageReference Include="Magick.NET-Q8-x64" Version="14.15.0" />
    <!-- ArchiveSession reads through the very library the mainline ships with, so the
         archive tests exercise the shipping path rather than a stand-in. Modern leg
         only: the archive files compile to nothing on net48. -->
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <!-- The same cryptography library the mainline ships with, so the conformance run
         exercises the shipping code path rather than a stand-in. Modern leg only:
         src/Secure compiles to nothing on net48. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>

</Project>
