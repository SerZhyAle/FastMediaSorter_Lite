<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for LITE-unique pure logic (net48). The Share subsystem is covered
       by Companion.Tests (same ported code); this project targets code that lives
       ONLY in LITE - currently Utils (array ops, contrast colour, and the header-only
       GetImageDimensions parser the background worker relies on). Source files are
       LINKED (not project-referenced) so the tests don't drag in the whole ILMerge/
       LibVLC/Tesseract LITE assembly. RootNamespace matches LITE (fmsl) so the linked
       modules resolve by their real names. -->
  <PropertyGroup>
    <!-- Multi-targeted ON PURPOSE. The linked sources compile into BOTH shipped
         viewers (net48 x86 + the .NET 10 x64 mainline), so the same logic must be
         proven under BOTH runtimes - a net48-only run would have said nothing about
         the exe most users get. `dotnet test` runs every TFM listed here. -->
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>fmsl</RootNamespace>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <OptionCompare>Binary</OptionCompare>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- net48 leg: mirrors src/FastMediaSorter.vbproj. SDK-style projects targeting
       net48 do NOT define NETFRAMEWORK implicitly, and the linked sources are full
       of "#If NETFRAMEWORK" seams (CLAUDE.md "Two builds, one source tree") - without
       this the seam would compile its .NET 10 branch into a net48 run. WPF is only
       here because the legacy decoder reads WEBP through WIC. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <DefineConstants>NETFRAMEWORK=True</DefineConstants>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- The same project-level imports both viewer vbprojs declare. The linked sources
       are written against them (FileManager.vb says "Image", not
       "System.Drawing.Image"), so without these they do not compile here. -->
  <ItemGroup>
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Link the production source directly (same assembly => Friend members visible). -->
    <Compile Include="..\..\src\Utils.vb">
      <Link>Linked\Utils.vb</Link>
    </Compile>
    <!-- Utils.GetImageDimensions probes WEBP through the IImageDecoder seam, so the
         seam has to come along. The modern decoder file compiles to nothing here
         (its whole body is "#If Not NETFRAMEWORK"), and the legacy one is the WIC +
         ImageSharp 2 path the net48 viewer really uses. -->
    <Compile Include="..\..\src\Imaging\ImageDecoder.vb">
      <Link>Linked\Imaging\ImageDecoder.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Imaging\LegacyWicImageDecoder.vb">
      <Link>Linked\Imaging\LegacyWicImageDecoder.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Imaging\ModernImageSharpDecoder.vb">
      <Link>Linked\Imaging\ModernImageSharpDecoder.vb</Link>
    </Compile>
    <!-- The writing half of the seam (SPECIFICATION_IMAGE_EDITOR_DOTNET10.md §9). This is
         the dangerous half of the editor - it writes over the user's originals - and it is
         deliberately UI-free so exactly that can be proven here. All three are whole-file
         "#If Not NETFRAMEWORK", so on the net48 leg they and their tests compile to
         nothing, matching the shipped shape. -->
    <Compile Include="..\..\src\Imaging\ImageEncoder.vb">
      <Link>Linked\Imaging\ImageEncoder.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Imaging\ModernImageSharpEncoder.vb">
      <Link>Linked\Imaging\ModernImageSharpEncoder.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Imaging\ImageFileWriter.vb">
      <Link>Linked\Imaging\ImageFileWriter.vb</Link>
    </Compile>
    <!-- The zoom geometry of the .NET 10 viewer. Whole-file "#If Not NETFRAMEWORK",
         so on the net48 leg this - and ZoomMathTests - compile to nothing, which is
         the honest shape: the classic zoom model does not exist in the x86 viewer. -->
    <Compile Include="..\..\src\ZoomMath.vb">
      <Link>Linked\ZoomMath.vb</Link>
    </Compile>
    <!-- Where the editor lays the picture on its canvas. Built on ZoomMath.FitFactor
         above, and kept out of the editor window for the same reason ZoomMath is kept
         out of Main_Form.Zoom.vb: it is a pure function, and every stroke the editor
         will ever draw is placed relative to what it returns. -->
    <Compile Include="..\..\src\EditorGeometry.vb">
      <Link>Linked\EditorGeometry.vb</Link>
    </Compile>
    <!-- The crop itself (Ф-4). Outside the window for the same reason: "the kept pixels
         arrive unchanged, at the right offset" is exact and checkable, while an off-by-one
         or a quietly resampled crop looks perfectly right on a canvas scaled to a fifth of
         the picture and is found later, in the saved file. -->
    <Compile Include="..\..\src\EditorImageOps.vb">
      <Link>Linked\EditorImageOps.vb</Link>
    </Compile>
    <!-- The editor's undo history. Here rather than in the window because its whole
         reason to exist is a budget: twenty snapshots of a 6000x4000 photo are 1.9 GB,
         and "does it really evict" is a question for a test with small pictures and a
         small budget, not for a person watching Task Manager. -->
    <Compile Include="..\..\src\EditorUndoStack.vb">
      <Link>Linked\EditorUndoStack.vb</Link>
    </Compile>
    <!-- "Open URL.." address handling - modern-only for the same reason. -->
    <Compile Include="..\..\src\MediaUrl.vb">
      <Link>Linked\MediaUrl.vb</Link>
    </Compile>
    <!-- The custom-shortcut model (SPECIFICATION_SETTINGS_EXPANSION.md §3.5). Here rather
         than in the dialog because everything that can go wrong with a remapping is a
         rule about strings: which combinations may be assigned, who already owns one, and
         whether the key an action was moved OFF still does its old job. Whole-file
         "#If Not NETFRAMEWORK", so it and its tests compile to nothing on the net48 leg. -->
    <Compile Include="..\..\src\CustomHotkeys.vb">
      <Link>Linked\CustomHotkeys.vb</Link>
    </Compile>
    <!-- File operations. RenameFile is where "photo2.jpg" once landed on disk as
         "photo2.jpg.jpg" while the viewer recorded the name it had asked for - the
         file then dropped out of the list, so this contract is worth pinning down.
         It brings no new dependencies: the decoder seam, the logger and
         Common_Module are all here already. -->
    <Compile Include="..\..\src\FileManager.vb">
      <Link>Linked\FileManager.vb</Link>
    </Compile>
    <!-- Tail of that dependency: the legacy decoder logs a failed WEBP decode (this
         is the log line the Server 2025 bug was diagnosed from - worth keeping), and
         the logger reads two name constants from Common_Module. Both are small leaf
         modules - declarations and P/Invoke - so this still does not drag in the
         LibVLC/Tesseract/ILMerge machinery the project comment warns about. -->
    <Compile Include="..\..\src\AppFileLogger.vb">
      <Link>Linked\AppFileLogger.vb</Link>
    </Compile>
    <Compile Include="..\..\src\MultiWindowPolicy.vb">
      <Link>Linked\MultiWindowPolicy.vb</Link>
    </Compile>
    <!-- The .NET 10 preference block. Linked for the resume option
         (SPECIFICATION_RESUME_LAST_PLAYBACK_DOTNET10 §8.1): "off unless asked for" is
         exactly the kind of default that is easy to get wrong and impossible to notice.
         Whole-file "#If Not NETFRAMEWORK", so it and its tests compile to nothing on the
         net48 leg, and it needs nothing new - Common_Module and MultiWindowPolicy above
         are its only dependencies. -->
    <Compile Include="..\..\src\ModernViewerPreferences.vb">
      <Link>Linked\ModernViewerPreferences.vb</Link>
    </Compile>
    <!-- Where the app keeps state on disk, and the archive cache built on it. The two
         Archives files are whole-file "#If Not NETFRAMEWORK", so they and their tests
         compile to nothing on the net48 leg - the honest shape, since archive browsing
         does not exist in the x86 viewer. They pull in nothing new: AppFileLogger and
         Common_Module are already here, and no archive library is needed to prove the
         naming rule or the orphan sweep. -->
    <Compile Include="..\..\src\AppPaths.vb">
      <Link>Linked\AppPaths.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Archives\ArchivePaths.vb">
      <Link>Linked\Archives\ArchivePaths.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Archives\ArchiveTempStore.vb">
      <Link>Linked\Archives\ArchiveTempStore.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Archives\ArchiveEntryFilter.vb">
      <Link>Linked\Archives\ArchiveEntryFilter.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Archives\ArchiveSession.vb">
      <Link>Linked\Archives\ArchiveSession.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Common_Module.vb">
      <Link>Linked\Common_Module.vb</Link>
    </Compile>
    <!-- The log package behind Settings -> About -> "send the logs to the author".
         Whole-file "#If Not NETFRAMEWORK", so on the net48 leg this - and
         LogPackageTests - compile to nothing, matching the shipped shape. -->
    <Compile Include="..\..\src\Support\LogPackage.vb">
      <Link>Linked\Support\LogPackage.vb</Link>
    </Compile>
    <!-- The 13-language localization layer. Linked whole, tables included: the parity
         test's whole job is to look at the real shipped table, and running it on BOTH
         legs also proves the #If NETFRAMEWORK seam cuts Codes to RU+EN on net48 while
         leaving the string tables shared. -->
    <Compile Include="..\..\src\Localization\*.vb">
      <Link>Linked\Localization\%(Filename)%(Extension)</Link>
    </Compile>
    <!-- Long-run stability (SPECIFICATION_LONG_RUN_STABILITY.md). All three are leaf
         modules with no WinForms dependency, which is exactly why the logic lives in
         them rather than inside Main_Form:
           AutoSkipPolicy  - the chain bound whose old form was also the recursion depth,
                             so a dropped share crashed the process (A-2).
           DiskCacheTrim   - the eviction the OCR and browser-translate caches never had,
                             and the budget the settings window displayed but nobody
                             enforced (D-1, D-3).
           FileOpQueue     - modern-only (whole-file "#If Not NETFRAMEWORK"), so on the
                             net48 leg this and its tests compile to nothing. Its
                             post-drain refusal used to be silent while the UI reported
                             success (B-2). -->
    <Compile Include="..\..\src\AutoSkipPolicy.vb">
      <Link>Linked\AutoSkipPolicy.vb</Link>
    </Compile>
    <!-- The classifier that decides whether a read failure is about the FILE (drop it from
         the list, as always) or about everything between us and it (keep it - a dropped SMB
         session used to shred a healthy folder one file per keypress). It is here rather
         than inside Main_Form precisely because the decision hangs on exception DERIVATION -
         FileNotFoundException is an IOException and UnauthorizedAccessException is not - and
         that is a question for a test, not for whoever edits the Select Case next. Compiled
         on both legs: the enum is shared, only the behaviour is fenced. -->
    <Compile Include="..\..\src\PathFailure.vb">
      <Link>Linked\PathFailure.vb</Link>
    </Compile>
    <!-- Whether a deletion can go to the Recycle Bin, and - when it cannot - why. Only the
         PURE half is linked: DeleteVolumeProbe reads the registry and DriveInfo, and keeping
         it out of this file is exactly what lets the rule matrix be proven without a NAS and
         a USB stick. Whole-file "#If Not NETFRAMEWORK", so this and DeletePolicyTests compile
         to nothing on the net48 leg - the honest shape, since the x86 viewer's DEL is still a
         bare File.Delete. -->
    <Compile Include="..\..\src\DeletePolicy.vb">
      <Link>Linked\DeletePolicy.vb</Link>
    </Compile>
    <!-- The other pure half of the same feature: what the Recycle Bin's own $I record says,
         and which record belongs to the deletion U is taking back. Linked for the same
         reason - the impure half (RecycleBinIo) enumerates a per-user, per-volume system
         folder, and pinning "an unknown record version is REFUSED, never guessed at" must
         not require deleting a real file first. Whole-file "#If Not NETFRAMEWORK". -->
    <Compile Include="..\..\src\RecycleBinIndex.vb">
      <Link>Linked\RecycleBinIndex.vb</Link>
    </Compile>
    <!-- The history behind U, and the table saying what U can promise. FileOpKind left
         Main_Form precisely so this could be tested: the rule "an undo is never itself
         undoable" has to hold for kinds nobody has written yet, and a Select Case inside a
         form is not where that gets noticed. UndoStack.vb is modern-only; FileOpKind.vb is
         shared and compiles on both legs, like the enum in the shipped x86 viewer. -->
    <Compile Include="..\..\src\FileOpKind.vb">
      <Link>Linked\FileOpKind.vb</Link>
    </Compile>
    <Compile Include="..\..\src\UndoStack.vb">
      <Link>Linked\UndoStack.vb</Link>
    </Compile>
    <Compile Include="..\..\src\DiskCacheTrim.vb">
      <Link>Linked\DiskCacheTrim.vb</Link>
    </Compile>
    <Compile Include="..\..\src\FileOpQueue.vb">
      <Link>Linked\FileOpQueue.vb</Link>
    </Compile>
    <!-- OCR overlay accuracy (SPECIFICATION_OCR_OVERLAY_ACCURACY.md). Pure logic, kept
         out of Main_Form exactly so it can be proven here: line clustering, the
         translatability filter and the font/growth ladder are all decisions a user would
         otherwise have to catch by eye on a comic page. OcrModels carries the data shapes
         they operate on (and OcrPipelineVersion, the cache key's guard against a stale
         document built by the previous algorithm). None of them pulls in Tesseract or
         WinForms - that is the point of the split. -->
    <Compile Include="..\..\src\Ocr\OcrModels.vb">
      <Link>Linked\Ocr\OcrModels.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Ocr\OcrBlockBuilder.vb">
      <Link>Linked\Ocr\OcrBlockBuilder.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Ocr\OcrOverlayFit.vb">
      <Link>Linked\Ocr\OcrOverlayFit.vb</Link>
    </Compile>
    <Compile Include="..\..\src\Ocr\OcrTextFilter.vb">
      <Link>Linked\Ocr\OcrTextFilter.vb</Link>
    </Compile>
    <!-- Whole-file "#If Not NETFRAMEWORK", so this and OcrPlateColorsTests compile to
         nothing on the net48 leg - the honest shape: sampled plate colours are a mainline
         improvement the x86 fallback does not get. -->
    <Compile Include="..\..\src\Ocr\OcrPlateColors.vb">
      <Link>Linked\Ocr\OcrPlateColors.vb</Link>
    </Compile>
  </ItemGroup>

  <!-- Each leg gets the SAME ImageSharp its viewer ships with, so the tests exercise
       the real decoder pair: net48 = WIC + ImageSharp 2 fallback, net10 = ImageSharp 3
       (the one that decodes animated WEBP with no OS codec). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <!-- ModernImageSharpDecoder uses Magick.NET for AVIF/HEIC/HEIF fallback. -->
    <PackageReference Include="Magick.NET-Q8-x64" Version="14.15.0" />
    <!-- ArchiveSession reads through the very library the mainline ships with, so the
         archive tests exercise the shipping path rather than a stand-in. Modern leg
         only: the archive files compile to nothing on net48. -->
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>

</Project>
