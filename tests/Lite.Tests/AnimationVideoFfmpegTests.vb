#If Not NETFRAMEWORK Then
Option Strict On

Imports System.Collections.Generic
Imports System.Diagnostics
Imports System.IO
Imports System.Text
Imports System.Threading
Imports System.Threading.Tasks
Imports Xunit

''' <summary>
''' The temporary video against the REAL pinned FFmpeg (spec 242 rules 9, 11, 12, 14, 25; the shape measured in T-0).
'''
''' Skipped, loudly and by name, when no FFmpeg is at hand - never a failure and never a pass. The runtime is taken from
''' the environment variable <c>FMS_TEST_FFMPEG</c> (the pinned 9.0.1 build; 8.x cannot decode an animated WEBP, E2), or
''' from <c>&lt;test exe dir&gt;\ffmpeg\ffmpeg.exe</c>, which is the first place the product's own lookup
''' (<c>OptionalRuntimeManager.GetFfmpegPath</c>) tries. The product's lookup itself is not callable from here: that
''' module is not part of the test project. Every file the tests make lives in a fresh folder under the temp path and
''' is removed again; the repository is never written to.
'''
''' The sources are generated by that same FFmpeg (lavfi into GIF / animated WEBP), so the test needs nothing but the
''' executable.
''' </summary>
Public Class AnimationVideoFfmpegTests

    Friend NotInheritable Class FfmpegLocator
        Private Sub New()
        End Sub

        Friend Shared Function Find() As String
            Dim fromEnvironment As String = Environment.GetEnvironmentVariable("FMS_TEST_FFMPEG")
            If Not String.IsNullOrWhiteSpace(fromEnvironment) AndAlso File.Exists(fromEnvironment) Then Return fromEnvironment
            Dim beside As String = Path.Combine(AppContext.BaseDirectory, "ffmpeg", "ffmpeg.exe")
            If File.Exists(beside) Then Return beside
            Return Nothing
        End Function
    End Class

    Public NotInheritable Class FactWhenFfmpegAttribute
        Inherits FactAttribute

        Public Sub New()
            If FfmpegLocator.Find() Is Nothing Then
                Skip = "FFmpeg is not available: set FMS_TEST_FFMPEG to the pinned ffmpeg.exe (9.0.1) to run the real-encoder checks"
            End If
        End Sub
    End Class

    ' --- running tools -----------------------------------------------------------------

    Private Shared Function NewWorkFolder() As String
        Dim folder As String = Path.Combine(Path.GetTempPath(), "fms-avtest-" & Guid.NewGuid().ToString("N"))
        Directory.CreateDirectory(folder)
        Return folder
    End Function

    Private Shared Sub RemoveFolder(folder As String)
        Try
            Directory.Delete(folder, True)
        Catch
        End Try
    End Sub

    ''' <summary>Runs FFmpeg to completion with its output going to a file named in the arguments.</summary>
    Private Shared Sub Generate(ffmpeg As String, arguments As String)
        Dim info As New ProcessStartInfo(ffmpeg, "-y -nostdin -hide_banner -loglevel error " & arguments) With {
            .UseShellExecute = False,
            .CreateNoWindow = True,
            .RedirectStandardOutput = True,
            .RedirectStandardError = True
        }
        Using proc As Process = Process.Start(info)
            Dim errors As Task(Of String) = proc.StandardError.ReadToEndAsync()
            Dim output As Task(Of String) = proc.StandardOutput.ReadToEndAsync()
            proc.WaitForExit()
            Assert.True(proc.ExitCode = 0, "generating the test source failed (" & proc.ExitCode & "): " & errors.Result & output.Result)
        End Using
    End Sub

    ''' <summary>The first frame of a video held in memory, as raw rgb24, decoded by a second FFmpeg that reads the bytes
    ''' from its stdin - the same route a pipe-fed player would take. Blocking; kept out of the async tests.</summary>
    Private Shared Function DecodeFirstFrame(ffmpeg As String, video As ReadOnlyMemory(Of Byte), expectedBytes As Integer) As Byte()
        Dim info As New ProcessStartInfo(ffmpeg, "-hide_banner -loglevel error -i pipe:0 -frames:v 1 -f rawvideo -pix_fmt rgb24 pipe:1") With {
            .UseShellExecute = False,
            .CreateNoWindow = True,
            .RedirectStandardInput = True,
            .RedirectStandardOutput = True,
            .RedirectStandardError = True
        }
        Using proc As Process = Process.Start(info)
            Dim errors As Task(Of String) = proc.StandardError.ReadToEndAsync()
            ' FFmpeg stops reading once it has its frame, so the tail of the write may fail: that is fine.
            Dim writer As Task = Task.Run(Sub()
                                              Try
                                                  Dim stdin As Stream = proc.StandardInput.BaseStream
                                                  stdin.Write(video.Span)
                                                  stdin.Close()
                                              Catch ex As IOException
                                              End Try
                                          End Sub)
            Dim frame As New MemoryStream()
            proc.StandardOutput.BaseStream.CopyTo(frame)
            proc.WaitForExit()
            writer.Wait(TimeSpan.FromSeconds(30))
            Assert.True(proc.ExitCode = 0, "decoding the captured video failed: " & errors.Result)
            Assert.True(frame.Length >= expectedBytes, "the decoded frame is smaller than expected: " & frame.Length)
            Return frame.ToArray()
        End Using
    End Function

    ' --- reading the containers --------------------------------------------------------------

    Private Shared Function IndexOfAscii(data As ReadOnlyMemory(Of Byte), text As String) As Integer
        Return data.Span.IndexOf(Encoding.ASCII.GetBytes(text))
    End Function

    Private Shared Function BigEndian32(data As ReadOnlyMemory(Of Byte), offset As Integer) As UInteger
        Dim four As Byte() = data.Slice(offset, 4).ToArray()
        Return (CUInt(four(0)) << 24) Or (CUInt(four(1)) << 16) Or (CUInt(four(2)) << 8) Or four(3)
    End Function

    ''' <summary>The CODED size, from the <c>avc1</c> sample entry (two 16-bit fields 28 bytes after the box type). Not the
    ''' <c>tkhd</c> size: that one is the DISPLAY size, and when the scale filter rounds an odd source to an even one it
    ''' keeps the picture shape through the sample aspect ratio, so a 201x101 source is coded 200x100 and displayed as
    ''' 199x100. The video has one track (<c>-an</c>).</summary>
    Private Shared Function CodedSize(data As ReadOnlyMemory(Of Byte)) As Size
        Dim at As Integer = IndexOfAscii(data, "avc1")
        Assert.True(at >= 4, "no avc1 sample entry in the captured video")
        Dim fields As Byte() = data.Slice(at + 28, 4).ToArray()
        Return New Size((CInt(fields(0)) << 8) Or fields(1), (CInt(fields(2)) << 8) Or fields(3))
    End Function

    Private Structure Size
        Friend ReadOnly Width As Integer
        Friend ReadOnly Height As Integer

        Friend Sub New(width As Integer, height As Integer)
            Me.Width = width
            Me.Height = height
        End Sub
    End Structure

    ''' <summary>What the viewer would know about an animated WEBP from its header: canvas, alpha flag, frame count and
    ''' summed frame duration, read by walking the RIFF chunks (no decode).</summary>
    Private Structure WebpFacts
        Friend CanvasWidth As Integer
        Friend CanvasHeight As Integer
        Friend HasAlpha As Boolean
        Friend Frames As Integer
        Friend DurationMs As Integer
    End Structure

    Private Shared Function ReadWebp(path As String) As WebpFacts
        Dim data As Byte() = File.ReadAllBytes(path)
        Assert.Equal("RIFF", Encoding.ASCII.GetString(data, 0, 4))
        Assert.Equal("WEBP", Encoding.ASCII.GetString(data, 8, 4))
        Dim facts As New WebpFacts()
        Dim offset As Integer = 12
        While offset + 8 <= data.Length
            Dim tag As String = Encoding.ASCII.GetString(data, offset, 4)
            Dim size As Integer = BitConverter.ToInt32(data, offset + 4)
            Dim payload As Integer = offset + 8
            If tag = "VP8X" Then
                facts.HasAlpha = (data(payload) And &H10) <> 0
                facts.CanvasWidth = 1 + (CInt(data(payload + 4)) Or (CInt(data(payload + 5)) << 8) Or (CInt(data(payload + 6)) << 16))
                facts.CanvasHeight = 1 + (CInt(data(payload + 7)) Or (CInt(data(payload + 8)) << 8) Or (CInt(data(payload + 9)) << 16))
            ElseIf tag = "ANMF" Then
                facts.Frames += 1
                facts.DurationMs += CInt(data(payload + 12)) Or (CInt(data(payload + 13)) << 8) Or (CInt(data(payload + 14)) << 16)
            End If
            offset = payload + size + (size And 1)
        End While
        Return facts
    End Function

    ' --- the checks every captured video must pass ---------------------------------------------

    Private Shared Sub AssertIsAFragmentedMp4(video As EncodedVideo)
        Assert.Equal(AnimationVideoOutcome.Succeeded, video.Outcome)
        Assert.True(video.Length > VideoConvertPlan.Min_Output_Bytes, "implausibly small: " & video.Length)
        Assert.Equal(0, video.ExitCode)
        ' The first box is ftyp, and a fragmented file has movie fragments (moof) behind an empty moov.
        Assert.Equal("ftyp", Encoding.ASCII.GetString(video.Bytes.Slice(4, 4).ToArray()))
        Assert.True(IndexOfAscii(video.Bytes, "moof") > 0, "no moof box: this is not a fragmented MP4")
        Assert.True(IndexOfAscii(video.Bytes, "moov") > 0, "no moov box")
    End Sub

    Private Shared Sub AssertEvenAndWithin(size As Size, maxWidth As Integer, maxHeight As Integer)
        Assert.True(size.Width Mod 2 = 0 AndAlso size.Height Mod 2 = 0, "odd output size " & size.Width & "x" & size.Height)
        Assert.True(size.Width <= maxWidth AndAlso size.Height <= maxHeight, "output " & size.Width & "x" & size.Height & " is larger than " & maxWidth & "x" & maxHeight)
    End Sub

    Private Shared Sub AssertProgressIsSane(progress As AnimationVideoEncoderTests.RecordingProgress)
        Dim previous As Integer = -1
        For Each value As Integer In progress.Snapshot()
            Assert.InRange(value, 0, 99)
            Assert.True(value > previous, "progress went backwards")
            previous = value
        Next
    End Sub

    Private Shared Function RunReal(ffmpeg As String, arguments As String, durationMs As Integer,
                                    progress As IProgress(Of Integer)) As Task(Of EncodedVideo)
        Return AnimationVideoEncoder.RunAsync(ffmpeg, arguments, durationMs, AnimationVideoPlan.Video_Max_Bytes, False, progress,
                                              CancellationToken.None).WaitAsync(TimeSpan.FromMinutes(3))
    End Function

    ' --- the checks -----------------------------------------------------------------------------------

    <FactWhenFfmpeg>
    Public Async Function A_transparent_animated_webp_becomes_a_fragmented_mp4_with_every_frame_over_the_background() As Task
        Dim ffmpeg As String = FfmpegLocator.Find()
        Dim folder As String = NewWorkFolder()
        Try
            ' 20 frames of half-transparent red whose hue turns 36 degrees per frame, so no two NEIGHBOURING frames are the
            ' same (an encoder merges identical frames into one longer one - a slower turn of 6 degrees came out as 17
            ' frames - and the count would no longer be 20).
            Dim source As String = Path.Combine(folder, "alpha éлф.webp")
            Generate(ffmpeg, "-f lavfi -i ""color=c=red:s=200x200:r=10:d=2,format=rgba,colorchannelmixer=aa=0.5,hue=h=t*360"" -c:v libwebp_anim -loop 0 " &
                             Utils.QuoteArgument(source))
            Dim facts As WebpFacts = ReadWebp(source)
            Assert.True(facts.HasAlpha, "the generated WEBP does not declare transparency, so it cannot test rule 9")
            Assert.Equal(20, facts.Frames)

            Dim fps As Integer = VideoConvertPlan.Fps(facts.Frames, facts.DurationMs)
            Dim arguments As String = AnimationVideoPlan.BuildArguments(source, fps, facts.HasAlpha, facts.CanvasWidth, facts.CanvasHeight, &H202020)
            Dim progress As New AnimationVideoEncoderTests.RecordingProgress()

            Using video As EncodedVideo = Await RunReal(ffmpeg, arguments, facts.DurationMs, progress)
                AssertIsAFragmentedMp4(video)
                Assert.True(video.Detail.Length = 0, video.Detail)
                ' cfr at the source rate: as many frames out as animation frames in.
                Assert.Equal(CLng(facts.Frames), video.FramesWritten)
                Dim size As Size = CodedSize(video.Bytes)
                Assert.Equal(200, size.Width)
                Assert.Equal(200, size.Height)
                AssertProgressIsSane(progress)

                ' Rule 9: the transparent red lands on the background colour, not on black. Red at 50 % over 0x202020 is
                ' (143, 16, 16); the first frame has not been hue-turned yet. Chroma subsampling and the YUV round trip
                ' move it by a few levels, hence the margin.
                Dim rgb As Byte() = DecodeFirstFrame(ffmpeg, video.Bytes, 200 * 200 * 3)
                Dim centre As Integer = ((100 * 200) + 100) * 3
                Assert.InRange(CInt(rgb(centre)), 143 - 16, 143 + 16)
                Assert.InRange(CInt(rgb(centre + 1)), 0, 16 + 16)
                Assert.InRange(CInt(rgb(centre + 2)), 0, 16 + 16)
                ' ...and "not black" for certain: a black background would give about (127, 0, 0).
                Assert.True(rgb(centre) > 130, "the transparent area was not flattened onto the background colour")
            End Using
        Finally
            RemoveFolder(folder)
        End Try
    End Function

    <FactWhenFfmpeg>
    Public Async Function An_odd_sized_animation_comes_out_even_and_not_larger() As Task
        Dim ffmpeg As String = FfmpegLocator.Find()
        Dim folder As String = NewWorkFolder()
        Try
            Dim source As String = Path.Combine(folder, "odd 201x101.gif")
            Generate(ffmpeg, "-f lavfi -i ""testsrc=size=201x101:rate=10"" -frames:v 10 " & Utils.QuoteArgument(source))

            Dim arguments As String = AnimationVideoPlan.BuildArguments(source, 10, False, 0, 0, 0)
            Using video As EncodedVideo = Await RunReal(ffmpeg, arguments, 1000, Nothing)
                AssertIsAFragmentedMp4(video)
                Dim size As Size = CodedSize(video.Bytes)
                AssertEvenAndWithin(size, 201, 101)
                ' Rounded down to the even size, not shrunk by a cap that does not apply.
                Assert.Equal(200, size.Width)
                Assert.Equal(100, size.Height)
                Assert.Equal(10L, video.FramesWritten)
            End Using
        Finally
            RemoveFolder(folder)
        End Try
    End Function

    <FactWhenFfmpeg>
    Public Async Function A_wide_animation_is_downscaled_to_the_cap_with_its_aspect_kept() As Task
        Dim ffmpeg As String = FfmpegLocator.Find()
        Dim folder As String = NewWorkFolder()
        Try
            Dim source As String = Path.Combine(folder, "wide.gif")
            Generate(ffmpeg, "-f lavfi -i ""testsrc=size=5000x1000:rate=5"" -frames:v 3 " & Utils.QuoteArgument(source))

            Dim arguments As String = AnimationVideoPlan.BuildArguments(source, 5, False, 0, 0, 0)
            Using video As EncodedVideo = Await RunReal(ffmpeg, arguments, 600, Nothing)
                AssertIsAFragmentedMp4(video)
                Dim size As Size = CodedSize(video.Bytes)
                AssertEvenAndWithin(size, AnimationVideoPlan.Max_Width, AnimationVideoPlan.Max_Height)
                ' 5000x1000 into 3840 wide: 3840x768, the 5:1 shape kept.
                Assert.Equal(3840, size.Width)
                Assert.Equal(768, size.Height)
                Assert.Equal(3L, video.FramesWritten)
            End Using
        Finally
            RemoveFolder(folder)
        End Try
    End Function

    <FactWhenFfmpeg>
    Public Async Function A_tall_animation_is_downscaled_to_the_height_cap_with_its_aspect_kept() As Task
        Dim ffmpeg As String = FfmpegLocator.Find()
        Dim folder As String = NewWorkFolder()
        Try
            Dim source As String = Path.Combine(folder, "tall.gif")
            Generate(ffmpeg, "-f lavfi -i ""testsrc=size=1000x5000:rate=5"" -frames:v 3 " & Utils.QuoteArgument(source))

            Dim arguments As String = AnimationVideoPlan.BuildArguments(source, 5, False, 0, 0, 0)
            Using video As EncodedVideo = Await RunReal(ffmpeg, arguments, 600, Nothing)
                AssertIsAFragmentedMp4(video)
                Dim size As Size = CodedSize(video.Bytes)
                AssertEvenAndWithin(size, AnimationVideoPlan.Max_Width, AnimationVideoPlan.Max_Height)
                ' 1000x5000 into 2160 high: 432x2160.
                Assert.Equal(432, size.Width)
                Assert.Equal(2160, size.Height)
            End Using
        Finally
            RemoveFolder(folder)
        End Try
    End Function

    <FactWhenFfmpeg>
    Public Async Function A_source_that_is_not_an_image_is_an_encoder_failure_with_a_reason() As Task
        Dim ffmpeg As String = FfmpegLocator.Find()
        Dim folder As String = NewWorkFolder()
        Try
            Dim source As String = Path.Combine(folder, "broken.webp")
            File.WriteAllBytes(source, Encoding.ASCII.GetBytes("RIFF....WEBPVP8X this is not a picture"))

            Dim arguments As String = AnimationVideoPlan.BuildArguments(source, 10, False, 0, 0, 0)
            Using video As EncodedVideo = Await RunReal(ffmpeg, arguments, 1000, Nothing)
                Assert.Equal(AnimationVideoOutcome.EncoderFailed, video.Outcome)
                Assert.NotEqual(0, video.ExitCode)
                Assert.True(video.Detail.Length > 0)
                Assert.DoesNotContain("progress=", video.Detail, StringComparison.Ordinal)
                Assert.True(video.Bytes.IsEmpty)
            End Using
        Finally
            RemoveFolder(folder)
        End Try
    End Function

    <FactWhenFfmpeg>
    Public Async Function A_missing_source_is_an_encoder_failure_and_leaves_no_file_behind() As Task
        Dim ffmpeg As String = FfmpegLocator.Find()
        Dim folder As String = NewWorkFolder()
        Try
            Dim arguments As String = AnimationVideoPlan.BuildArguments(Path.Combine(folder, "absent.webp"), 10, False, 0, 0, 0)
            Using video As EncodedVideo = Await RunReal(ffmpeg, arguments, 1000, Nothing)
                Assert.Equal(AnimationVideoOutcome.EncoderFailed, video.Outcome)
            End Using
            ' Rule 25 end to end: whatever happened, the work folder holds no file.
            Assert.Empty(Directory.GetFileSystemEntries(folder))
        Finally
            RemoveFolder(folder)
        End Try
    End Function

End Class
#End If
