Option Strict On

Imports System.Collections.Generic
Imports System.IO
Imports System.Linq
Imports System.Security.Cryptography
Imports System.Text
Imports System.Text.RegularExpressions
Imports FastMediaSorterCompanion
Imports Xunit

''' <summary>
''' The host half of WORKER-IPC's exchange vectors - section 10 item A (0.11), which replaced the flat
''' "recorded exchange per request type" of section 7 with a shape and a home: one directory per case
''' under <c>vectors/</c>, holding <c>request.json</c> (the exact request bytes, generated by the HOST's
''' serializer), <c>response.json</c> (the exact response bytes, recorded from the WORKER answering that
''' request in its own harness), <c>expect.json</c> (what a conformant host must conclude, as data) and a
''' <c>PROVENANCE.txt</c> beside them with the SHA-256 of every file and the command that generated each half.
'''
''' The two halves have different owners. The REQUEST bytes are this host's: they are what its own
''' serializer puts on the pipe, so they are generated here, by the product code, and pinned byte for byte.
''' The RESPONSE half can only honestly come from the worker's harness - the one implementation that
''' produces a response nobody hand-wrote - so it is vendored, digest-checked, once the owner publishes it
''' (the command is the worker owner's to name; the older-worker and higher-schema cases need a switch in
''' that harness). No response is written, or invented, here.
'''
''' <c>expect.json</c> is written by this generator only where the conclusion is fixed by the contract text
''' alone and does not depend on a recorded value: which side of a refusal a response falls on
''' (<c>higher-schema</c>, section 6 rule 3), the benign <c>ok=false</c> of an unknown type (section 4),
''' what an older worker's status must read as (<c>status-older-worker</c>, section 6 rules 1 and 2) and
''' whether the server is up in the two status cases. For every other case the conclusion carries field
''' values of the recorded response, so its <c>expect.json</c> is owed together with that response.
'''
''' Generated, never hand-edited (the catalog's RULES section 9). To regenerate after a deliberate wire
''' change, run the suite with FMS_REGENERATE_WORKER_IPC=1: the generator rewrites
''' tests/Companion.Tests/TestData/worker-ipc/vectors/ from the cases below, PROVENANCE.txt included, and
''' the pin then holds the new bytes. A diff in those files is a wire change and reads like one in review.
''' The folder is laid out exactly as the catalog's, so offering it to the catalog is a copy.
''' </summary>
Public Class WorkerIpcConformanceTests

    Private Const RegenerateVariable As String = "FMS_REGENERATE_WORKER_IPC"

    ' expect.json bodies, compact, fixed key order: {"refused","ok","running","fields"}. In "fields" a value
    ' of null means "the host must read this member as absent" (no data yet, section 6 rule 2; for
    ' portSupported an absent member reads as false, rule 1).
    Private Const ExpectRefused As String = "{""refused"":true,""ok"":false,""running"":null,""fields"":{}}"
    Private Const ExpectUnknownType As String = "{""refused"":false,""ok"":false,""running"":null,""fields"":{}}"
    Private Const ExpectOlderWorker As String = "{""refused"":false,""ok"":true,""running"":null,""fields"":{""portSupported"":null,""reachability"":null,""stats"":null}}"
    Private Const ExpectServing As String = "{""refused"":false,""ok"":true,""running"":true,""fields"":{}}"
    Private Const ExpectDown As String = "{""refused"":false,""ok"":true,""running"":false,""fields"":{}}"

    ''' <summary>One case of the vector set: the request the host sends and, where the contract text alone
    ''' fixes it, the conclusion a host must draw from the worker's answer.</summary>
    Friend NotInheritable Class VectorCase
        Friend ReadOnly Request As WorkerRequest
        ''' <summary>The expect.json body, or Nothing when it is owed with the recorded response.</summary>
        Friend ReadOnly Expect As String

        Friend Sub New(request As WorkerRequest, Optional expect As String = Nothing)
            Me.Request = request
            Me.Expect = expect
        End Sub
    End Class

    ''' <summary>Every case, each request built the way the product builds it. Directory name = case name.
    ''' The five named cases of item A come first in meaning (not in order: the folder is sorted), then one
    ''' case per request type of section 4 that this host sends, then the six disk requests of DISK-SHARE
    ''' section 16 (item D: the disk exchanges are owed as vectors). ExportConfig has no case: the Share
    ''' Manager never sends it, it builds the .fmscfg itself.</summary>
    Friend Shared Function VectorCases() As SortedDictionary(Of String, VectorCase)
        Dim c As New SortedDictionary(Of String, VectorCase)(StringComparer.Ordinal)
        ' --- the named cases of item A -------------------------------------------------------------
        c("status-running") = New VectorCase(New WorkerRequest With {.type = "GetStatus"}, ExpectServing)
        c("status-down") = New VectorCase(New WorkerRequest With {.type = "GetStatus"}, ExpectDown)
        c("status-older-worker") = New VectorCase(New WorkerRequest With {.type = "GetStatus"}, ExpectOlderWorker)
        c("unknown-type") = New VectorCase(New WorkerRequest With {.type = "NoSuchRequestType"}, ExpectUnknownType)
        c("higher-schema") = New VectorCase(New WorkerRequest With {.type = "GetStatus"}, ExpectRefused)
        ' --- one case per request type of section 4 that the host sends -----------------------------
        ' Two roots, both readOnly values, a backslash and a non-ASCII name - the escaping of the last
        ' two is exactly what a second implementation gets wrong.
        c("set-shared-folders") = New VectorCase(New WorkerRequest With {
            .type = "SetSharedFolders",
            .folders = New List(Of ShareFolder) From {
                New ShareFolder With {.name = "Photos", .hostPath = "C:\Users\me\Pictures", .readOnly = False},
                New ShareFolder With {.name = "Фото", .hostPath = "D:\Архив\Фото", .readOnly = True}
            }
        })
        c("invalidate-pin-sessions") = New VectorCase(New WorkerRequest With {.type = "InvalidatePinSessions"})
        c("set-protected-folders") = New VectorCase(New WorkerRequest With {
            .type = "SetSharedFolders", .PinConfiguration = True,
            .folders = New List(Of ShareFolder) From {New ShareFolder With {.name = "Private", .hostPath = "C:\Synthetic\Private", .readOnly = True, .accessPin = "synthetic-vector-pin"}}})
        c("start-server") = New VectorCase(New WorkerRequest With {.type = "StartServer"})
        c("stop-server") = New VectorCase(New WorkerRequest With {.type = "StopServer"})
        c("reset-stats") = New VectorCase(New WorkerRequest With {.type = "ResetStats"})
        ' The policy push as the product builds it: every knob, then no recorded port (the port
        ' OMITTED - rule 4), then the port alone.
        c("set-network-policy-full") = New VectorCase(ShareController.NetworkPolicyRequest(10, True, 2222))
        c("set-network-policy-partial") = New VectorCase(ShareController.NetworkPolicyRequest(10, False, ShareSettings.UnsetPort))
        c("set-network-policy-port-only") = New VectorCase(New WorkerRequest With {.type = "SetNetworkPolicy", .port = 2222})
        ' --- the six disk requests of DISK-SHARE section 16 (schema 2) ------------------------------
        c("disk-share") = New VectorCase(New WorkerRequest With {.type = "disk-share", .owner = "filedo", .action = "share", .containerPath = "D:\Demo\photos.fdd", .rootName = "Photos", .readOnly = True})
        c("disk-unshare") = New VectorCase(New WorkerRequest With {.type = "disk-share", .owner = "filedo", .action = "unshare", .containerPath = "D:\Demo\photos.fdd", .drainTimeout = 30})
        c("disk-open") = New VectorCase(New WorkerRequest With {.type = "disk-open", .owner = "filedo", .containerPath = "D:\Demo\photos.fdd", .password = "synthetic-vector-credential"})
        c("disk-close") = New VectorCase(New WorkerRequest With {.type = "disk-close", .owner = "filedo", .containerPath = "D:\Demo\photos.fdd", .force = False, .drainTimeout = 30})
        c("disk-autostart-on") = New VectorCase(New WorkerRequest With {.type = "disk-autostart", .owner = "filedo", .containerPath = "D:\Demo\photos.fdd", .enable = True, .consent = True, .password = "synthetic-vector-credential"})
        c("disk-autostart-off") = New VectorCase(New WorkerRequest With {.type = "disk-autostart", .owner = "filedo", .containerPath = "D:\Demo\photos.fdd", .enable = False})
        c("disk-status") = New VectorCase(New WorkerRequest With {.type = "disk-status", .owner = "filedo", .containerPath = "D:\Demo\photos.fdd"})
        c("disk-list") = New VectorCase(New WorkerRequest With {.type = "disk-list", .owner = "filedo"})
        Return c
    End Function

    ''' <summary>The request half alone, name to request - what the other suites ask for.</summary>
    Friend Shared Function RequestCases() As SortedDictionary(Of String, WorkerRequest)
        Dim r As New SortedDictionary(Of String, WorkerRequest)(StringComparer.Ordinal)
        For Each kv As KeyValuePair(Of String, VectorCase) In VectorCases()
            r(kv.Key) = kv.Value.Request
        Next
        Return r
    End Function

    Private Shared Function VectorsDirInOutput() As String
        Return Path.Combine(AppContext.BaseDirectory, "TestData", "worker-ipc", "vectors")
    End Function

    ''' <summary>The generator. A no-op unless asked for - then it writes into the SOURCE tree,
    ''' never the build output, so the result is what gets committed.</summary>
    <Fact>
    Public Sub Generate_VectorFolder_WhenAsked()
        If Environment.GetEnvironmentVariable(RegenerateVariable) <> "1" Then Return
        Dim root As String = FindRepoRoot()
        Assert.False(root Is Nothing, "repository root not found above " & AppContext.BaseDirectory)
        Dim worker As String = Path.Combine(root, "tests", "Companion.Tests", "TestData", "worker-ipc")
        Dim dir As String = Path.Combine(worker, "vectors")

        ' The first flat layout (requests/*.json, ticket 035 phase 5) is replaced, not kept beside.
        Dim legacy As String = Path.Combine(worker, "requests")
        If Directory.Exists(legacy) Then Directory.Delete(legacy, recursive:=True)
        ' Only the host's files are rewritten; a recorded response.json that has been vendored stays.
        Directory.CreateDirectory(dir)
        For Each stale As String In Directory.GetDirectories(dir)
            If Not VectorCases().ContainsKey(Path.GetFileName(stale)) Then Directory.Delete(stale, recursive:=True)
        Next

        Dim digests As New StringBuilder()
        For Each kv As KeyValuePair(Of String, VectorCase) In VectorCases()
            Dim caseDir As String = Path.Combine(dir, kv.Key)
            Directory.CreateDirectory(caseDir)
            Dim bytes As Byte() = WorkerIpc.SerializeRequest(kv.Value.Request)
            File.WriteAllBytes(Path.Combine(caseDir, "request.json"), bytes)
            digests.Append(DigestLine(bytes, kv.Key & "/request.json"))
            Dim expectFile As String = Path.Combine(caseDir, "expect.json")
            If kv.Value.Expect IsNot Nothing Then
                Dim expectBytes As Byte() = Encoding.UTF8.GetBytes(kv.Value.Expect)
                File.WriteAllBytes(expectFile, expectBytes)
                digests.Append(DigestLine(expectBytes, kv.Key & "/expect.json"))
            ElseIf File.Exists(expectFile) Then
                File.Delete(expectFile)
            End If
        Next
        File.WriteAllText(Path.Combine(dir, "PROVENANCE.txt"), ProvenanceHeader() & digests.ToString() & ProvenanceFooter(), New UTF8Encoding(False))
    End Sub

    ''' <summary>The pin: every case's committed request holds exactly the bytes the product serializer
    ''' emits today, the set of case directories is exactly the set of cases, an expect.json exists exactly
    ''' where the table authors one, and PROVENANCE.txt carries each file's digest.</summary>
    <Fact>
    Public Sub RequestHalf_MatchesTheProductSerializer_ByteForByte()
        If Environment.GetEnvironmentVariable(RegenerateVariable) = "1" Then Return ' being rewritten
        Dim dir As String = VectorsDirInOutput()
        Assert.True(Directory.Exists(dir), "missing " & dir & " - run with " & RegenerateVariable & "=1 once")

        Dim cases As SortedDictionary(Of String, VectorCase) = VectorCases()
        Dim onDisk As String() = Directory.GetDirectories(dir).
            Select(Function(d) Path.GetFileName(d)).
            OrderBy(Function(n) n, StringComparer.Ordinal).ToArray()
        Assert.Equal(cases.Keys.ToArray(), onDisk)

        Dim provenance As String = File.ReadAllText(Path.Combine(dir, "PROVENANCE.txt"))
        For Each kv As KeyValuePair(Of String, VectorCase) In cases
            Dim caseDir As String = Path.Combine(dir, kv.Key)
            Dim expected As Byte() = WorkerIpc.SerializeRequest(kv.Value.Request)
            Dim committed As Byte() = File.ReadAllBytes(Path.Combine(caseDir, "request.json"))
            Assert.True(expected.SequenceEqual(committed),
                        kv.Key & "/request.json differs from what the product serializer emits:" & vbLf &
                        "  committed: " & Encoding.UTF8.GetString(committed) & vbLf &
                        "  product  : " & Encoding.UTF8.GetString(expected))
            Assert.Contains(HexDigest(committed) & "  " & kv.Key & "/request.json", provenance)

            Dim expectFile As String = Path.Combine(caseDir, "expect.json")
            If kv.Value.Expect Is Nothing Then
                Assert.False(File.Exists(expectFile), kv.Key & "/expect.json exists but the case table owes it with the response")
            Else
                Dim expectBytes As Byte() = File.ReadAllBytes(expectFile)
                Assert.Equal(kv.Value.Expect, Encoding.UTF8.GetString(expectBytes))
                Assert.Contains(HexDigest(expectBytes) & "  " & kv.Key & "/expect.json", provenance)
            End If
            ' A case directory holds only the three named files; the response is the worker's, never ours.
            For Each f As String In Directory.GetFiles(caseDir)
                Assert.Contains(Path.GetFileName(f), {"request.json", "response.json", "expect.json"})
            Next
        Next
    End Sub

    ''' <summary>The names item A gives are all present, and every request type of section 4 that this host
    ''' sends - plus the six disk requests - is some case's request. The five named cases carry the request
    ''' bytes of the status poll / an unknown type, so the type check is on the union.</summary>
    <Fact>
    Public Sub TheCaseTable_HasTheNamedCases_AndEverySection4RequestTheHostSends()
        Dim cases As SortedDictionary(Of String, VectorCase) = VectorCases()
        For Each named As String In {"status-running", "status-down", "status-older-worker", "unknown-type", "higher-schema"}
            Assert.True(cases.ContainsKey(named), "named case missing: " & named)
        Next
        Dim sent As HashSet(Of String) = cases.Values.Select(Function(v) v.Request.type).ToHashSet(StringComparer.Ordinal)
        For Each section4 As String In {"GetStatus", "SetSharedFolders", "StartServer", "StopServer", "SetNetworkPolicy", "ResetStats"}
            Assert.Contains(section4, sent)
        Next
        For Each disk As String In {"disk-share", "disk-open", "disk-close", "disk-autostart", "disk-status", "disk-list"}
            Assert.Contains(disk, sent)
        Next
        ' ExportConfig is never sent by this host (it builds the .fmscfg itself): a case for it would be a lie.
        Assert.DoesNotContain("ExportConfig", sent)
        ' The three status cases are the same request - they differ in the worker that answers.
        Assert.Equal(WorkerRequestBytes(cases("status-running")), WorkerRequestBytes(cases("status-down")))
        Assert.Equal(WorkerRequestBytes(cases("status-running")), WorkerRequestBytes(cases("status-older-worker")))
        Assert.Equal(WorkerRequestBytes(cases("status-running")), WorkerRequestBytes(cases("higher-schema")))
    End Sub

    ''' <summary>Drift guard: a request type found in the host's sources has a vector, or is one of the
    ''' types that are not WORKER-IPC section 4 requests (the broadcast verbs and SetExchange are filed as
    ''' proposals and are not in 0.14). A new verb must be given a case - or be declared outside - on purpose.</summary>
    <Fact>
    Public Sub EveryRequestTypeTheHostSends_HasAVector_OrIsDeclaredOutsideTheContract()
        Dim root As String = FindRepoRoot()
        Assert.False(root Is Nothing, "repository root not found above " & AppContext.BaseDirectory)
        Dim declaredOutside As String() = {"CreateBroadcast", "ListBroadcasts", "RefreshBroadcast", "RevokeBroadcast", "SetBroadcastPolicy", "SetExchange"}
        Dim vectored As HashSet(Of String) = VectorCases().Values.Select(Function(v) v.Request.type).ToHashSet(StringComparer.Ordinal)
        Dim found As New SortedSet(Of String)(StringComparer.Ordinal)
        For Each f As String In Directory.GetFiles(Path.Combine(root, "src", "FastMediaSorterCompanion"), "*.vb", SearchOption.AllDirectories)
            If f.IndexOf("\obj\", StringComparison.OrdinalIgnoreCase) >= 0 OrElse f.IndexOf("\bin\", StringComparison.OrdinalIgnoreCase) >= 0 Then Continue For
            For Each m As Match In Regex.Matches(File.ReadAllText(f), "\.type\s*=\s*""([A-Za-z-]+)""")
                found.Add(m.Groups(1).Value)
            Next
        Next
        Assert.NotEmpty(found)
        Dim unvectored As List(Of String) = found.Where(Function(t) Not vectored.Contains(t) AndAlso Not declaredOutside.Contains(t)).ToList()
        Assert.True(unvectored.Count = 0, "request types the host sends with no vector case: " & String.Join(", ", unvectored))
    End Sub

    ''' <summary>Two properties of the pinned bytes that a reader of the files should not have
    ''' to rediscover: an unset knob is absent (rule 4), and every request carries the version.</summary>
    <Fact>
    Public Sub RequestHalf_OmitsUnsetKnobs_AndCarriesTheVersion()
        For Each kv As KeyValuePair(Of String, WorkerRequest) In RequestCases()
            Dim text As String = Encoding.UTF8.GetString(WorkerIpc.SerializeRequest(kv.Value))
            Assert.StartsWith("{""schemaVersion"":" & WorkerIpc.RequestSchema(kv.Value).ToString() & ",""type"":", text)
            Assert.DoesNotContain(":null", text)
        Next
        Dim partialPolicy As String = Encoding.UTF8.GetString(WorkerIpc.SerializeRequest(RequestCases()("set-network-policy-partial")))
        Assert.DoesNotContain("""port""", partialPolicy)
    End Sub

    ''' <summary>Item A's second property: the .NET serializer escapes non-ASCII as \uXXXX with upper-case hex
    ''' and the worker reads escaped and raw UTF-8 alike. The vectors carry the escaped form because that is
    ''' what the serializer writes - a second host that writes raw UTF-8 is also valid JSON.</summary>
    <Fact>
    Public Sub NonAsciiNames_AreEscapedWithUpperCaseHex()
        Dim text As String = Encoding.UTF8.GetString(WorkerIpc.SerializeRequest(RequestCases()("set-shared-folders")))
        Assert.Contains("\u0424\u043E\u0442\u043E", text)   ' "Фото"
        Assert.DoesNotMatch("[^\u0000-\u007F]", text)       ' nothing non-ASCII reaches the pipe raw
        Dim escapes As MatchCollection = Regex.Matches(text, "\\u[0-9A-Fa-f]{4}")
        Assert.True(escapes.Count >= 9, "the vector carries no escaped names to check")
        For Each m As Match In escapes
            Assert.Equal(m.Value.Substring(2).ToUpperInvariant(), m.Value.Substring(2))   ' upper-case hex
        Next
    End Sub

    ''' <summary>
    ''' The response half: recorded worker responses the host must accept, digest-checked against their
    ''' PROVENANCE.txt before a byte is trusted - the shape of the vendored fd-sec vectors. No case directory
    ''' holds a response.json until the worker's owner publishes the exchange vectors (catalog proposal
    ''' sidecar-control/PROPOSAL-2026-09-24-exchange-vectors.md, accepted into 0.11), so this is SKIPPED BY
    ''' NAME rather than passed on nothing. Vendor the files into TestData/worker-ipc/vectors/&lt;case&gt;/ and
    ''' remove the Skip.
    ''' </summary>
    <Fact(Skip:="WORKER-IPC item A response half: no worker-recorded response.json vendored yet - the worker's harness owns them (0.11)")>
    Public Sub ResponseVectors_AreAccepted_AndMatchTheirExpectation()
        Dim dir As String = VectorsDirInOutput()
        Dim provenance As String = File.ReadAllText(Path.Combine(dir, "PROVENANCE.txt"))
        Dim responses As String() = Directory.GetFiles(dir, "response.json", SearchOption.AllDirectories)
        Assert.NotEmpty(responses)
        For Each f As String In responses
            Dim bytes As Byte() = File.ReadAllBytes(f)
            Dim caseName As String = Path.GetFileName(Path.GetDirectoryName(f))
            Assert.Contains(HexDigest(bytes) & "  " & caseName & "/response.json", provenance)
            Dim expectFile As String = Path.Combine(Path.GetDirectoryName(f), "expect.json")
            Dim refused As Boolean = False
            Dim resp As WorkerResponse = Nothing
            ' Accepted = read without a transport-level failure; a higher version is refused by type,
            ' never by accident.
            Try
                resp = WorkerIpc.ParseResponse(Encoding.UTF8.GetString(bytes), WorkerIpc.RequestSchema(VectorCases()(caseName).Request))
                Assert.NotNull(resp)
            Catch refusal As WorkerVersionRefusedException
                Assert.True(refusal.WorkerVersion > WorkerIpc.SchemaVersion)
                refused = True
            End Try
            If File.Exists(expectFile) Then
                Dim expectText As String = File.ReadAllText(expectFile)
                Assert.Contains("""refused"":" & If(refused, "true", "false"), expectText)
                If resp IsNot Nothing Then Assert.Contains("""ok"":" & If(resp.Ok, "true", "false"), expectText)
            End If
        Next
    End Sub

    ' --- helpers --------------------------------------------------------------------

    Private Shared Function WorkerRequestBytes(c As VectorCase) As String
        Return Encoding.UTF8.GetString(WorkerIpc.SerializeRequest(c.Request))
    End Function

    Private Shared Function HexDigest(bytes As Byte()) As String
        Return Convert.ToHexString(SHA256.HashData(bytes)).ToLowerInvariant()
    End Function

    Private Shared Function DigestLine(bytes As Byte(), name As String) As String
        Return "  SHA-256  " & HexDigest(bytes) & "  " & name & vbLf
    End Function

    Private Shared Function ProvenanceHeader() As String
        Return String.Join(vbLf, {
            "WORKER-IPC exchange vectors - the host half of section 10 item A",
            "================================================================",
            "",
            "Layout     : vectors/<case>/{request.json, response.json, expect.json}, as the catalog's.",
            "             This file lists the SHA-256 of every file present and the command that made each half.",
            "",
            "request.json  - generated, never hand-edited: the exact byte sequence the Share Manager's own",
            "                serializer (WorkerIpc.SerializeRequest) writes to the pipe for that request, as the",
            "                product builds it. No trailing newline: the pipe carries none.",
            "                Non-ASCII is escaped as \uXXXX with upper-case hex; an unset knob is absent.",
            "expect.json   - generated by the same test, only where the contract text alone fixes the conclusion",
            "                (higher-schema, unknown-type, status-older-worker, and whether the server is up in",
            "                status-running / status-down). {""refused"":bool,""ok"":bool,""running"":bool|null,",
            "                ""fields"":{..}}; in ""fields"" null means the host must read the member as absent.",
            "                For every other case it carries values of the recorded response and is owed with it.",
            "response.json - NOT PRESENT. Owed by the worker's harness (the only implementation that produces a",
            "                response nobody hand-wrote); status-older-worker and higher-schema need a switch in",
            "                that harness that answers as an older or a newer build. The command is the worker",
            "                owner's to name and goes on a line here when the files arrive.",
            "",
            "Contract   : WORKER-IPC 0.15 + DISK-SHARE 1.4 (pointers: docs/contracts/)",
            "Credentials: synthetic vector literals, never user credentials",
            "Host       : FastMediaSorter_Lite, the Share Manager (src/FastMediaSorterCompanion/Core/WorkerIpc.vb)",
            "Generator  : WorkerIpcConformanceTests.Generate_VectorFolder_WhenAsked (tests/Companion.Tests)",
            "Command    : set FMS_REGENERATE_WORKER_IPC=1, then run tests/Companion.Tests",
            "Pinned by  : WorkerIpcConformanceTests.RequestHalf_MatchesTheProductSerializer_ByteForByte",
            "",
            "Digests",
            "-------",
            ""}) & vbLf
    End Function

    Private Shared Function ProvenanceFooter() As String
        Return vbLf & "Cases without an expect.json above: " & String.Join(", ", VectorCases().Where(Function(kv) kv.Value.Expect Is Nothing).Select(Function(kv) kv.Key)) & vbLf
    End Function

    ''' <summary>The repository root: FMS_REPO_ROOT when set (a run whose build output lives outside the tree,
    ''' e.g. dotnet test --artifacts-path elsewhere), else the first parent of the test binary that holds the solution.</summary>
    Private Shared Function FindRepoRoot() As String
        Dim fromEnvironment As String = Environment.GetEnvironmentVariable("FMS_REPO_ROOT")
        If Not String.IsNullOrEmpty(fromEnvironment) AndAlso File.Exists(Path.Combine(fromEnvironment, "FastMediaSorter.sln")) Then Return fromEnvironment
        Dim dir = New DirectoryInfo(AppContext.BaseDirectory)
        While dir IsNot Nothing
            If File.Exists(Path.Combine(dir.FullName, "FastMediaSorter.sln")) Then Return dir.FullName
            dir = dir.Parent
        End While
        Return Nothing
    End Function

End Class
