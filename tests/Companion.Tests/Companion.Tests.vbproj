<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the Share Manager (.NET 10) core logic.
       Covers the frozen wire/.fmscfg contracts and the per-root param rules that
       the Android release depends on. Runner: `dotnet test` or tools/Run-AllTests.ps1. -->
  <PropertyGroup>
    <!-- Matches the Share Manager's own TFM (its screen source rides the Windows SDK projections,
         ticket 172): a project reference needs the same platform version. -->
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Companion.Tests</RootNamespace>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Selects the namespace import of the test files compiled into BOTH test projects (below). -->
    <DefineConstants>COMPANION_TESTS=True</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FastMediaSorterCompanion\FastMediaSorterCompanion.vbproj" />
  </ItemGroup>

  <!-- The TF call-site scanner (APP-BEHAVIOUR rule 7, ticket 028 Ф-4) is shared with
       Lite.Tests: one parser for both programs, linked rather than copied. -->
  <ItemGroup>
    <Compile Include="..\Lite.Tests\TfCallSiteScanner.vb" Link="Linked\TfCallSiteScanner.vb" />
    <Compile Include="..\Lite.Tests\ExceptionTextScanner.vb" Link="Linked\ExceptionTextScanner.vb" />
    <!-- tools/site-addresses.jsonl reader (ticket 150), shared with Lite.Tests. -->
    <Compile Include="..\Lite.Tests\SiteAddressList.vb" Link="Linked\SiteAddressList.vb" />
    <!-- Ticket 182 L-7: the archive's sources, the unreadable-source rule, the [hosting] block, the state line and
         the no-mail-client decision are tested ONCE and compiled into both test projects, because both programs
         link the same LogPackage / HostingReport / MailSender and must come out with the same sources. -->
    <Compile Include="..\Lite.Tests\LogPackageSourcesTests.vb" Link="Linked\LogPackageSourcesTests.vb" />
    <Compile Include="..\Lite.Tests\HostingReportTests.vb" Link="Linked\HostingReportTests.vb" />
    <!-- Ticket 180: the TLS stub server and the scripted connection of the exchange client tests, one kit for the library
         (Lite.Tests) and the device agent (here). Whole-file "#If Not NETFRAMEWORK". -->
    <Compile Include="..\Lite.Tests\ExchangeWireTestKit.vb" Link="Linked\ExchangeWireTestKit.vb" />
    <Compile Include="..\Lite.Tests\ExchangeRenewalTests.vb" Link="Linked\ExchangeRenewalTests.vb" />
    <Compile Include="..\Lite.Tests\ExchangeVectorReplayTests.vb" Link="Linked\ExchangeVectorReplayTests.vb" />
    <Compile Include="..\Lite.Tests\ExchangeRecordReplayTests.vb" Link="Linked\ExchangeRecordReplayTests.vb" />
    <None Include="..\Lite.Tests\TestData\exchange-vectors\**" Link="TestData\exchange-vectors\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Ticket 177 (dual mode): the committed "today" baseline and its helper are shared with Lite.Tests. The reference
       share's .fmscfg and QR are produced by the real ShareConfigBuilder here (DualModeShareBaselineTests); the folder
       also holds the viewer's capture, so one PROVENANCE.txt covers it all and both suites check it first. -->
  <ItemGroup>
    <Compile Include="..\Lite.Tests\DualModeFixtures.vb" Link="Linked\DualModeFixtures.vb" />
    <None Include="..\Lite.Tests\TestData\dual-mode\**" Link="TestData\dual-mode\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- WORKER-IPC section 7 fixtures (WorkerIpcConformanceTests): the request half is generated
       by the product serializer, the response half is vendored from the worker's owner. -->
  <ItemGroup>
    <None Include="TestData\worker-ipc\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="TestData\broadcast\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
