<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the Fast Media Sorter: Share Manager (.NET 10) core logic.
       Covers the frozen wire/.fmscfg contracts and the per-root param rules that
       the Android release depends on. Runner: `dotnet test` or tools/Run-AllTests.ps1. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Companion.Tests</RootNamespace>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FastMediaSorterCompanion\FastMediaSorterCompanion.vbproj" />
  </ItemGroup>

</Project>
