.vs/

# Build output folders
bin/
obj/
dist/
stage/
# payload/ is generated/vendored and ignored, EXCEPT the committed SFTP worker
# (release CI has no way to build it - it comes from the separate fms_companion repo).
payload/*
!payload/companion/
payload/companion/*
!payload/companion/fms-share-worker.exe
!payload/companion/fms-share-worker.exe.sha256

# Auto-generated version file
src/My Project/VersionInfo.vb

# Claude Code internal state
.claude/

# Locally downloaded build tools
tools/nuget.exe
tools/ocr-cache/

# Local runtime diagnostics
current.log
temp/
manifests/

# Secrets and signing material - pre-empt the leak, never catch it afterwards.
*.pfx
*.snk
*.jks
*.keystore
.env
*token*
*secret*

# Editor workspace settings - local, not shared
.vscode/

# Private working specifications — retained locally, never committed.
/docs/specifications/
