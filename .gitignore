.vs/

# Build output folders
bin/
obj/
dist/
stage/
# payload/ is generated/vendored and ignored, EXCEPT the committed SFTP worker
# (release CI has no way to build it - it comes from the separate fms_companion repo).
payload/*
!payload/companion/
payload/companion/*
!payload/companion/fms-share-worker.exe
!payload/companion/fms-share-worker.exe.sha256
!payload/filedo/
payload/filedo/*
!payload/filedo/filedo.sha256
!payload/filedo/release.json

# Committed test fixtures - the deterministic 7z archives of ArchiveSequentialTests
# (tests/Lite.Tests/TestData/archives/README.txt). Nothing in the test process can
# write a 7z (SharpCompress reads only), so a fresh clone needs them for the suite.
!tests/Lite.Tests/TestData/archives/solid.7z
!tests/Lite.Tests/TestData/archives/nonsolid.7z
!tests/Lite.Tests/TestData/archives/solid-many.7z
!tests/Lite.Tests/TestData/archives/encrypted-headers.7z
!tests/Lite.Tests/TestData/archives/encrypted-data.7z

# Auto-generated version file
src/My Project/VersionInfo.vb

# Claude Code internal state
.claude/

# Locally downloaded build tools
tools/nuget.exe
tools/ocr-cache/

# Local runtime diagnostics
current.log
temp/
manifests/

# Secrets and signing material - pre-empt the leak, never catch it afterwards.
*.pfx
*.snk
*.jks
*.keystore
.env
.env.*
# By secret-bearing NAME or EXTENSION only. The old "*token*" / "*secret*" matched any
# path segment, case-insensitively here (core.ignorecase), so an ordinary source file
# such as SecretStore.vb or TokenCounter.vb was silently never committed: it built
# locally and was missing from every clone and from CI.
*.token
*.secret
*.secrets
secrets.json
client_secret*.json

# Editor workspace settings - local, not shared
.vscode/

# Private working specifications — retained locally, never committed.
/docs/specifications/
