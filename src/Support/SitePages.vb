Option Explicit On
Option Strict On
Option Compare Binary
Option Infer On

''' <summary>
''' Product-site pages the programs link to. Shared by the viewer and the Share Manager
''' (linked, like MailSender.vb), so a page that moves is corrected once.
'''
''' GitHub Pages serves the repository root: English lives there, and every other UI
''' language has its own copy under lang/&lt;code&gt;/, generated by
''' tools/Build-SitePages.ps1. The install-trust page exists in all thirteen languages,
''' so a link to it lands the reader on the copy in the language the program is speaking
''' (INSTALL-TRUST rule 7, ticket 037 Ф-4). The privacy policy is one page under docs/ (English, Russian and Ukrainian
''' switched in-page, so the address the Store listing names never changes) - which is why the viewer's
''' old /privacy.html link answered 404.
'''
''' Every address built here is on tools/site-addresses.jsonl, which also states the locale-sibling
''' form of each page group; tools/Test-SiteAddresses.ps1 resolves them against the page set and the
''' tests compare these constants with the list (ticket 150).
''' </summary>
Public Module SitePages

    ''' <summary>The site root. The path segment is the repository name, and Pages is
    ''' case-sensitive: "FastMediaSorter_Lite", never "_LITE".</summary>
    Public Const SiteRoot As String = "https://serzhyale.github.io/FastMediaSorter_Lite/"

    ''' <summary>The privacy policy - one page (en/ru/uk in-page), the one the Store listing names.</summary>
    Public Const PrivacyPageUrl As String = SiteRoot & "docs/privacy.html"

    ''' <summary>
    ''' The install-trust page in <paramref name="languageCode"/>: why Windows warns about
    ''' the download, exactly what to click, every use of administrator rights and how each
    ''' is taken back. English, and anything empty, is the root page.
    ''' </summary>
    Public Function TrustPageUrl(languageCode As String) As String
        Dim code As String = If(languageCode, "").Trim().ToLowerInvariant()
        If code.Length = 0 OrElse code = "en" Then Return SiteRoot & "trust.html"
        Return SiteRoot & "lang/" & code & "/trust.html"
    End Function

    ''' <summary>The languages that have a generated landing (and trust page) under lang/&lt;code&gt;/.</summary>
    Private ReadOnly LandingCodes As String() = {"ru", "uk", "de", "es", "fr", "it", "pt", "ar", "hi", "bn", "ur", "zh"}

    ''' <summary>
    ''' The page a link should open for the language the program is speaking. Pass the English
    ''' address of a page of this site; what comes back is the same page in <paramref name="languageCode"/>:
    ''' the landing and the trust page have a generated copy per language (lang/&lt;code&gt;/), every other
    ''' page is one file that switches English / Russian / Ukrainian in-page and reads
    ''' <c>?lang=ru</c> / <c>?lang=uk</c> (the same query the installer already appends to the
    ''' Android guide). A language the page does not have, an address that is not on this site and an
    ''' address that already carries a query or a fragment come back unchanged - never a page that
    ''' does not exist.
    ''' </summary>
    Public Function ForLanguage(address As String, languageCode As String) As String
        Dim code As String = If(languageCode, "").Trim().ToLowerInvariant()
        If String.IsNullOrEmpty(address) OrElse code.Length = 0 OrElse code = "en" Then Return address
        If Not address.StartsWith(SiteRoot, StringComparison.Ordinal) Then Return address
        Dim rest As String = address.Substring(SiteRoot.Length)
        If rest.Length = 0 Then
            If Array.IndexOf(LandingCodes, code) >= 0 Then Return SiteRoot & "lang/" & code & "/"
            Return address
        End If
        If rest = "trust.html" Then Return If(Array.IndexOf(LandingCodes, code) >= 0, TrustPageUrl(code), address)
        If rest.IndexOf("?"c) >= 0 OrElse rest.IndexOf("#"c) >= 0 OrElse rest.StartsWith("lang/", StringComparison.Ordinal) Then Return address
        If rest.EndsWith(".html", StringComparison.Ordinal) AndAlso (code = "ru" OrElse code = "uk") Then Return address & "?lang=" & code
        Return address
    End Function

    ''' <summary>The Android app's own site; it has a Russian and a Ukrainian landing, everything else reads the English one.</summary>
    Public Const AndroidAppSiteRoot As String = "https://serzhyale.github.io/FastMediaSorter_mob_v2/"

    Public Function AndroidAppSiteUrl(languageCode As String) As String
        Select Case If(languageCode, "").Trim().ToLowerInvariant()
            Case "ru" : Return AndroidAppSiteRoot & "index-ru.html"
            Case "uk" : Return AndroidAppSiteRoot & "index-uk.html"
            Case Else : Return AndroidAppSiteRoot
        End Select
    End Function

    ''' <summary>The media exchange portal - the shared "media exchange and live broadcast" section of the
    ''' product family. It is published on the Android app's site, so it is deliberately NOT on
    ''' tools/site-addresses.jsonl (that list holds only addresses under <see cref="SiteRoot"/>, and
    ''' tools/Test-SiteAddresses.ps1 resolves them against this repository's page set). The pages are the
    ''' start page (the root itself) and the six of <c>ExchangePortalPages</c>.</summary>
    Public Const ExchangePortalRoot As String = AndroidAppSiteRoot & "docs/media-exchange-portal/"

    ''' <summary>The portal pages a program may link to, besides the start page ("").</summary>
    Private ReadOnly ExchangePortalPages As String() = {"home-network", "windows-servers", "live-broadcast", "exchange-server", "clouds", "editions"}

    ''' <summary>
    ''' A page of the media exchange portal in <paramref name="languageCode"/>. <paramref name="page"/> is ""
    ''' (the start page), <c>home-network</c>, <c>windows-servers</c>, <c>live-broadcast</c>,
    ''' <c>exchange-server</c>, <c>clouds</c> or <c>editions</c>; anything else opens the start page, never
    ''' a page that does not exist. The portal has a Russian (<c>-ru</c>) and a Ukrainian (<c>-uk</c>) copy of
    ''' every page; every other language reads the English one - the root itself for the start page,
    ''' <c>&lt;page&gt;.html</c> for the rest.
    ''' </summary>
    Public Function ExchangePortalUrl(page As String, languageCode As String) As String
        Dim name As String = If(page, "").Trim().ToLowerInvariant()
        If Array.IndexOf(ExchangePortalPages, name) < 0 Then name = ""
        Dim suffix As String = ""
        Select Case If(languageCode, "").Trim().ToLowerInvariant()
            Case "ru" : suffix = "-ru"
            Case "uk" : suffix = "-uk"
        End Select
        If name.Length = 0 Then
            Return If(suffix.Length = 0, ExchangePortalRoot, ExchangePortalRoot & "index" & suffix & ".html")
        End If
        Return ExchangePortalRoot & name & suffix & ".html"
    End Function

    ''' <summary>The document-translation project's site: Russian and Ukrainian are a query on the root page, the
    ''' other eleven languages a folder.</summary>
    Public Const DocHtmlTranslateSiteRoot As String = "https://serzhyale.github.io/doc-html-translate/"

    Public Function DocHtmlTranslateSiteUrl(languageCode As String) As String
        Dim code As String = If(languageCode, "").Trim().ToLowerInvariant()
        If code = "ru" OrElse code = "uk" Then Return DocHtmlTranslateSiteRoot & "?l=" & code
        If Array.IndexOf(LandingCodes, code) >= 0 Then Return DocHtmlTranslateSiteRoot & code & "/"
        Return DocHtmlTranslateSiteRoot
    End Function

End Module
