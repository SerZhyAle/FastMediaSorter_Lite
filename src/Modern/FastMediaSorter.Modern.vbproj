<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fast Media Sorter &amp; Sharing for Windows - the .NET 10 x64 mainline
    (SPECIFICATION_DOTNET10_MODERN_BUILD.md). Compiles the SAME sources as the
    frozen net48 project one directory up (two projects, one tree - epic §3);
    divergent subsystems switch on #If NETFRAMEWORK seams. Lives in its own
    folder so its SDK-style obj/ never collides with the old-style project's.
    Frozen anchors ride along unchanged: exe name, mutex, registry, ProgIDs.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <DocnetRuntime>win-x64</DocnetRuntime>
    <RootNamespace>fmsl</RootNamespace>
    <AssemblyName>FastMediaSorter_LITE</AssemblyName>
    <StartupObject>fmsl.My.MyApplication</StartupObject>
    <MyType>WindowsForms</MyType>

    <!-- Repo-wide VB strictness (CLAUDE.md "Code Style & Constraints"). -->
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <OptionCompare>Binary</OptionCompare>
    <WarningsAsErrors>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036</WarningsAsErrors>
    <!-- WFO1000 (designer-serialization hints) fires on VB WithEvents fields,
         which compile to properties; these forms are runtime-built, never
         designer-serialized, so the diagnostic is noise here. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>

    <ApplicationIcon>..\..\assets\icons\Fast_Media_Sorter.ico</ApplicationIcon>
    <!-- DPI awareness is selected by ApplyApplicationDefaults (PerMonitorV2 after
         the modern chrome migration). No manifest override: the x86 executable
         retains its shipped DPI-unaware behavior independently. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- Everything is included explicitly below: the sources live OUTSIDE this
         project folder, and default globs would double-include local files. -->
    <EnableDefaultItems>false</EnableDefaultItems>

    <!-- Assembly metadata (the net48 project reads these from AssemblyInfo.vb,
         which is deliberately NOT linked here - the SDK generates the attributes). -->
    <Product>Fast Media Sorter &amp; Sharing for Windows</Product>
    <AssemblyTitle>Fast Media Sorter &amp; Sharing for Windows</AssemblyTitle>
    <Company>SZA</Company>
    <!-- Verbatim from the legacy AssemblyInfo.vb - keep the two exes' metadata
         identical (bump both together when the owner decides). -->
    <Copyright>Copyright © 2013-2025</Copyright>
    <Description>sza@ukr.net</Description>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- Culture behavior parity: .NET 5+ sorts strings with ICU while net48 uses
         NLS - the "abc"/"xyz" file sorts would order punctuated/diacritic names
         differently between the builds. Force NLS so both sort identically. -->
    <RuntimeHostConfigurationOption Include="System.Globalization.UseNls" Value="true" />
  </ItemGroup>

  <!-- Same YY.M.D.HHmm auto-version as the net48 UpdateVersion target; a release
       build can override it with -p:ReleaseVersion=... exactly like legacy. -->
  <PropertyGroup>
    <AutoVersion Condition="'$(ReleaseVersion)' != ''">$(ReleaseVersion)</AutoVersion>
    <AutoVersion Condition="'$(AutoVersion)' == ''">$([System.DateTime]::Now.ToString("yy")).$([System.DateTime]::Now.Month).$([System.DateTime]::Now.Day).$([System.DateTime]::Now.ToString("HHmm"))</AutoVersion>
    <Version>$(AutoVersion)</Version>
    <AssemblyVersion>$(AutoVersion)</AssemblyVersion>
    <FileVersion>$(AutoVersion)</FileVersion>
  </PropertyGroup>

  <!-- Publish model: self-contained single-file x64 (epic §8.1). Native payload
       (libvlc plugin tree, tesseract) must stay as loose files next to the exe -
       LibVLC discovers plugins on disk - hence no self-extract bundling. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- x64-only build: skip the win-x86 half of the LibVLC payload. -->
  <PropertyGroup>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Project-level VB imports the shared sources rely on. The SDK's implicit
         VB import list does NOT cover the WinForms namespaces the old-style
         project imported explicitly - mirror those here. -->
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared tree (one directory up). Divergent files compile to nothing
         here via whole-file #If NETFRAMEWORK blocks, so no per-file excludes
         beyond the sibling projects and the attribute files the SDK replaces. -->
    <Compile Include="..\**\*.vb" Exclude="..\Modern\**;..\FastMediaSorterCompanion\**;..\obj\**;..\bin\**;..\My Project\AssemblyInfo.vb;..\My Project\VersionInfo.vb" />
    <Compile Include="ModernAssemblyInfo.vb" />
  </ItemGroup>

  <ItemGroup>
    <!-- VB manifest resource naming is RootNamespace.FileName (folder-agnostic),
         so linked resx land under the exact names the net48 build produces. -->
    <EmbeddedResource Include="..\Main_Form.resx" />
    <EmbeddedResource Include="..\Table_Form.resx" />
    <EmbeddedResource Include="..\My Project\Resources.resx" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled UI assets served by RuntimeBootstrap.OpenBundledAsset - the
         LogicalName values are the frozen lookup keys, same as net48. The
         FmsPayloadmanaged/* assembly payload is net48-only (ILMerge era) and is
         deliberately absent here: publish lays managed deps down natively. -->
    <EmbeddedResource Include="..\..\assets\flags\*.png">
      <LogicalName>FmsPayloadflags/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\help\port-forward.html">
      <LogicalName>FmsPayloadhelp/port-forward.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\help-map.json">
      <LogicalName>help-map.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\icons\doc-html-translate.png">
      <LogicalName>FmsPayloadicons/doc-html-translate.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\glyphs\*.svg">
      <!-- MSBuild reads the penultimate extension of a resource file name as a culture: "action.run.svg" is
           Rundi ("run"), so that glyph was silently moved to a satellite assembly and left out of the exe. -->
      <WithCulture>false</WithCulture>
      <LogicalName>FmsPayloadglyphs/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Loose flag files next to the exe (same as the net48 Content items). -->
    <Content Include="..\..\assets\flags\*.png">
      <Link>flags\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Modern image stack (epic §6.1): ImageSharp 3.x is the primary decoder
         (animated WEBP/APNG without OS codecs). Magick.NET is the O-3 fallback
         behind the same IImageDecoder seam: it decodes what ImageSharp cannot -
         AVIF/HEIC/HEIF (phone photos) - with no OS codec involved (no Store
         "HEVC Video Extensions" needed). Its native dll publishes loose next to
         the exe, same as libvlc. -->
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="Magick.NET-Q8-x64" Version="14.15.0" />

    <!-- Single video engine (epic §6.2) - same versions the net48 build vendors. -->
    <PackageReference Include="LibVLCSharp" Version="3.9.3" />
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.9.3" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />

    <!-- OCR engine, unchanged (epic §4). -->
    <PackageReference Include="Tesseract" Version="5.2.0" />

    <!-- Archive browsing (010_SPECIFICATION_ARCHIVE_BROWSING_DOTNET10.md §8). ONE library
         for every container - ZIP/CBZ now, 7z/RAR/CBR in Ф2 - because two code paths
         for one job are two sets of bugs. Fully managed, no native part, so it costs
         the single-file publish very little. MIT; the notice ships in
         THIRD-PARTY-NOTICES.txt (canon invariant 12). Modern only: the x86 project
         must NOT reference it - archive browsing does not exist there. -->
    <PackageReference Include="SharpCompress" Version="0.50.4" />

    <!-- Secure containers (026_SPECIFICATION_SECURE_CONTAINER_FD_SEC_DOTNET10.md §4.4).
         The .NET base class library carries NONE of the four primitives the FDSEC format
         needs: no Argon2 of any kind, no BLAKE2b, and System.Security.Cryptography's
         ChaCha20Poly1305 is the 12-byte IETF variant backed on Windows by a CNG algorithm
         our support floor (Windows 10 1607) predates. BouncyCastle carries all four and
         is fully managed, which keeps the single-file publish a single file and lays
         nothing down per architecture next to the exe. MIT; the notice ships in
         THIRD-PARTY-NOTICES.txt (canon invariant 12). Modern only: the x86 project must
         NOT reference it - src/Secure is whole-file "#If Not NETFRAMEWORK" there. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />

    <!-- SSH.NET for SFTP resource provider (007_SPECIFICATION_REMOTE_RESOURCES_SFTP_SMB_DOTNET10.md).
         MIT license; recorded in THIRD-PARTY-NOTICES.txt. Modern only. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />

    <!-- QR decoding and rendering (227_SPECIFICATION_PHONE_CONNECTION_CODE_AND_QR_INTAKE.md).
         ZXing.Net (Apache-2.0) and QRCoder (MIT). Modern only: the x86 project gets nothing. -->
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.16" />
    <PackageReference Include="QRCoder" Version="1.4.3" />
  </ItemGroup>

</Project>
