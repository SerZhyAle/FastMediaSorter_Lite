Option Strict On

Imports System.Collections.Generic
Imports System.Drawing

' LETTERBOX-BARS 0.1 and LETTERBOX-HALO 0.1 - the pure math, once.
'
' This product OWNS both contracts (catalog folder letterbox-fill/), so the numbers below are
' the contract's own and a change to any of them is an AMENDMENT IN THE CATALOG FIRST (a version
' bump, a log row, vectors regenerated by reference/letterbox-fill.ps1), then this file.
'
' Rung 1 of section 5 of the contract: every constant of sections 2-3 lives here, under a
' comment citing the rule, and every function below reproduces the catalog's vectors
' (tests/Lite.Tests/LetterboxFillConformanceTests.vb runs all of them, under net48 and net10).
'
' WHAT IS HERE: only arithmetic - ints, doubles, arrays and System.Drawing.Color / Rectangle as
' plain value types. No Graphics, no WinForms, no clock. The GDI+ glue stays where it was
' (Main_Form.PerspectiveBackground.vb paints the bands, Main_Form.PerspectiveHalo.vb paints the
' ramp and runs the timer; EdgeSampler.vb reads the displayed pixels) and CALLS this class, so
' the number a test proves is the number the screen uses.
'
' ROUNDING IS PART OF THE CONTRACT: wherever a rule says "round" it is half to even
' (Math.Round / VB CInt on a Double both are). Do not "fix" one to half away from zero.
'
' Shared by both exes: nothing here is mainline-only, so there is no NETFRAMEWORK seam. The halo
' functions are used only by the .NET 10 viewer (the x86 fallback draws the bars flat, which the
' contract allows) but the file is deliberately one piece - the halo is built on these bars.
Friend NotInheritable Class LetterboxFillMath

    ' A class of shared members, not a Module: a Module's members are visible unqualified all over
    ' the namespace, and these names (SeamBand, EdgeSpread, HaloEase..) should always be read
    ' with the contract's name in front of them.
    Private Sub New()
    End Sub

    ''' <summary>The catalog version of BOTH contracts this file was written against (they move
    ''' together in letterbox-fill/README.md). The vendored vectors name the same version, and the
    ''' conformance test asserts it, so a regenerated catalog file cannot be re-vendored unnoticed.</summary>
    Friend Const ContractVersion As String = "0.1"

    ' =========================================================================================
    ' LETTERBOX-BARS - constants
    ' =========================================================================================

    ''' <summary>LETTERBOX-BARS rule 1: the two aspect ratios are compared at this many decimals
    ''' (half to even); bars exist only when they differ.</summary>
    Friend Const AspectDecimals As Integer = 2

    ''' <summary>LETTERBOX-BARS rule 3: the edge list is read this many pixels IN from the
    ''' outermost displayed column or row, when the displayed side is at least 3 px - the
    ''' outermost downscaled line folds in the darkest border and vignette pixels.</summary>
    Friend Const EdgeInset As Integer = 1

    ''' <summary>LETTERBOX-BARS rule 5: a bar reaches this many px under the photo, hidden by it,
    ''' so that no rounding can open a gap.</summary>
    Friend Const EdgeOverlap As Integer = 2

    ''' <summary>LETTERBOX-BARS rule 7: the seam band - the px immediately outside the photo that
    ''' are filled with the RAW (unsmoothed) edge.</summary>
    Friend Const SeamBand As Integer = 2

    ''' <summary>LETTERBOX-BARS rule 4: every this-many-th entry of the edge list is a sample.
    ''' (<c>step_size_while_color_Search</c> in the owner's code.)</summary>
    Friend Const SampleStep As Integer = 100

    ''' <summary>LETTERBOX-BARS rules 4 and 5: the share (percent) of samples dropped from each end
    ''' of a sorted channel. Rule 4 also compares the SAMPLE COUNT against this same number
    ''' ("more than 7 samples"), exactly as the owner's code does - one constant, two uses.
    ''' (<c>percent_of_color_smooth_To_Remove</c>.)</summary>
    Friend Const TrimPercent As Integer = 7

    ''' <summary>LETTERBOX-BARS rule 4: a band is uniform when its spread is under this percent of
    ''' 3 x 255. (<c>percent_of_color_deviation</c>.)</summary>
    Friend Const DeviationPercent As Integer = 4

    ''' <summary>LETTERBOX-BARS rule 4: the threshold the spread is compared against,
    ''' 0.04 x 3 x 255 = 30.6. Same expression, same order, as the owner's code.</summary>
    Friend Const SpreadThreshold As Double = (DeviationPercent / 100.0) * 255 * 3

    ''' <summary>LETTERBOX-BARS rule 6: the smoothing radius is
    ''' <c>round(n * factor) + 1</c> for an edge list of n entries. (<c>smoothIndex</c>.)</summary>
    Friend Const SmoothFactor As Double = 0.0006

    ' --- host conditions (LETTERBOX-BARS section 2, "chosen by the owner, recommended, not
    '     derived"; a product may choose its own and says so in its registry row) -------------

    ''' <summary>Host condition: a redraw closer than this to the previous one is deferred, and
    ''' the last request always lands (a trailing timer). (<c>how_long_wait_before_draw_perspective</c>.)</summary>
    Friend Const RedrawThrottleMs As Integer = 50

    ''' <summary>Host condition: a slideshow whose interval is BELOW this gets no bars (the flips
    ''' are too fast to be worth the pixel work); at or above it they are drawn. The same owner
    ''' rule gates the dynamic-colour analysis. (<c>slideshow_limit_to_change_color</c>.)</summary>
    Friend Const FastSlideshowIntervalMs As Integer = 5000

    ' =========================================================================================
    ' LETTERBOX-HALO - constants
    ' =========================================================================================

    ''' <summary>LETTERBOX-HALO rule 2: the fade is <c>255 * d^gamma</c> of the background over
    ''' the bars. (<c>halo_Falloff_Gamma</c>.)</summary>
    Friend Const FalloffGamma As Double = 1.4

    ''' <summary>LETTERBOX-HALO rule 2: the curve is represented by this many stops, at
    ''' <c>d = j / (stops - 1)</c>, interpolated in a straight line between them.
    ''' (<c>halo_Blend_Stops</c>.)</summary>
    Friend Const BlendStops As Integer = 12

    ''' <summary>LETTERBOX-HALO rule 5: the growth duration at the SLOW speed, the timing the
    ''' effect shipped with; medium halves it (the default) and fast quarters it.
    ''' (<c>halo_Duration_Slow_Ms</c>.)</summary>
    Friend Const DurationSlowMs As Double = 350.0

    ''' <summary>LETTERBOX-HALO rule 6: a frame is drawn at most this often; progress is taken
    ''' from the clock, so a faster speed draws FEWER frames, not harder ones.
    ''' (<c>halo_Frame_Interval_Ms</c>.)</summary>
    Friend Const FrameIntervalMs As Integer = 15

    ' =========================================================================================
    ' LETTERBOX-BARS - rules
    ' =========================================================================================

    ''' <summary>Which axis the bars are on (rule 1).</summary>
    Friend Enum LetterboxAxis
        ''' <summary>No bars: the aspect ratios agree at two decimals, or a side is too small.</summary>
        None = 0
        ''' <summary>Bars left and right (the image is relatively narrower than the surface).</summary>
        Pillarbox = 1
        ''' <summary>Bars top and bottom.</summary>
        Letterbox = 2
    End Enum

    ''' <summary>How one band is filled (rule 4).</summary>
    Friend Enum LetterboxBandMode
        Uniform = 0
        Perspective = 1
    End Enum

    ''' <summary>The four painted regions of one axis, in the axis's own coordinate (x for a
    ''' pillarbox, y for a letterbox), in painting order: bars first, then the seam bands (rules
    ''' 5 and 7). A length of 0 means nothing to paint.</summary>
    Friend Structure LetterboxBands
        Friend NearBarStart As Integer
        Friend NearBarLength As Integer
        Friend FarBarStart As Integer
        Friend FarBarLength As Integer
        Friend NearSeamStart As Integer
        Friend NearSeamLength As Integer
        Friend FarSeamStart As Integer
        Friend FarSeamLength As Integer
    End Structure

    ''' <summary>
    ''' LETTERBOX-BARS rule 1. Bars exist only when the aspect ratios differ at two decimals
    ''' (half to even), and never when the image is 1 px or less on a side or the surface is 2 px
    ''' or less. A pillarbox when <c>Ws/Hs &lt; W/H</c> (compared UNROUNDED), a letterbox when not.
    ''' </summary>
    Friend Shared Function AxisOf(imageWidth As Integer, imageHeight As Integer,
                           surfaceWidth As Integer, surfaceHeight As Integer) As LetterboxAxis
        If imageWidth <= 1 OrElse imageHeight <= 1 OrElse surfaceWidth <= 2 OrElse surfaceHeight <= 2 Then
            Return LetterboxAxis.None
        End If

        Dim imageAspect As Double = CDbl(imageWidth) / CDbl(imageHeight)
        Dim surfaceAspect As Double = CDbl(surfaceWidth) / CDbl(surfaceHeight)

        If Math.Round(imageAspect, AspectDecimals, MidpointRounding.ToEven) =
           Math.Round(surfaceAspect, AspectDecimals, MidpointRounding.ToEven) Then
            Return LetterboxAxis.None
        End If

        Return If(imageAspect < surfaceAspect, LetterboxAxis.Pillarbox, LetterboxAxis.Letterbox)
    End Function

    ''' <summary>
    ''' LETTERBOX-BARS rule 2. The image is fitted, centred, by one scale:
    ''' <c>s = min(W/Ws, H/Hs)</c>, <c>w = clamp(round(Ws*s), 1, W)</c>, <c>h</c> likewise (half to
    ''' even), <c>left = floor((W-w)/2)</c>, <c>top = floor((H-h)/2)</c>. It ENLARGES a small
    ''' image, exactly as <c>PictureBoxSizeMode.Zoom</c> paints it. <c>Rectangle.Empty</c> for a
    ''' non-positive size.
    ''' </summary>
    Friend Shared Function FitRectangle(imageWidth As Integer, imageHeight As Integer,
                                 surfaceWidth As Integer, surfaceHeight As Integer) As Rectangle
        If imageWidth <= 0 OrElse imageHeight <= 0 OrElse surfaceWidth <= 0 OrElse surfaceHeight <= 0 Then
            Return Rectangle.Empty
        End If

        Dim scale As Double = Math.Min(surfaceWidth / CDbl(imageWidth), surfaceHeight / CDbl(imageHeight))
        Dim w As Integer = Math.Max(1, Math.Min(surfaceWidth, CInt(Math.Round(imageWidth * scale))))
        Dim h As Integer = Math.Max(1, Math.Min(surfaceHeight, CInt(Math.Round(imageHeight * scale))))

        Return New Rectangle((surfaceWidth - w) \ 2, (surfaceHeight - h) \ 2, w, h)
    End Function

    ''' <summary>
    ''' LETTERBOX-BARS rule 3. The index, in the DISPLAYED image (already resampled to w x h), of the
    ''' column (row) that feeds the near (<paramref name="farEdge"/> False) or far edge list:
    ''' one px in from the edge, or the edge itself when the side is under 3 px.
    ''' </summary>
    Friend Shared Function EdgeIndex(displayedSize As Integer, farEdge As Boolean) As Integer
        Dim inset As Integer = If(displayedSize >= 3, EdgeInset, 0)
        Return If(farEdge, displayedSize - 1 - inset, inset)
    End Function

    ''' <summary>
    ''' LETTERBOX-BARS rule 3. Which displayed row (column) feeds surface row (column)
    ''' <paramref name="surfaceIndex"/>: <c>clamp(i - offset, 0, size - 1)</c>, so the edge list has
    ''' exactly as many entries as the surface has rows.
    ''' </summary>
    Friend Shared Function EdgeSourceIndex(surfaceIndex As Integer, imageOffset As Integer, displayedSize As Integer) As Integer
        Return Math.Max(0, Math.Min(surfaceIndex - imageOffset, displayedSize - 1))
    End Function

    ''' <summary>
    ''' LETTERBOX-BARS rule 4. The indices sampled from an edge list of <paramref name="count"/>
    ''' entries: every <see cref="SampleStep"/>-th from 0; the last entry alone when that yields none.
    ''' </summary>
    Friend Shared Function SteppedIndices(count As Integer) As List(Of Integer)
        Dim indices As New List(Of Integer)()

        For i As Integer = 0 To count - 1 Step SampleStep
            indices.Add(i)
        Next

        If indices.Count = 0 AndAlso count > 0 Then
            indices.Add(count - 1)
        End If

        Return indices
    End Function

    ''' <summary>LETTERBOX-BARS rule 4. The sampled colours of an edge list (see
    ''' <see cref="SteppedIndices"/>).</summary>
    Friend Shared Function SteppedColors(edgeColors As IReadOnlyList(Of Color)) As List(Of Color)
        Dim samples As New List(Of Color)()

        For Each index As Integer In SteppedIndices(edgeColors.Count)
            samples.Add(edgeColors(index))
        Next

        Return samples
    End Function

    ''' <summary>
    ''' LETTERBOX-BARS rule 4. The spread of the sampled colours: the sum over R, G, B of
    ''' <c>max - min</c> after sorting each channel and, when there are MORE than
    ''' <see cref="TrimPercent"/> samples, dropping <c>floor(n * 7 / 100)</c> from each end.
    ''' 0 for an empty list.
    ''' </summary>
    Friend Shared Function EdgeSpread(sampledColors As IReadOnlyList(Of Color)) As Integer
        Dim n As Integer = sampledColors.Count
        If n = 0 Then Return 0

        Dim reds(n - 1) As Integer
        Dim greens(n - 1) As Integer
        Dim blues(n - 1) As Integer
        For i As Integer = 0 To n - 1
            Dim c As Color = sampledColors(i)
            reds(i) = c.R
            greens(i) = c.G
            blues(i) = c.B
        Next
        Array.Sort(reds)
        Array.Sort(greens)
        Array.Sort(blues)

        Dim trim As Integer = 0
        If n > TrimPercent Then
            trim = CInt(Math.Floor(n * TrimPercent / 100.0))
        End If

        Dim last As Integer = n - 1 - trim
        Return (reds(last) - reds(trim)) + (greens(last) - greens(trim)) + (blues(last) - blues(trim))
    End Function

    ''' <summary>LETTERBOX-BARS rule 4. A band is uniform when its spread is below
    ''' <see cref="SpreadThreshold"/>, perspective otherwise.</summary>
    Friend Shared Function ModeOf(sampledColors As IReadOnlyList(Of Color)) As LetterboxBandMode
        Return If(EdgeSpread(sampledColors) < SpreadThreshold, LetterboxBandMode.Uniform, LetterboxBandMode.Perspective)
    End Function

    ''' <summary>
    ''' LETTERBOX-BARS rule 5. The colour of a uniform band: the per-channel trimmed mean of the
    ''' sampled colours - sort, drop <c>min(floor(n * 7 / 100), floor((n - 1) / 2))</c> from each
    ''' end, average, round half to even. Opaque; black for an empty list.
    ''' </summary>
    Friend Shared Function TrimmedMeanColor(sampledColors As IReadOnlyList(Of Color)) As Color
        Dim n As Integer = sampledColors.Count
        If n = 0 Then Return Color.Black

        Dim reds(n - 1) As Integer
        Dim greens(n - 1) As Integer
        Dim blues(n - 1) As Integer
        For i As Integer = 0 To n - 1
            Dim c As Color = sampledColors(i)
            reds(i) = c.R
            greens(i) = c.G
            blues(i) = c.B
        Next

        Return Color.FromArgb(255, TrimmedChannelMean(reds), TrimmedChannelMean(greens), TrimmedChannelMean(blues))
    End Function

    ''' <summary>Sorts the channel in place, trims, averages, rounds half to even (rule 5).</summary>
    Private Shared Function TrimmedChannelMean(values As Integer()) As Integer
        Array.Sort(values)

        Dim n As Integer = values.Length
        Dim trim As Integer = CInt(Math.Floor(n * TrimPercent / 100.0))
        trim = Math.Min(trim, Math.Max(0, (n - 1) \ 2))

        Dim sum As Long = 0
        For i As Integer = trim To n - 1 - trim
            sum += values(i)
        Next

        Return CInt(Math.Round(sum / CDbl(n - 2 * trim), MidpointRounding.ToEven))
    End Function

    ''' <summary>
    ''' LETTERBOX-BARS rule 6. The box-filter radius for an edge list of n entries:
    ''' <c>round(n * 0.0006) + 1</c>, half to even - 7500 entries give 5, because
    ''' <c>round(4.5)</c> is 4.
    ''' </summary>
    Friend Shared Function SmoothRadius(count As Integer) As Integer
        Return CInt(Math.Round(count * SmoothFactor, MidpointRounding.ToEven)) + 1
    End Function

    ''' <summary>
    ''' LETTERBOX-BARS rule 6. The box filter over the WHOLE edge list: entry i becomes the
    ''' per-channel FLOOR mean of entries <c>[max(0, i - r), min(n - 1, i + r)]</c>, opaque. A list
    ''' shorter than 3, or a radius under 1, is returned as it is (the same instance).
    ''' </summary>
    Friend Shared Function SmoothColors(colors As List(Of Color), radius As Integer) As List(Of Color)
        If radius < 1 OrElse colors.Count < 3 Then Return colors

        Dim result As New List(Of Color)(colors.Count)
        For i As Integer = 0 To colors.Count - 1
            Dim rSum As Integer = 0
            Dim gSum As Integer = 0
            Dim bSum As Integer = 0
            Dim first As Integer = Math.Max(0, i - radius)
            Dim last As Integer = Math.Min(colors.Count - 1, i + radius)
            For j As Integer = first To last
                rSum += colors(j).R
                gSum += colors(j).G
                bSum += colors(j).B
            Next
            Dim count As Integer = last - first + 1
            result.Add(Color.FromArgb(255, rSum \ count, gSum \ count, bSum \ count))
        Next

        Return result
    End Function

    ''' <summary>
    ''' LETTERBOX-BARS rules 5 and 7. The regions of one axis: the near bar
    ''' <c>[0, min(S, start + 2))</c>, the far bar <c>[max(0, end - 2), S)</c> (the 2 px under the
    ''' photo are hidden by it), and then the seam bands <c>[start - min(2, start), start)</c> and
    ''' <c>[end, end + min(2, S - end))</c>. Pass x and width for a pillarbox, y and height for a
    ''' letterbox.
    ''' </summary>
    Friend Shared Function BarBands(surfaceSize As Integer, imageStart As Integer, imageLength As Integer) As LetterboxBands
        Dim imageEnd As Integer = imageStart + imageLength
        Dim bands As LetterboxBands

        bands.NearBarStart = 0
        bands.NearBarLength = Math.Min(surfaceSize, imageStart + EdgeOverlap)

        bands.FarBarStart = Math.Max(0, imageEnd - EdgeOverlap)
        bands.FarBarLength = surfaceSize - bands.FarBarStart

        bands.NearSeamLength = Math.Min(SeamBand, imageStart)
        bands.NearSeamStart = imageStart - bands.NearSeamLength

        bands.FarSeamStart = imageEnd
        bands.FarSeamLength = Math.Min(SeamBand, surfaceSize - imageEnd)

        Return bands
    End Function

    ''' <summary>
    ''' Host condition (section 2). True when a slideshow does NOT forbid the bars: no slideshow,
    ''' or an interval of <see cref="FastSlideshowIntervalMs"/> or more.
    ''' </summary>
    Friend Shared Function SlideshowAllowsBars(isSlideshow As Boolean, intervalMs As Integer) As Boolean
        Return Not isSlideshow OrElse intervalMs >= FastSlideshowIntervalMs
    End Function

    ' =========================================================================================
    ' LETTERBOX-HALO - rules
    ' =========================================================================================

    ''' <summary>
    ''' LETTERBOX-HALO rule 5. The growth duration for a stored speed key: 350 ms for
    ''' <c>slow</c>, 87.5 ms for <c>fast</c>, 175 ms for <c>medium</c> and for anything else -
    ''' missing, empty, corrupt. Trimmed and case-insensitive, like the setting's own reader.
    ''' </summary>
    Friend Shared Function HaloDurationMs(speedKey As String) As Double
        Select Case If(speedKey, "").Trim().ToLowerInvariant()
            Case "slow" : Return DurationSlowMs
            Case "fast" : Return DurationSlowMs / 4.0
            Case Else : Return DurationSlowMs / 2.0
        End Select
    End Function

    ''' <summary>
    ''' LETTERBOX-HALO rule 4. Quadratic ease-out, <c>1 - (1 - p)^2</c> with <c>p</c> clamped to
    ''' [0, 1]: the halo springs out and settles instead of stopping dead at the screen edge.
    ''' </summary>
    Friend Shared Function HaloEase(progress As Double) As Double
        Dim p As Double = Math.Max(0.0, Math.Min(1.0, progress))
        Return 1.0 - (1.0 - p) * (1.0 - p)
    End Function

    ''' <summary>
    ''' LETTERBOX-HALO rule 3. How many px next to the photo the ramp covers at eased growth
    ''' <paramref name="eased"/>: <c>floor(L * e)</c>. Every pixel at or past it is solid
    ''' background.
    ''' </summary>
    Friend Shared Function HaloReach(barLength As Integer, eased As Double) As Integer
        Return CInt(Math.Floor(barLength * Math.Max(0.0, Math.Min(1.0, eased))))
    End Function

    ''' <summary>
    ''' LETTERBOX-HALO rule 2. The alpha (0..255, of the BACKGROUND colour over the bar) of the stop
    ''' at normalized distance <paramref name="distance"/> from the photo:
    ''' <c>round(255 * d^1.4)</c>, half to even, clamped. The gradient brush's stop table is built
    ''' from exactly this.
    ''' </summary>
    Friend Shared Function HaloStopAlpha(distance As Double) As Integer
        Dim alpha As Integer = CInt(Math.Round(255.0 * Math.Pow(distance, FalloffGamma)))
        Return Math.Max(0, Math.Min(255, alpha))
    End Function

    ''' <summary>LETTERBOX-HALO rule 2. The 12 stop alphas, at <c>d = j / 11</c>.</summary>
    Friend Shared Function HaloStopAlphas() As Integer()
        Return DirectCast(stopTable.Clone(), Integer())
    End Function

    ''' <summary>The stop table, built once from <see cref="HaloStopAlpha"/> (rule 2).</summary>
    Private Shared ReadOnly stopTable As Integer() = BuildStopTable()

    Private Shared Function BuildStopTable() As Integer()
        Dim alphas(BlendStops - 1) As Integer
        For j As Integer = 0 To BlendStops - 1
            alphas(j) = HaloStopAlpha(j / (BlendStops - 1.0))
        Next
        Return alphas
    End Function

    ''' <summary>
    ''' LETTERBOX-HALO rule 2. The alpha at normalized distance <paramref name="distance"/> in
    ''' [0, 1]: a straight line between the stops - what the gradient brush paints. Using the exact
    ''' curve instead is conforming (the table is within <see cref="HaloStopApproximationMaxError"/>).
    ''' </summary>
    Friend Shared Function HaloAlphaAt(distance As Double) As Double
        Dim alphas As Integer() = stopTable
        Dim d As Double = Math.Max(0.0, Math.Min(1.0, distance))
        Dim segment As Integer = Math.Min(BlendStops - 2, CInt(Math.Floor(d * (BlendStops - 1))))
        Dim d0 As Double = segment / (BlendStops - 1.0)
        Dim d1 As Double = (segment + 1) / (BlendStops - 1.0)
        Dim a0 As Integer = alphas(segment)
        Dim a1 As Integer = alphas(segment + 1)
        Return a0 + (a1 - a0) * ((d - d0) / (d1 - d0))
    End Function

    ''' <summary>
    ''' LETTERBOX-HALO rules 2 and 3. The background alpha of every pixel of one bar of length
    ''' <paramref name="barLength"/>, index 0 touching the photo. A ramp pixel samples its centre,
    ''' <c>(k + 0.5) / reach</c>; a pixel at or past the front (<c>k &gt;= reach</c>) is solid
    ''' background, 255. This is the executable form of the rule, and what the vectors check. The
    ''' screen does NOT call it: it paints through a gradient brush built from the same stop
    ''' alphas, and comparing that brush to this row is rung 2 (unmeasured).
    ''' </summary>
    Friend Shared Function HaloAlphaRow(barLength As Integer, eased As Double) As Double()
        Dim reach As Integer = HaloReach(barLength, eased)
        Dim row(Math.Max(0, barLength) - 1) As Double
        For k As Integer = 0 To barLength - 1
            row(k) = If(k >= reach, 255.0, HaloAlphaAt((k + 0.5) / reach))
        Next
        Return row
    End Function

    ''' <summary>
    ''' LETTERBOX-HALO rule 7. The opacity the previous frame is laid over the whole surface at:
    ''' <c>1 - e</c>, clamped to [0, 1] - it fades with TIME, never with distance, and at
    ''' <c>e = 1</c> draws nothing.
    ''' </summary>
    Friend Shared Function UnderlayOpacity(eased As Double) As Double
        Return Math.Max(0.0, Math.Min(1.0, 1.0 - eased))
    End Function

    ''' <summary>
    ''' LETTERBOX-HALO rule 6. Progress of a running growth from the CLOCK, never from a frame count:
    ''' <c>elapsed / duration</c>, and the frame that reaches 1 is drawn at exactly 1 and ends the
    ''' growth (<paramref name="finished"/>). A non-positive duration reads as the slow one.
    ''' </summary>
    Friend Shared Function HaloProgress(elapsedMs As Double, durationMs As Double, ByRef finished As Boolean) As Double
        Dim duration As Double = If(durationMs > 0.0, durationMs, DurationSlowMs)
        Dim progress As Double = elapsedMs / duration

        finished = progress >= 1.0
        If finished Then progress = 1.0

        Return progress
    End Function

    ''' <summary>
    ''' LETTERBOX-HALO rule 6. The progress values an IDEAL timer produces: the start frame (0),
    ''' then one per <see cref="FrameIntervalMs"/>, the last clamped to exactly 1. A fast speed
    ''' draws the start frame plus 6, not the same frames harder.
    ''' </summary>
    Friend Shared Function HaloFrameSchedule(durationMs As Double) As List(Of Double)
        Dim schedule As New List(Of Double)()
        schedule.Add(0.0)

        ' The cap is a guard against a duration that never finishes (infinite): 10000 frames is
        ' 150 s of 15 ms steps, far past any real growth.
        Dim elapsed As Integer = 0
        Do
            elapsed += FrameIntervalMs
            Dim finished As Boolean
            schedule.Add(HaloProgress(elapsed, durationMs, finished))
        Loop While schedule(schedule.Count - 1) < 1.0 AndAlso schedule.Count < 10000

        Return schedule
    End Function

    ''' <summary>
    ''' LETTERBOX-HALO rule 2 (informational). The largest gap between the stop table and the exact
    ''' curve <c>255 * d^1.4</c>, over 10001 points, to 4 decimals - 1.1455 alpha levels.
    ''' </summary>
    Friend Shared Function HaloStopApproximationMaxError() As Double
        Dim worst As Double = 0.0
        For i As Integer = 0 To 10000
            Dim d As Double = i / 10000.0
            Dim gap As Double = Math.Abs(HaloAlphaAt(d) - 255.0 * Math.Pow(d, FalloffGamma))
            If gap > worst Then worst = gap
        Next
        Return Math.Round(worst, 4)
    End Function

End Class
