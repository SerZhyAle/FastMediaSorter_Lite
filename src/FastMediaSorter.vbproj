<Project ToolsVersion="12.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="..\packages\ILMerge.3.0.41\build\ILMerge.props" Condition="Exists('..\packages\ILMerge.3.0.41\build\ILMerge.props')" />
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{266169F5-C474-4ED0-90B6-66CAE8275FB7}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <StartupObject>fmsl.My.MyApplication</StartupObject>
    <RootNamespace>fmsl</RootNamespace>
    <!-- The net48 build is now the LEAN x86 VIEWER shipped alongside the .NET 10
         mainline (SPECIFICATION_DOTNET10_MODERN_BUILD §1.1/§8.3). The frozen
         FastMediaSorter_LITE.exe name moved to the modern build, which replaces
         the installed exe in place; this one gets its own artifact name. -->
    <AssemblyName>FastMediaSorter_x86</AssemblyName>
    <FileAlignment>512</FileAlignment>
    <MyType>WindowsForms</MyType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <TargetFrameworkProfile />
    <NuGetPackageImportStamp>
    </NuGetPackageImportStamp>
    <VersionYear>$([System.DateTime]::Now.ToString("yy"))</VersionYear>
    <VersionMonth>$([System.DateTime]::Now.Month)</VersionMonth>
    <VersionDay>$([System.DateTime]::Now.Day)</VersionDay>
    <VersionHourMinute>$([System.DateTime]::Now.ToString("HHmm"))</VersionHourMinute>
    <Version>$(VersionYear).$(VersionMonth).$(VersionDay).$(VersionHourMinute)</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <PublishUrl>FastMediaSorter\</PublishUrl>
    <Install>true</Install>
    <InstallFrom>Disk</InstallFrom>
    <UpdateEnabled>false</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateInterval>7</UpdateInterval>
    <UpdateIntervalUnits>Days</UpdateIntervalUnits>
    <UpdatePeriodically>false</UpdatePeriodically>
    <UpdateRequired>false</UpdateRequired>
    <MapFileExtensions>true</MapFileExtensions>
    <OpenBrowserOnPublish>false</OpenBrowserOnPublish>
    <ApplicationRevision>0</ApplicationRevision>
    <ApplicationVersion>$(Version)</ApplicationVersion>
    <UseApplicationTrust>false</UseApplicationTrust>
    <PublishWizardCompleted>true</PublishWizardCompleted>
    <BootstrapperEnabled>true</BootstrapperEnabled>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <!-- x86 so it runs on 32-bit Windows AND as a 32-bit process on x64 (spec
         §1.1). It also makes Environment.Is64BitProcess False, so the shared
         runtime resolution picks libvlc\win-x86 + x86\tesseract50.dll from the
         same folder the x64 sibling reads its win-x64/x64 trees from. -->
    <PlatformTarget>x86</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineDebug>true</DefineDebug>
    <DefineTrace>true</DefineTrace>
    <!-- Old-style projects do NOT get the implicit NETFRAMEWORK constant the SDK
         defines - without this, every "#If NETFRAMEWORK" seam shared with the
         .NET 10 build (SPECIFICATION_DOTNET10_MODERN_BUILD §3) silently compiles
         the WRONG branch here. Keep in sync with the Release group below. -->
    <DefineConstants>NETFRAMEWORK=True</DefineConstants>
    <OutputPath>..\bin\Debug\</OutputPath>
    <DocumentationFile>FastMediaSorter_x86.xml</DocumentationFile>
    <NoWarn>
    </NoWarn>
    <RunCodeAnalysis>true</RunCodeAnalysis>
    <WarningsAsErrors>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036</WarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <PlatformTarget>x86</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <DefineDebug>false</DefineDebug>
    <DefineTrace>true</DefineTrace>
    <DefineConstants>NETFRAMEWORK=True</DefineConstants>
    <Optimize>true</Optimize>
    <OutputPath>..\bin\Release\</OutputPath>
    <DocumentationFile>FastMediaSorter_x86.xml</DocumentationFile>
    <NoWarn>
    </NoWarn>
    <WarningsAsErrors>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036</WarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup>
    <OptionExplicit>On</OptionExplicit>
  </PropertyGroup>
  <PropertyGroup>
    <OptionCompare>Binary</OptionCompare>
  </PropertyGroup>
  <PropertyGroup>
    <OptionStrict>On</OptionStrict>
  </PropertyGroup>
  <PropertyGroup>
    <OptionInfer>On</OptionInfer>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Force legacy .NET Framework resource writer to avoid System.Resources.Extensions dependency at runtime on net48. -->
    <GenerateResourceUsePreserializedResources>false</GenerateResourceUsePreserializedResources>
  </PropertyGroup>
