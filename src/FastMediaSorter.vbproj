    <Compile Include="CloseDrainCoordinator.vb" />
    <!-- Slot health (same specification, Ф2..Ф4). Both are whole-file
         "#If Not NETFRAMEWORK" and compile to nothing here: this build's file-operation
         transport is a single BackgroundWorker that refuses a second operation anyway, so
         the "twenty presses into a dead share" shape the probe guards against cannot arise
         (invariant 10). Listed so the two projects' file sets stay identical and any
         divergence is always a seam rather than a forgotten line. -->
    <Compile Include="SlotHealth.vb" />
    <!-- The Recycle Bin (017_SPECIFICATION_RECYCLE_BIN_AND_UNDO_DOTNET10.md §5). All four are
         whole-file "#If Not NETFRAMEWORK" and compile to nothing here - this build's DEL is
