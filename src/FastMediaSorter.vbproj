         the two projects' file sets stay identical and a divergence is always a seam. -->
    <Compile Include="DeletePolicy.vb" />
    <Compile Include="DeleteVolumeProbe.vb" />
    <Compile Include="RecycleBinIndex.vb" />
    <Compile Include="RecycleBinIo.vb" />
