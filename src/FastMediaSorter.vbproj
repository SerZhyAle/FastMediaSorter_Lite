    <Error Condition="!Exists('..\packages\ILMerge.3.0.41\build\ILMerge.props')" Text="$([System.String]::Format('$(ErrorText)', '..\packages\ILMerge.3.0.41\build\ILMerge.props'))" />
  </Target>
  <Target Name="UpdateVersion" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <AutoVersion Condition="'$(ReleaseVersion)' != ''">$(ReleaseVersion)</AutoVersion>
      <VersionYear Condition="'$(AutoVersion)' == ''">$([System.DateTime]::Now.ToString("yy"))</VersionYear>
      <VersionMonth Condition="'$(AutoVersion)' == ''">$([System.DateTime]::Now.Month)</VersionMonth>
      <VersionDay Condition="'$(AutoVersion)' == ''">$([System.DateTime]::Now.Day)</VersionDay>
      <VersionHourMinute Condition="'$(AutoVersion)' == ''">$([System.DateTime]::Now.ToString("HHmm"))</VersionHourMinute>
      <AutoVersion Condition="'$(AutoVersion)' == ''">$(VersionYear).$(VersionMonth).$(VersionDay).$(VersionHourMinute)</AutoVersion>
    </PropertyGroup>
    <Message Text="Auto-generating version: $(AutoVersion)" Importance="high" />
    <WriteLinesToFile File="$(ProjectDir)My Project\VersionInfo.vb" Lines="' Auto-generated version file - DO NOT EDIT MANUALLY%0D%0A' Generated at build time in format YY.M.D.HHmm%0D%0AImports System.Reflection%0D%0A%0D%0A&lt;Assembly: AssemblyVersion(&quot;$(AutoVersion)&quot;)&gt;%0D%0A&lt;Assembly: AssemblyFileVersion(&quot;$(AutoVersion)&quot;)&gt;" Overwrite="true" Encoding="utf-8" />
  </Target>
