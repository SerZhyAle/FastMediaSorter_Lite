<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fast Media Sorter: Share Manager - the Android Folder Share controller,
    split out of the LITE viewer (SPECIFICATION_SHARE_COMPANION_APP.md).
    Public name "Share Manager" rides on the frozen technical anchor
    FastMediaSorterCompanion.exe (CLAUDE.md light-rebrand rule). Written on
    .NET 10 from the start - no intermediate net48 variant.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>FastMediaSorterCompanion</RootNamespace>
    <AssemblyName>FastMediaSorterCompanion</AssemblyName>
    <StartupObject>FastMediaSorterCompanion.Program</StartupObject>

    <!-- Custom Sub Main (mutex + WM_COPYDATA handshake), not the VB Application
         Framework - so MyType is disabled. -->
    <MyType>Empty</MyType>

    <!-- Repo-wide VB strictness (CLAUDE.md "Code Style & Constraints"). -->
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <OptionCompare>Binary</OptionCompare>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Fast Media Sorter: Share Manager</Product>
    <AssemblyTitle>Fast Media Sorter: Share Manager</AssemblyTitle>
    <Company>SerZhyAle</Company>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!-- Publish model: self-contained single file (SPECIFICATION_SHARE_COMPANION_APP.md
       §7.2). Only applied when publishing with -r win-x64; a plain build ignores it. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- QR rendering for the .fmscfg export (ShareConfigBuilder), same version as LITE. -->
    <PackageReference Include="QRCoder" Version="1.4.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The localization parity test reads Localization.All, which is Friend on purpose
         (the table is an implementation detail, not API). The viewer's test project sees
         it by linking the sources; this one project-references, so it needs the grant. -->
    <InternalsVisibleTo Include="Companion.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Offline trilingual port-forward guide, opened by ShareGuide. Keyed by the
         same relative path ShareGuide passes (help/port-forward.html). -->
    <EmbeddedResource Include="..\..\assets\help\port-forward.html">
      <LogicalName>help/port-forward.html</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!--
      The localization ENGINE is shared with the viewer, verbatim - same dictionary
      shape, same Russian-source keys, same registry value, so a language chosen in
      either program shows in the other (SPECIFICATION_THIRTEEN_UI_LANGUAGES.md
      block A'). Only the string TABLES differ: Companion supplies its own
      RegisterStrings() in Localization\Localization.Registry.vb, which is why the
      engine's shared constructor can call an implementation this project owns.

      Linked, not copied: a fix to T/TF/TC must not need doing twice.
    -->
    <Compile Include="..\Localization\Localization.vb" Link="Localization\Localization.vb" />
    <Compile Include="..\Localization\Localization.Persistence.vb" Link="Localization\Localization.Persistence.vb" />

    <!--
      Simple MAPI "compose a mail with this file attached" - written here first, for
      the package wizard, and now shared with the viewer's "send logs to the author"
      button (SPECIFICATION_SEND_LOGS_TO_AUTHOR.md §5.1). Same reason as above:
      linked, not copied, so the P/Invoke exists once.
    -->
    <Compile Include="..\Support\MailSender.vb" Link="Core\MailSender.vb" />
  </ItemGroup>

</Project>
