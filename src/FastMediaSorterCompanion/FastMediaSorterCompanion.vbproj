<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Share Manager - Fast Media Sorter & Sharing - the Android Folder Share controller,
    split out of the mainline viewer (SPECIFICATION_SHARE_COMPANION_APP.md).
    Public name "Share Manager" rides on the frozen technical anchor
    FastMediaSorterCompanion.exe (CLAUDE.md light-rebrand rule). Written on
    .NET 10 from the start - no intermediate net48 variant.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10.0.19041: the Windows SDK projections this project needs for the live-broadcast
         screen source (ticket 172 section 4: Windows Graphics Capture, Windows 10 1903+; the
         process-loopback audio exclusion, 2004+). TargetPlatformMinVersion stays at the package's
         own floor (10.0.17763, the MSIX manifest's MinVersion) so nothing about the package changes;
         the capture itself refuses to start where the OS lacks it (SourceUnavailable). -->
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>FastMediaSorterCompanion</RootNamespace>
    <AssemblyName>FastMediaSorterCompanion</AssemblyName>
    <StartupObject>FastMediaSorterCompanion.Program</StartupObject>

    <!-- Custom Sub Main (mutex + WM_COPYDATA handshake), not the VB Application
         Framework - so MyType is disabled. -->
    <MyType>Empty</MyType>

    <!-- Repo-wide VB strictness (CLAUDE.md "Code Style & Constraints"). -->
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <OptionCompare>Binary</OptionCompare>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Share Manager - Fast Media Sorter &amp; Sharing</Product>
    <AssemblyTitle>Share Manager - Fast Media Sorter &amp; Sharing</AssemblyTitle>
    <Company>SZA</Company>
    <NeutralLanguage>en</NeutralLanguage>
    <ApplicationIcon>..\..\assets\icons\Fast_Media_Sorter.ico</ApplicationIcon>
    <!-- ProductVersion feeds the log-mail subject and report (SendLogsFlow); keep it the
         bare stamp, as the viewer does, instead of "<version>+<commit>". -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- The same YY.M.D.HHmm stamp as both viewers (ticket 055 I-08): every packager passes
       -p:ReleaseVersion=... so the three programs of one package carry one version;
       a plain build stamps the current minute, like src/Modern/FastMediaSorter.Modern.vbproj. -->
  <PropertyGroup>
    <AutoVersion Condition="'$(ReleaseVersion)' != ''">$(ReleaseVersion)</AutoVersion>
    <AutoVersion Condition="'$(AutoVersion)' == ''">$([System.DateTime]::Now.ToString("yy")).$([System.DateTime]::Now.Month).$([System.DateTime]::Now.Day).$([System.DateTime]::Now.ToString("HHmm"))</AutoVersion>
    <Version>$(AutoVersion)</Version>
    <AssemblyVersion>$(AutoVersion)</AssemblyVersion>
    <FileVersion>$(AutoVersion)</FileVersion>
  </PropertyGroup>

  <!-- Publish model: self-contained single file (SPECIFICATION_SHARE_COMPANION_APP.md
       §7.2). Only applied when publishing with -r win-x64; a plain build ignores it. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="LICENSE" />
    <!-- QR rendering for the .fmscfg export (ShareConfigBuilder), same version as the viewer. -->
    <PackageReference Include="QRCoder" Version="1.4.3" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.16" />
    <!-- Spec 227: the linked QrCodeDecoder falls back to ImageSharp for what GDI+ cannot read
         (a WEBP phone screenshot), the viewer's own managed decoder and version. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- The localization parity test reads Localization.All, which is Friend on purpose
         (the table is an implementation detail, not API). The viewer's test project sees
         it by linking the sources; this one project-references, so it needs the grant. -->
    <InternalsVisibleTo Include="Companion.Tests" />
    <InternalsVisibleTo Include="ExchangeFirstRunScenes" />
    <InternalsVisibleTo Include="ResourceAddScenes" />
  </ItemGroup>

  <ItemGroup>
    <!-- Offline trilingual port-forward guide, opened by ShareGuide. Keyed by the
         same relative path ShareGuide passes (help/port-forward.html). -->
    <EmbeddedResource Include="..\..\assets\help\port-forward.html">
      <LogicalName>help/port-forward.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\exchange-mark\png\*.png">
      <WithCulture>false</WithCulture>
      <LogicalName>exchange-mark/png/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\exchange-mark\svg\*.svg">
      <WithCulture>false</WithCulture>
      <LogicalName>exchange-mark/svg/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\exchange-mark\ico\*.ico">
      <WithCulture>false</WithCulture>
      <LogicalName>exchange-mark/ico/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\glyphs\*.svg">
      <!-- MSBuild reads the penultimate extension of a resource file name as a culture: "action.run.svg" is
           Rundi ("run"), so that glyph was silently moved to a satellite assembly and left out of the exe. -->
      <WithCulture>false</WithCulture>
      <LogicalName>glyphs/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\help-map.json">
      <LogicalName>help-map.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!--
      The localization ENGINE is shared with the viewer, verbatim - same dictionary
      shape, same Russian-source keys, same registry value, so a language chosen in
      either program shows in the other (013_SPECIFICATION_THIRTEEN_UI_LANGUAGES.md
      block A'). Only the string TABLES differ: Companion supplies its own
      RegisterStrings() in Localization\Localization.Registry.vb, which is why the
      engine's shared constructor can call an implementation this project owns.

      Linked, not copied: a fix to T/TF/TC must not need doing twice.
    -->
    <Compile Include="..\Archives\ArchiveWriteManifest.vb" Link="Core\Archives\ArchiveWriteManifest.vb" />
    <Compile Include="..\Archives\VerifiedZipWriter.vb" Link="Core\Archives\VerifiedZipWriter.vb" />
    <Compile Include="..\Help\ContextHelp.vb" Link="Help\ContextHelp.vb" />
    <Compile Include="..\Help\ContextHelpUi.vb" Link="Help\ContextHelpUi.vb" />
    <Compile Include="..\LogSessionDiagnostics.vb" Link="LogSessionDiagnostics.vb" />
    <Compile Include="..\Theming\IThemeAware.vb" Link="Theming\IThemeAware.vb" />
    <Compile Include="..\Localization\Localization.vb" Link="Localization\Localization.vb" />
    <Compile Include="..\Localization\Localization.Persistence.vb" Link="Localization\Localization.Persistence.vb" />

    <!--
      Simple MAPI "compose a mail with this file attached" - written here first, for
      the package wizard, and now shared with the viewer's "send logs to the author"
      button (SPECIFICATION_SEND_LOGS_TO_AUTHOR.md §5.1). Same reason as above:
      linked, not copied, so the P/Invoke exists once.
    -->
    <Compile Include="..\Support\MailSender.vb" Link="Core\MailSender.vb" />
    <Compile Include="..\CopyDataTransport.vb" Link="Core\CopyDataTransport.vb" />
    <Compile Include="..\SingleInstanceProtocol.vb" Link="Core\SingleInstanceProtocol.vb" />
    <Compile Include="..\ProbeScheduler.vb" Link="Core\ProbeScheduler.vb" />
    <Compile Include="..\ShareActivationPolicy.vb" Link="Core\ShareActivationPolicy.vb" />
    <Compile Include="..\MonotonicClock.vb" Link="Core\MonotonicClock.vb" />
    <!-- The product's visible names, spelled once (docs/guides/PRODUCT_NAMING.md). -->
    <Compile Include="..\ProductNames.vb" Link="Core\ProductNames.vb" />
    <!--
      The viewer's log package, for the Share Manager's own "send the log" (ticket 028
      Ф-3, APP-BEHAVIOUR rule 6): one report format, one settings allow-list, one
      redaction, both logs in one archive - linked so none of that exists twice.
    -->
    <Compile Include="..\Support\LogPackage.vb" Link="Core\LogPackage.vb" />
    <Compile Include="..\Support\DiagnosticRedactor.vb" Link="Core\DiagnosticRedactor.vb" />
    <!--
      The "[hosting]" block of that report and the one state line of the log (ticket 182 L-4, L-8):
      the pure builder with injected probes, and the live probes behind it. Whole-file
      "#If Not NETFRAMEWORK", like LogPackage.
    -->
    <Compile Include="..\Support\HostingReport.vb" Link="Core\HostingReport.vb" />
    <Compile Include="..\Support\HostingProbesLive.vb" Link="Core\HostingProbesLive.vb" />
    <!--
      The site pages both programs link to by UI language - here the install-trust page
      the opt-in and the hosting group point at (ticket 037 Ф-4). Linked so a page that
      moves is corrected once.
    -->
    <Compile Include="..\Support\SitePages.vb" Link="Core\SitePages.vb" />
    <Compile Include="..\Support\AboutResources.vb" Link="Core\AboutResources.vb" />
    <Compile Include="..\SettingsNavIconPalette.vb" Link="Theming\SettingsNavIconPalette.vb" />
    <Compile Include="..\Icons\IconMap.vb" Link="Core\IconMap.vb" />
    <Compile Include="..\Icons\SvgPathData.vb" Link="Core\SvgPathData.vb" />
    <Compile Include="..\Icons\GlyphRenderer.vb" Link="Core\GlyphRenderer.vb" />
    <Compile Include="..\Chrome\UiSizing.vb" Link="Core\UiSizing.vb" />
    <!-- The state marker of a collapsible group header (COLLAPSIBLE-GROUP 1.1 section 3, ticket 243 T-11c): the filled
         triangle the viewer's settings groups draw, here for the two Manager header kinds (SettingsGroupCard,
         CollapsibleSection). Whole-file "#If Not NETFRAMEWORK"; needs only UiSizing above. -->
    <Compile Include="..\Chrome\GroupMarker.vb" Link="Core\GroupMarker.vb" />
    <!-- The page rail's arithmetic (SETTINGS-NAVIGATION 2.0 section 2 rules 5 and 7, ticket 243 T-7b): row target,
         glyph, gap, rail width, focus movement. Pure, shared with the viewer's settings window. -->
    <Compile Include="..\Support\SettingsRailRules.vb" Link="Core\SettingsRailRules.vb" />
    <Compile Include="..\Icons\ButtonGlyphs.vb" Link="Core\ButtonGlyphs.vb" />
    <!-- The one answer row of the secondary windows (BUTTONS 2.0 sections 3 and 4, ticket 243 T-8a/T-8b): the viewer's
         control, whole-file "#If Not NETFRAMEWORK", needs only UiSizing and ButtonGlyphs above - no DialogLayout. -->
    <Compile Include="..\DialogButtonRow.vb" Link="Core\DialogButtonRow.vb" />
    <!-- The boolean option row (BOOLEAN-OPTION 2.0 sections 2 and 3, ticket 243 T-11c-b): the viewer's owner-drawn 20 px box
         over a stock CheckBox, its caption/explanation row host and the row's arithmetic, linked whole (each file is
         "#If Not NETFRAMEWORK"). SettingsCheckBox.ArrangeRow names OptionHeading (the optional heading glyph and `?` target),
         so its two files come along; the Manager adds no help target. Core\OptionRows.vb is the Manager's facade. -->
    <Compile Include="..\SettingsRowGrid.vb" Link="Core\SettingsRowGrid.vb" />
    <Compile Include="..\OptionHelpSource.vb" Link="Core\OptionHelpSource.vb" />
    <Compile Include="..\OptionHelpUi.vb" Link="Core\OptionHelpUi.vb" />
    <Compile Include="..\SettingsCheckBox.vb" Link="Core\SettingsCheckBox.vb" />
    <Compile Include="..\DialogOptionRow.vb" Link="Core\DialogOptionRow.vb" />    <!-- The product-owned QUESTION window (BUTTONS 2.0 section 1, ticket 243 T-12b): the viewer's Ask_Dialog with its pure
         model and the MessageBox-to-AskSpec mapping, linked whole - each is "#If Not NETFRAMEWORK", which this net10 project
         never defines. Ask_Dialog names only DialogLayout.ApplyAutoScale / ClampToWorkingArea (the forwarding class in
         Core\DpiLayout.vb), Localization, ButtonGlyphs and ProductNames, all of which are linked above; the viewer's
         AskDialogs / DialogLayer (the viewer's band) are NOT linked - Core\ManagerBox.vb shows the window itself. -->
    <Compile Include="..\AskModel.vb" Link="Core\AskModel.vb" />
    <Compile Include="..\Ask_Dialog.vb" Link="Core\Ask_Dialog.vb" />
    <Compile Include="..\ViewerBoxMapping.vb" Link="Core\ViewerBoxMapping.vb" />
    <Compile Include="..\Icons\ExchangeMark.vb" Link="Core\ExchangeMark.vb" />
    <Compile Include="..\Icons\StepArt.vb" Link="Core\StepArt.vb" />
    <!--
      The application theme (spec 060): one stored mode, one palette, one applier for both
      programs, so a window of either follows the same system / light / dark choice. The
      strings table comes along because both settings windows offer the choice.
    -->
    <Compile Include="..\Theming\ThemePalette.vb" Link="Theming\ThemePalette.vb" />
    <Compile Include="..\Theming\AccentColors.vb" Link="Theming\AccentColors.vb" />
    <Compile Include="..\Theming\ThemeApplier.vb" Link="Theming\ThemeApplier.vb" />
    <Compile Include="..\SettingsNumericStepper.vb" Link="Theming\SettingsNumericStepper.vb" />
    <Compile Include="..\SettingsUiContext.vb" Link="Core\SettingsUiContext.vb" />
    <Compile Include="..\Theming\ThemedComboBox.vb" Link="Theming\ThemedComboBox.vb" />
    <Compile Include="..\Theming\CheckBoxLayout.vb" Link="Theming\CheckBoxLayout.vb" />
    <Compile Include="..\Theming\ThemedMenuRenderer.vb" Link="Theming\ThemedMenuRenderer.vb" />
    <Compile Include="..\Theming\ThemeService.vb" Link="Theming\ThemeService.vb" />
    <Compile Include="..\Localization\Localization.DeviceVocabulary.vb" Link="Localization\Localization.DeviceVocabulary.vb" />
    <Compile Include="..\Localization\Localization.Theme.vb" Link="Localization\Localization.Theme.vb" />
    <!-- Ticket 182 L-3/L-6: the strings of the shared LogPackage / MailSender, registered by both programs. -->
    <Compile Include="..\Localization\Localization.SendLogs.vb" Link="Localization\Localization.SendLogs.vb" />
    <!--
      Ticket 180 T-1: the client library of the device exchange (DEVICE-EXCHANGE): codec, frames, the pin-checking
      TLS stream, data streams, the loopback forwarder, the credential store, the directory model and the
      local-channel client. Whole-file "#If Not NETFRAMEWORK", linked here and compiled into the modern viewer by
      its ..\**\*.vb glob; the net48 project lists none of it (a source scan holds that).
    -->
    <Compile Include="..\Exchange\*.vb" Link="Exchange\%(Filename)%(Extension)" />
    <!--
      Ticket 172: the live-broadcast PRODUCER library - the descriptor writer, the hub, the chunker,
      the LAN server, the controller and the seams - linked (not copied) from the viewer's source
      tree, whole-file "#If Not NETFRAMEWORK" like the exchange library above. The Share Manager is
      the producer program (spec 172 section 2); the viewer compiles the same files through its
      src\**\*.vb glob. LiveBroadcastFeatures.vb is the gate of safety rule 6, shared so the tray
      item, the window and the release preflight read ONE constant.
    -->
    <Compile Include="..\LiveBroadcast\LiveBroadcastFeatures.vb" Link="LiveBroadcast\LiveBroadcastFeatures.vb" />
    <Compile Include="..\LiveBroadcast\Producer\*.vb" Link="LiveBroadcast\Producer\%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Ticket 222: scheduled file operations. The engine is the Share Manager's own (Core\Scheduled\); what it
    shares with the viewer is LINKED, never copied, so a rule is fixed once: the media classifier (the type
    mask), the pure delete policy and the volume probe (what a deletion will do), the Recycle Bin I/O and its
    index (the shell call and the check that the bin really took the file), the folder scan, and the
    "name (2).ext" free-name rule. Each is a whole-file "#If Not NETFRAMEWORK" module with no UI strings; the
    few that had strings or a viewer-only dependency were split first (DeleteText, SortableContentKinds,
    RecycleBinIo.Delete).
  -->
  <ItemGroup>
    <Compile Include="..\MediaKind.vb" Link="Core\Scheduled\Linked\MediaKind.vb" />
    <Compile Include="..\DeletePolicy.vb" Link="Core\Scheduled\Linked\DeletePolicy.vb" />
    <Compile Include="..\DeleteVolumeProbe.vb" Link="Core\Scheduled\Linked\DeleteVolumeProbe.vb" />
    <Compile Include="..\RecycleBinIo.vb" Link="Core\Scheduled\Linked\RecycleBinIo.vb" />
    <Compile Include="..\RecycleBinIndex.vb" Link="Core\Scheduled\Linked\RecycleBinIndex.vb" />
    <Compile Include="..\FolderScan.vb" Link="Core\Scheduled\Linked\FolderScan.vb" />
    <Compile Include="..\PathFailure.vb" Link="Core\Scheduled\Linked\PathFailure.vb" />
    <Compile Include="..\FreeNameRule.vb" Link="Core\Scheduled\Linked\FreeNameRule.vb" />
    <Compile Include="..\Resources\IFileSystemProvider.vb" Link="Core\Scheduled\Linked\IFileSystemProvider.vb" />
    <!-- The directory side the three providers implement for the viewer's file manager mode (257). Whole-file "#If Not NETFRAMEWORK";
         ManagerPathRules lives with the location types. The Share Manager itself never lists a folder through them. -->
    <Compile Include="..\Resources\IManagerDirectoryProvider.vb" Link="Core\Scheduled\Linked\IManagerDirectoryProvider.vb" />
    <Compile Include="..\FileManager\ManagerLocation.vb" Link="Core\Scheduled\Linked\FileManager\ManagerLocation.vb" />
    <!-- Ticket 244 (WORKER-LAUNCH 1.0): the ONE state-directory resolution the viewer's WorkerShares also uses. -->
    <Compile Include="..\Resources\WorkerStateDir.vb" Link="Core\WorkerStateDir.vb" />
    <!-- EXPERIMENT (ticket 222 step 4): the provider layer the viewer already has, for registered resources. -->
    <Compile Include="..\Resources\ResourceRegistry.vb" Link="Core\Scheduled\Linked\Resources\ResourceRegistry.vb" />
    <Compile Include="..\Resources\ResourceFailure.vb" Link="Core\Scheduled\Linked\Resources\ResourceFailure.vb" />
    <Compile Include="..\Resources\NetworkChangeTracker.vb" Link="Core\Scheduled\Linked\Resources\NetworkChangeTracker.vb" />
    <Compile Include="..\Resources\ResourceConnect.vb" Link="Core\Scheduled\Linked\Resources\ResourceConnect.vb" />
    <Compile Include="..\Resources\EndpointResolver.vb" Link="Core\Scheduled\Linked\Resources\EndpointResolver.vb" />
    <Compile Include="..\Resources\HostKeyGate.vb" Link="Core\Scheduled\Linked\Resources\HostKeyGate.vb" />
    <Compile Include="..\Resources\SshFingerprint.vb" Link="Core\Scheduled\Linked\Resources\SshFingerprint.vb" />
    <Compile Include="..\Resources\SftpProvider.vb" Link="Core\Scheduled\Linked\Resources\SftpProvider.vb" />
    <Compile Include="..\Resources\SmbProvider.vb" Link="Core\Scheduled\Linked\Resources\SmbProvider.vb" />
    <Compile Include="..\Resources\SmbConnectionLease.vb" Link="Core\Scheduled\Linked\Resources\SmbConnectionLease.vb" />
    <Compile Include="..\Resources\ResourcePolicy.vb" Link="Core\Scheduled\Linked\Resources\ResourcePolicy.vb" />
    <Compile Include="..\Resources\ResourceCommit.vb" Link="Core\Scheduled\Linked\Resources\ResourceCommit.vb" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <Compile Include="..\Resources\LocalProvider.vb" Link="Core\Scheduled\Linked\Resources\LocalProvider.vb" />
    <Compile Include="..\Resources\FmsConfigReader.vb" Link="Core\Scheduled\Linked\Resources\FmsConfigReader.vb" />
    <Compile Include="..\Resources\ExchangeTunnel.vb" Link="Core\Scheduled\Linked\Resources\ExchangeTunnel.vb" />
    <Compile Include="..\Resources\FmsTunnelPaths.vb" Link="Core\Scheduled\Linked\Resources\FmsTunnelPaths.vb" />
    <Compile Include="..\Resources\ExchangeAttach.vb" Link="Core\Scheduled\Linked\Resources\ExchangeAttach.vb" />
    <Compile Include="..\Resources\TransferPlan.vb" Link="Core\Scheduled\Linked\Resources\TransferPlan.vb" />
    <Compile Include="..\Resources\ResourceTransfer.vb" Link="Core\Scheduled\Linked\Resources\ResourceTransfer.vb" />
    <Compile Include="..\Security\DpapiSecrets.vb" Link="Core\Scheduled\Linked\Resources\DpapiSecrets.vb" />
    <Compile Include="..\Resources\QrCodeDecoder.vb" Link="Core\QrCodeDecoder.vb" />
    <Compile Include="..\Resources\PhoneConnectionIntake.vb" Link="Core\PhoneConnectionIntake.vb" />
    <Compile Include="..\Resources\FmsImportRules.vb" Link="Core\FmsImportRules.vb" />
    <Compile Include="..\Resources\ResourceImport.vb" Link="Core\ResourceImport.vb" />
  </ItemGroup>

</Project>
