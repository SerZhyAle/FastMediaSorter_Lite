Option Explicit On
Option Strict On
Option Infer On
Option Compare Binary

Imports System.Collections.Generic
Imports System.Globalization
Imports System.IO
Imports System.Linq
Imports System.Text
Imports System.Text.Json

' Ticket L0278 T-5 (specification section 5.4, "The target record"): the servers this PC administers from the remote
' administration window. One JSON array in ONE registry value, kept beside the product's other settings through the same
' IExchangeSettingsPort seam the viewer's entry store uses (the viewer's store is a precedent for the SHAPE only; this layer names
' none of the local server module's types, RemoteAdminSeparationTests holds that).
'
'   - A record holds seven JSON members: id, name, host, port, leafPin, keyPin, lastUsedUtc. (Section 5.4 lists six table rows;
'     the host/port row carries two members. A test pins the seven names.) NOTHING SECRET is a member: no password, no token, no
'     invitation, not the device token of this PC, nothing the server said. There is no property for any of them.
'   - At most 32 records, one per host:port (the host compared in lower case). A name is 1..64 characters and defaults to the host.
'   - Editing the host or the port clears both pins (the old pins described another endpoint); editing only the name keeps them.
'   - The value name is RemoteAdmin_Targets. It is NOT in LogPackage.SafeSettingNames and the log package never reads it, so a
'     report withholds it (a test reads LogPackage.vb and fails on any mention).
'   - Dormant: a read opens nothing for writing and creates no value; every mutator re-reads the value first, so two windows never
'     write a stale list over each other, and a mutator whose result equals what is stored writes nothing.
'   - A value that does not parse reads as an EMPTY list and is NOT overwritten by the read: the damaged text stays in place until
'     the next real save (Add, Edit, SetPins, ForgetCertificate, Touch, Remove) replaces the whole value. A damaged element inside a
'     valid array is skipped the same way.

''' <summary>One administration target. Immutable. The seven data members are exactly the seven JSON members of the stored record.</summary>
Friend NotInheritable Class ExchangeAdminTarget

    ''' <summary>A GUID in "D" form, generated by the store.</summary>
    Public ReadOnly Id As String
    ''' <summary>1..64 characters, shown in the banner and every confirmation.</summary>
    Public ReadOnly Name As String
    ''' <summary>The host, lower-cased, an IPv6 literal without brackets (as ExchangeServerAddress holds it).</summary>
    Public ReadOnly Host As String
    Public ReadOnly Port As Integer
    ''' <summary>"" or the accepted leaf fingerprint in ExchangeTrust.IsFingerprint form.</summary>
    Public ReadOnly LeafPin As String
    ''' <summary>"" or the accepted key fingerprint in the same form.</summary>
    Public ReadOnly KeyPin As String
    ''' <summary>For ordering only; DateTime.MinValue (UTC) when the target has never been used.</summary>
    Public ReadOnly LastUsedUtc As DateTime

    Public Sub New(id As String, name As String, host As String, port As Integer, leafPin As String, keyPin As String, lastUsedUtc As DateTime)
        Me.Id = If(id, "")
        Me.Name = If(name, "")
        Me.Host = If(host, "")
        Me.Port = port
        Me.LeafPin = If(leafPin, "")
        Me.KeyPin = If(keyPin, "")
        Me.LastUsedUtc = AsUtc(lastUsedUtc)
    End Sub

    ''' <summary>host:port as ExchangeServerAddress writes it (an IPv6 literal in brackets). Computed, never stored.</summary>
    Public ReadOnly Property Address As String
        Get
            Return New ExchangeServerAddress(Host, Port).ToString()
        End Get
    End Property

    Friend Function WithPins(leafPin As String, keyPin As String) As ExchangeAdminTarget
        Return New ExchangeAdminTarget(Id, Name, Host, Port, leafPin, keyPin, LastUsedUtc)
    End Function

    Friend Function WithLastUsed(utc As DateTime) As ExchangeAdminTarget
        Return New ExchangeAdminTarget(Id, Name, Host, Port, LeafPin, KeyPin, utc)
    End Function

    Friend Function SameAs(other As ExchangeAdminTarget) As Boolean
        Return other IsNot Nothing AndAlso
               String.Equals(Id, other.Id, StringComparison.Ordinal) AndAlso String.Equals(Name, other.Name, StringComparison.Ordinal) AndAlso
               String.Equals(Host, other.Host, StringComparison.Ordinal) AndAlso Port = other.Port AndAlso
               String.Equals(LeafPin, other.LeafPin, StringComparison.Ordinal) AndAlso String.Equals(KeyPin, other.KeyPin, StringComparison.Ordinal) AndAlso
               LastUsedUtc = other.LastUsedUtc
    End Function

    Friend Shared Function AsUtc(value As DateTime) As DateTime
        If value = DateTime.MinValue Then Return DateTime.SpecifyKind(DateTime.MinValue, DateTimeKind.Utc)
        Return If(value.Kind = DateTimeKind.Local, value.ToUniversalTime(), DateTime.SpecifyKind(value, DateTimeKind.Utc))
    End Function

    ''' <summary>The server, the name and the fingerprints are not secrets, but the text still names no member.</summary>
    Public Overrides Function ToString() As String
        Return "ExchangeAdminTarget"
    End Function

End Class

''' <summary>What a mutator of the target store answers.</summary>
Friend Enum ExchangeAdminTargetResult
    ''' <summary>Stored (or already stored as asked).</summary>
    Saved = 0
    ''' <summary>The address is not "host:port" with a port in 1..65535 (a bare host is refused, there is no default port).</summary>
    BadAddress = 1
    ''' <summary>The name is longer than 64 characters or holds a control character.</summary>
    BadName = 2
    ''' <summary>Another record already holds this host:port.</summary>
    Duplicate = 3
    ''' <summary>The store already holds the most targets it keeps.</summary>
    Full = 4
    ''' <summary>No record has this id.</summary>
    NotFound = 5
End Enum

''' <summary>The targets of this Windows user, in one registry value. A pure read creates nothing.</summary>
Friend NotInheritable Class ExchangeAdminTargets

    ''' <summary>The value this store owns, so a test can assert that a dormant run wrote none of it.</summary>
    Friend Const ValueName As String = "RemoteAdmin_Targets"
    Friend Shared ReadOnly AllNames As String() = {ValueName}

    ''' <summary>Few enough that the picker stays a list a person can read.</summary>
    Friend Const MaxTargets As Integer = 32
    Friend Const MaxNameChars As Integer = 64
    Private Const MaxJsonChars As Integer = 100000

    Private ReadOnly _port As IExchangeSettingsPort
    Private ReadOnly _clock As Func(Of DateTime)

    Public Sub New(port As IExchangeSettingsPort, Optional clock As Func(Of DateTime) = Nothing)
        _port = If(port, New ExchangeRegistrySettings())
        _clock = If(clock, Function() DateTime.UtcNow)
    End Sub

    Public Shared Function CreateDefault() As ExchangeAdminTargets
        Return New ExchangeAdminTargets(New ExchangeRegistrySettings())
    End Function

    Public Shared Function IsValidId(id As String) As Boolean
        Dim parsed As Guid
        Return id IsNot Nothing AndAlso id.Length = 36 AndAlso Guid.TryParseExact(id, "D", parsed)
    End Function

    ' ---- reading --------------------------------------------------------------------------------------------

    ''' <summary>Every valid record, in the order they were added. A damaged element is skipped, not an error; a value that does not
    ''' parse is "no targets". A pure read: nothing is written, whatever the value holds.</summary>
    Public Function Load() As List(Of ExchangeAdminTarget)
        Dim result As New List(Of ExchangeAdminTarget)
        Dim json As String = _port.GetValue(ValueName)
        If String.IsNullOrEmpty(json) OrElse json.Length > MaxJsonChars Then Return result
        Try
            Using doc As JsonDocument = JsonDocument.Parse(json)
                If doc.RootElement.ValueKind <> JsonValueKind.Array Then Return result
                Dim ids As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
                Dim endpoints As New HashSet(Of String)(StringComparer.Ordinal)
                For Each item As JsonElement In doc.RootElement.EnumerateArray()
                    If result.Count >= MaxTargets Then Exit For
                    Dim t As ExchangeAdminTarget = ReadTarget(item)
                    If t Is Nothing Then Continue For
                    If Not ids.Add(t.Id) OrElse Not endpoints.Add(t.Address) Then Continue For
                    result.Add(t)
                Next
            End Using
        Catch ex As JsonException
            Return New List(Of ExchangeAdminTarget)
        End Try
        Return result
    End Function

    ''' <summary>The records, the most recently used first; targets never used keep the order they were added in.</summary>
    Public Function LoadByRecentUse() As List(Of ExchangeAdminTarget)
        Return Load().OrderByDescending(Function(t) t.LastUsedUtc).ToList()
    End Function

    Public Function Count() As Integer
        Return Load().Count
    End Function

    Public Function Find(id As String) As ExchangeAdminTarget
        Dim list As List(Of ExchangeAdminTarget) = Load()
        Dim at As Integer = IndexOf(list, id)
        Return If(at >= 0, list(at), Nothing)
    End Function

    Private Shared Function IndexOf(list As List(Of ExchangeAdminTarget), id As String) As Integer
        If id Is Nothing Then Return -1
        Return list.FindIndex(Function(t) String.Equals(t.Id, id, StringComparison.OrdinalIgnoreCase))
    End Function

    Private Shared Function ReadTarget(item As JsonElement) As ExchangeAdminTarget
        If item.ValueKind <> JsonValueKind.Object Then Return Nothing
        Dim id As String = ReadText(item, "id")
        If Not IsValidId(id) Then Return Nothing
        Dim port As Integer
        Dim p As JsonElement
        If Not item.TryGetProperty("port", p) OrElse p.ValueKind <> JsonValueKind.Number OrElse Not p.TryGetInt32(port) Then Return Nothing
        Dim host As String = ReadText(item, "host")
        Dim address As ExchangeServerAddress = Nothing
        If Not ExchangeServerAddress.TryParse(New ExchangeServerAddress(host, port).ToString(), address) Then Return Nothing
        host = address.Host.ToLowerInvariant()
        Dim name As String = ReadText(item, "name").Trim()
        If name.Length = 0 OrElse HasControl(name) Then name = host
        name = ClipName(name)
        Dim leaf As String = ReadText(item, "leafPin")
        If Not ExchangeTrust.IsFingerprint(leaf) Then leaf = ""
        Dim key As String = ReadText(item, "keyPin")
        If Not ExchangeTrust.IsFingerprint(key) Then key = ""
        Return New ExchangeAdminTarget(Guid.Parse(id).ToString("D"), name, host, address.Port, leaf, key, ParseUtc(ReadText(item, "lastUsedUtc")))
    End Function

    Private Shared Function ReadText(item As JsonElement, name As String) As String
        Dim p As JsonElement
        If item.TryGetProperty(name, p) AndAlso p.ValueKind = JsonValueKind.String Then Return If(p.GetString(), "")
        Return ""
    End Function

    Private Shared Function ParseUtc(text As String) As DateTime
        Dim parsed As DateTime
        If text.Length > 0 AndAlso DateTime.TryParseExact(text, "O", CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, parsed) Then
            Return ExchangeAdminTarget.AsUtc(parsed)
        End If
        Return ExchangeAdminTarget.AsUtc(DateTime.MinValue)
    End Function

    ' ---- names ----------------------------------------------------------------------------------------------

    Private Shared Function HasControl(text As String) As Boolean
        For Each c As Char In text
            If Char.IsControl(c) Then Return True
        Next
        Return False
    End Function

    Private Shared Function ClipName(text As String) As String
        If text.Length <= MaxNameChars Then Return text
        Dim cut As Integer = MaxNameChars
        If Char.IsHighSurrogate(text(cut - 1)) Then cut -= 1
        Return text.Substring(0, cut)
    End Function

    ''' <summary>The name the person typed, or the host when it is blank. False for a name that is too long or holds a control character.</summary>
    Private Shared Function TryCleanName(name As String, host As String, ByRef clean As String) As Boolean
        Dim t As String = If(name, "").Trim()
        If t.Length = 0 Then
            clean = ClipName(host)
            Return True
        End If
        If t.Length > MaxNameChars OrElse HasControl(t) Then Return False
        clean = t
        Return True
    End Function

    ' ---- writing --------------------------------------------------------------------------------------------

    ''' <summary>Adds a target with no pins. <paramref name="target"/> is the new record on Saved and the record that already holds the
    ''' address on Duplicate; Nothing otherwise. Nothing is written unless the answer is Saved.</summary>
    Public Function Add(name As String, address As String, ByRef target As ExchangeAdminTarget) As ExchangeAdminTargetResult
        target = Nothing
        Dim parsed As ExchangeServerAddress = Nothing
        If Not ExchangeServerAddress.TryParse(address, parsed) Then Return ExchangeAdminTargetResult.BadAddress
        Dim host As String = parsed.Host.ToLowerInvariant()
        Dim clean As String = Nothing
        If Not TryCleanName(name, host, clean) Then Return ExchangeAdminTargetResult.BadName
        Dim list As List(Of ExchangeAdminTarget) = Load()
        Dim endpoint As String = New ExchangeServerAddress(host, parsed.Port).ToString()
        For Each other As ExchangeAdminTarget In list
            If String.Equals(other.Address, endpoint, StringComparison.Ordinal) Then
                target = other
                Return ExchangeAdminTargetResult.Duplicate
            End If
        Next
        If list.Count >= MaxTargets Then Return ExchangeAdminTargetResult.Full
        Dim created As New ExchangeAdminTarget(Guid.NewGuid().ToString("D"), clean, host, parsed.Port, "", "", DateTime.MinValue)
        list.Add(created)
        Write(list)
        target = created
        Return ExchangeAdminTargetResult.Saved
    End Function

    ''' <summary>Changes the name and the address of one target. A changed host or port clears both pins; the same endpoint (the host
    ''' compared in lower case) and a new name keep them. <paramref name="target"/> is the stored record on Saved and the record that
    ''' holds the address on Duplicate; Nothing otherwise.</summary>
    Public Function Edit(id As String, name As String, address As String, ByRef target As ExchangeAdminTarget) As ExchangeAdminTargetResult
        target = Nothing
        Dim parsed As ExchangeServerAddress = Nothing
        If Not ExchangeServerAddress.TryParse(address, parsed) Then Return ExchangeAdminTargetResult.BadAddress
        Dim host As String = parsed.Host.ToLowerInvariant()
        Dim clean As String = Nothing
        If Not TryCleanName(name, host, clean) Then Return ExchangeAdminTargetResult.BadName
        Dim list As List(Of ExchangeAdminTarget) = Load()
        Dim at As Integer = IndexOf(list, id)
        If at < 0 Then Return ExchangeAdminTargetResult.NotFound
        Dim endpoint As String = New ExchangeServerAddress(host, parsed.Port).ToString()
        For i As Integer = 0 To list.Count - 1
            If i <> at AndAlso String.Equals(list(i).Address, endpoint, StringComparison.Ordinal) Then
                target = list(i)
                Return ExchangeAdminTargetResult.Duplicate
            End If
        Next
        Dim current As ExchangeAdminTarget = list(at)
        Dim moved As Boolean = Not String.Equals(current.Host, host, StringComparison.Ordinal) OrElse current.Port <> parsed.Port
        Dim updated As New ExchangeAdminTarget(current.Id, clean, host, parsed.Port, If(moved, "", current.LeafPin), If(moved, "", current.KeyPin), current.LastUsedUtc)
        If Not updated.SameAs(current) Then
            list(at) = updated
            Write(list)
        End If
        target = updated
        Return ExchangeAdminTargetResult.Saved
    End Function

    ''' <summary>Records what the person accepted at first contact. The leaf pin must be a fingerprint; the key pin a fingerprint or "".
    ''' False (nothing written) for another form or an unknown id.</summary>
    Public Function SetPins(id As String, leafPin As String, keyPin As String) As Boolean
        If Not ExchangeTrust.IsFingerprint(leafPin) Then Return False
        If Not String.IsNullOrEmpty(keyPin) AndAlso Not ExchangeTrust.IsFingerprint(keyPin) Then Return False
        Return Update(id, Function(t) t.WithPins(leafPin, If(keyPin, "")))
    End Function

    ''' <summary>"Forget the accepted certificate": clears both pins, so the next sign-in is a first contact again.</summary>
    Public Function ForgetCertificate(id As String) As Boolean
        Return Update(id, Function(t) t.WithPins("", ""))
    End Function

    ''' <summary>Marks the target as used now (the clock this store was given), for the picker's order.</summary>
    Public Function Touch(id As String) As Boolean
        Return Update(id, Function(t) t.WithLastUsed(_clock()))
    End Function

    ''' <summary>Forgets the target. The value itself goes with the last one.</summary>
    Public Function Remove(id As String) As Boolean
        Dim list As List(Of ExchangeAdminTarget) = Load()
        Dim at As Integer = IndexOf(list, id)
        If at < 0 Then Return False
        list.RemoveAt(at)
        Write(list)
        Return True
    End Function

    Private Function Update(id As String, change As Func(Of ExchangeAdminTarget, ExchangeAdminTarget)) As Boolean
        Dim list As List(Of ExchangeAdminTarget) = Load()
        Dim at As Integer = IndexOf(list, id)
        If at < 0 Then Return False
        Dim updated As ExchangeAdminTarget = change(list(at))
        If Not updated.SameAs(list(at)) Then
            list(at) = updated
            Write(list)
        End If
        Return True
    End Function

    Private Sub Write(list As List(Of ExchangeAdminTarget))
        If list.Count = 0 Then
            _port.DeleteValue(ValueName)
            Return
        End If
        Dim ms As New MemoryStream()
        Using w As New Utf8JsonWriter(ms)
            w.WriteStartArray()
            For Each t As ExchangeAdminTarget In list
                w.WriteStartObject()
                w.WriteString("id", t.Id)
                w.WriteString("name", t.Name)
                w.WriteString("host", t.Host)
                w.WriteNumber("port", t.Port)
                w.WriteString("leafPin", t.LeafPin)
                w.WriteString("keyPin", t.KeyPin)
                w.WriteString("lastUsedUtc", If(t.LastUsedUtc = DateTime.MinValue, "", t.LastUsedUtc.ToString("O", CultureInfo.InvariantCulture)))
                w.WriteEndObject()
            Next
            w.WriteEndArray()
        End Using
        _port.SetValue(ValueName, Encoding.UTF8.GetString(ms.ToArray()))
    End Sub

End Class
