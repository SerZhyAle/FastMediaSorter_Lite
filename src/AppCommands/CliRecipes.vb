Option Strict On
Option Explicit On

' docs/guides/COMMAND_LINE_RECIPES.md: the page for people who drive the programs from a script. It is a render
' target like docs/CLI.md (tools/Build-CliDocs.ps1 writes it, -Check and AppCommandsDocsTests hold it): every command
' line in it is an EXAMPLE LINE of a verb in one of the two command tables, picked by verb and shell and never retyped
' here, so a recipe cannot name a verb or an option the program no longer has. An example removed from a table makes
' the generator stop, naming the verb. Neither program uses this file: the viewer's project excludes it with
' CliDocument.vb and the Share Manager does not link it.
Namespace AppCommands

    Friend Module CliRecipes

        Private Const Lf As String = ControlChars.Lf

        Private Function ExampleOf(manifest As CommandManifest, verb As String, shell As String) As CommandExample
            Dim spec As CommandSpec = manifest.Find(verb)
            If spec Is Nothing Then Throw New InvalidOperationException("a recipe names the verb '" & verb & "', which is not in the table")
            For Each x As CommandExample In spec.Examples
                If String.Equals(x.Shell, shell, StringComparison.Ordinal) Then Return x
            Next
            Throw New InvalidOperationException("the verb '" & verb & "' has no " & shell & " example for the recipe to quote")
        End Function

        Private Sub Block(sb As System.Text.StringBuilder, manifest As CommandManifest, verb As String, shell As String)
            Dim x As CommandExample = ExampleOf(manifest, verb, shell)
            sb.Append(Lf).Append("```").Append(If(String.Equals(shell, "powershell", StringComparison.Ordinal), "powershell", "bat")).Append(Lf)
            sb.Append(x.Line).Append(Lf).Append("```").Append(Lf)
            sb.Append(Lf).Append("Expect: ").Append(x.Expect).Append(".").Append(Lf)
        End Sub

        Private Function RiskOf(manifest As CommandManifest, verb As String) As String
            Return manifest.Find(verb).Risk
        End Function

        Friend Function Markdown() As String
            Dim viewer As CommandManifest = ViewerCommandTable.Build()
            Dim manager As CommandManifest = ShareManagerCommandTable.Build()
            Dim sb As New System.Text.StringBuilder()
            sb.Append("# Command line recipes").Append(Lf).Append(Lf)
            sb.Append("This page is generated by `tools/Build-CliDocs.ps1` from the command tables in code; edit the tables, never this file. ")
            sb.Append("Every command line below is an example line of a verb in the table of its program, and `docs/CLI.md` is the full reference: ")
            sb.Append("every verb, option, risk class and exit code. Both programs answer the same strict command line (contract `APP-COMMANDS` 0.1).").Append(Lf).Append(Lf)

            sb.Append("## Running a command from a script").Append(Lf).Append(Lf)
            sb.Append("The programs are Windows-subsystem programs, so a shell does not wait for them on its own. ")
            sb.Append("`start /wait` (cmd) and `Start-Process -Wait` (PowerShell) wait and give the exit code: 0 is done, 10 is a mistake in the command line, ")
            sb.Append("11 is nothing running, a busy window or a missing target, 12 is the setting below being off, 2 is a result that could not be proven (no answer in time, or an older copy that does not know commands).").Append(Lf).Append(Lf)
            sb.Append("A command that works with files, the screen, the clipboard or the network is held by one setting, **")
            sb.Append(ViewerCommandTable.SettingLabelEnglish).Append("**, which is off until the person turns it on in the settings of the program. ")
            sb.Append("While it is off, such a command ends with exit 12 and does nothing; the commands of the risk class `safe` work either way.").Append(Lf).Append(Lf)

            sb.Append("## Find out what a program accepts").Append(Lf).Append(Lf)
            sb.Append("Each program prints the table it answers from, as JSON, without starting a window. The viewer:").Append(Lf)
            Block(sb, viewer, "commands", "powershell")
            sb.Append(Lf).Append("The Share Manager:").Append(Lf)
            Block(sb, manager, "commands", "powershell")

            sb.Append(Lf).Append("## Schedule a copy of a folder").Append(Lf).Append(Lf)
            sb.Append("Scheduled file operations belong to the Share Manager and run while it runs in the signed-in session. ")
            sb.Append("The script opens the schedule window with the folder as its source (`schedule open` is in the risk class `")
            sb.Append(RiskOf(manager, "schedule open")).Append("`); the person chooses the action, the destination and the time in the window and saves. ")
            sb.Append("The script then reads back what is scheduled (`schedule list` is in the risk class `")
            sb.Append(RiskOf(manager, "schedule list")).Append("`). The answer names each operation by id, name, action, state and next run; it carries no folder, no file name and no error text.").Append(Lf)
            Block(sb, manager, "schedule open", "cmd")
            Block(sb, manager, "schedule list", "powershell")

            sb.Append(Lf).Append("## Schedule a daily backup of a folder").Append(Lf).Append(Lf)
            sb.Append("A script can create or update a daily backup operation (`schedule add` is in the risk class `")
            sb.Append(RiskOf(manager, "schedule add")).Append("`), queue a run now and wait for the result (`schedule run`, `")
            sb.Append(RiskOf(manager, "schedule run")).Append("`), read the run journal (`schedule history`, `")
            sb.Append(RiskOf(manager, "schedule history")).Append("`) and remove the definition without deleting backup files (`schedule remove`, `")
            sb.Append(RiskOf(manager, "schedule remove")).Append("`). Re-running `schedule add` with the same action, source and destination updates the existing operation.").Append(Lf)
            Block(sb, manager, "schedule add", "powershell")
            Block(sb, manager, "schedule run", "powershell")
            Block(sb, manager, "schedule history", "powershell")
            Block(sb, manager, "schedule remove", "cmd")

            sb.Append(Lf).Append("## Save a screenshot of the viewer window to a file").Append(Lf).Append(Lf)
            sb.Append("The viewer writes its own window as a PNG to the path given, used exactly as written. A folder as the path gets a file named by the date and time inside it, ")
            sb.Append("a relative path is relative to the folder the script runs in, and an existing file is kept unless `--overwrite` is given. ")
            sb.Append("`screenshot window` is in the risk class `").Append(RiskOf(viewer, "screenshot window")).Append("`.").Append(Lf)
            Block(sb, viewer, "screenshot window", "powershell")

            Return sb.ToString().TrimEnd(ControlChars.Lf) & Lf
        End Function

    End Module

End Namespace
