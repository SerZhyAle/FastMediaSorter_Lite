#If Not NETFRAMEWORK Then
Option Strict On
Option Explicit On

Imports System
Imports System.Collections.Generic
Imports System.Globalization
Imports System.Text

Namespace Streams

    ''' <summary>
    ''' The closed value sets of the stream catalog's <c>language</c> and <c>country</c> columns (STREAM-BANK rule 14, item O)
    ''' and the fold that brings a raw playlist value into them. The tables are the catalog's published ones
    ''' (<see cref="StreamFacetTables"/>, generated by <c>tools/Export-StreamFacetTables.ps1</c>, never edited by hand); this
    ''' class holds the rules the contract text states and the golden vectors pin
    ''' (<c>tests/Lite.Tests/TestData/stream-facets/facet-golden.tsv</c>, replayed by <c>StreamFacetFoldTests</c>).
    ''' </summary>
    ''' <remarks>
    ''' Pure: no I/O, no culture dependence (<c>ToLowerInvariant</c>, ordinal comparers), safe from any thread.
    ''' <para>
    ''' <b>Language.</b> The cell is split on comma, semicolon, slash and vertical bar. Each piece is folded (lower case,
    ''' diacritics of Latin letters removed, dashes made one hyphen, punctuation read as a space) and looked up as a WHOLE
    ''' first - as a canonical name, an alias, or a bare ISO 639-1 / 639-2 / named-extension code, which is the only place a
    ''' code is read. A piece that names no language is split on spaces (and on a hyphen inside a word); a word is looked
    ''' up as a name or an alias only, so <c>english uk</c> is English, not English and Ukrainian. A word that names no
    ''' language is dropped when the cell named at least one; a non-blank cell that named none is <c>english</c>, a blank
    ''' cell stays blank. The result is the canonical names in order of first appearance, no repeats, joined by a comma.
    ''' </para>
    ''' <para>
    ''' <b>Country.</b> One assigned ISO 3166-1 alpha-2 code, upper case. A name or alias (case, diacritics and spacing
    ''' folded) gives its code, a bare two-letter value is taken as a code, and whatever is not an assigned code after that -
    ''' <c>XX</c>, a continent number, <c>US;CA</c> - is blank, never kept as text.
    ''' </para>
    ''' </remarks>
    Friend NotInheritable Class StreamFacetFold

        Private Sub New()
        End Sub

        ''' <summary>What an unrecognised but non-blank language cell becomes (rule 14).</summary>
        Friend Const FallbackLanguage As String = "english"

        Private NotInheritable Class FacetIndex
            Friend ReadOnly LanguageNames As New HashSet(Of String)(StringComparer.Ordinal)
            Friend ReadOnly LanguageAliases As New Dictionary(Of String, String())(StringComparer.Ordinal)
            Friend ReadOnly LanguageCodes As New Dictionary(Of String, String)(StringComparer.Ordinal)
            Friend ReadOnly CountryAssigned As New HashSet(Of String)(StringComparer.Ordinal)
            Friend ReadOnly CountryAliases As New Dictionary(Of String, String)(StringComparer.Ordinal)
            Friend ReadOnly CountryNames As New Dictionary(Of String, String)(StringComparer.Ordinal)
        End Class

        Private Shared ReadOnly Tables As FacetIndex = BuildIndex()

        Private Shared Function BuildIndex() As FacetIndex
            Dim index As New FacetIndex()

            For Each row As String In StreamFacetTables.LanguageVocabulary
                Dim f As String() = row.Split("|"c)
                index.LanguageNames.Add(f(0))
                AddCode(index, f(1), f(0))
                For Each code As String In f(2).Split(","c)
                    AddCode(index, code, f(0))
                Next
                AddCode(index, f(3), f(0))
            Next

            ' A table key is indexed by the SAME fold the input goes through. The published keys are not all in one Unicode
            ' form (the Korean region names are decomposed jamo, the Korean language alias is a composed syllable string),
            ' so a lookup by the raw key would miss the same text typed the other way; the first row of a folded key wins.
            For Each row As String In StreamFacetTables.LanguageAliases
                Dim f As String() = row.Split("|"c)
                Dim key As String = CleanPiece(FoldKey(f(0)))
                If Not index.LanguageAliases.ContainsKey(key) Then index.LanguageAliases.Add(key, f(1).Split(","c))
            Next

            For Each code As String In StreamFacetTables.CountryAssigned
                index.CountryAssigned.Add(code.Split("|"c)(0))
            Next

            For Each row As String In StreamFacetTables.CountryAliases
                Dim f As String() = row.Split("|"c)
                Dim key As String = FoldKey(f(0))
                If Not index.CountryAliases.ContainsKey(key) Then index.CountryAliases.Add(key, f(1))
            Next

            For Each row As String In StreamFacetTables.CountryNames
                Dim f As String() = row.Split("|"c)
                Dim key As String = FoldKey(f(0))
                If Not index.CountryNames.ContainsKey(key) Then index.CountryNames.Add(key, f(1))
            Next

            Return index
        End Function

        Private Shared Sub AddCode(index As FacetIndex, code As String, name As String)
            If code.Length = 0 Then Return
            If Not index.LanguageCodes.ContainsKey(code) Then index.LanguageCodes.Add(code, name)
        End Sub

        ' ---- the closed sets, for the validator -----------------------------------------------------------------

        ''' <summary>True when <paramref name="name"/> is a canonical entry of the closed language vocabulary.</summary>
        Friend Shared Function IsLanguageName(name As String) As Boolean
            Return name IsNot Nothing AndAlso Tables.LanguageNames.Contains(name)
        End Function

        ''' <summary>True when <paramref name="code"/> is one of the officially assigned ISO 3166-1 alpha-2 codes.</summary>
        Friend Shared Function IsAssignedCountry(code As String) As Boolean
            Return code IsNot Nothing AndAlso Tables.CountryAssigned.Contains(code)
        End Function

        ' ---- the folds -----------------------------------------------------------------------------------------

        ''' <summary>
        ''' Folds a raw <c>language</c> value to the closed set: canonical names, comma-joined, in order of first appearance.
        ''' Blank stays blank; a non-blank value that names no language is <see cref="FallbackLanguage"/>.
        ''' </summary>
        Friend Shared Function FoldLanguage(raw As String) As String
            If String.IsNullOrWhiteSpace(raw) Then Return String.Empty

            Dim found As New List(Of String)()
            Dim nonBlank As Boolean = False

            For Each rawPiece As String In raw.Split(New Char() {","c, ";"c, "/"c, "|"c})
                If rawPiece.Trim().Length = 0 Then Continue For
                nonBlank = True

                Dim piece As String = CleanPiece(FoldKey(rawPiece))
                If piece.Length = 0 Then Continue For

                ' The piece as a whole first: a name, an alias ("pt-br", "bahasa indonesia") or a bare code.
                Dim code As String = Nothing
                If TryNameOrAlias(piece, found) Then Continue For
                If Tables.LanguageCodes.TryGetValue(piece, code) Then
                    AddUnique(found, code)
                    Continue For
                End If

                ' Otherwise by words. A word is a name or an alias, never a bare code.
                For Each word As String In piece.Split(New Char() {" "c}, StringSplitOptions.RemoveEmptyEntries)
                    If Not TryNameOrAlias(word, found) AndAlso word.IndexOf("-"c) >= 0 Then
                        For Each part As String In word.Split(New Char() {"-"c}, StringSplitOptions.RemoveEmptyEntries)
                            TryNameOrAlias(part, found)
                        Next
                    End If
                Next
            Next

            If found.Count > 0 Then Return String.Join(",", found)
            Return If(nonBlank, FallbackLanguage, String.Empty)
        End Function

        ''' <summary>
        ''' Folds a raw <c>country</c> value to one assigned ISO 3166-1 alpha-2 code (upper case) or to blank.
        ''' </summary>
        Friend Shared Function FoldCountry(raw As String) As String
            If String.IsNullOrWhiteSpace(raw) Then Return String.Empty

            Dim key As String = FoldKey(raw)
            If key.Length = 0 Then Return String.Empty

            Dim code As String = Nothing
            If Not Tables.CountryAliases.TryGetValue(key, code) AndAlso Not Tables.CountryNames.TryGetValue(key, code) Then
                If key.Length <> 2 OrElse Not IsAsciiLetter(key(0)) OrElse Not IsAsciiLetter(key(1)) Then Return String.Empty
                code = key.ToUpperInvariant()
            End If

            Return If(Tables.CountryAssigned.Contains(code), code, String.Empty)
        End Function

        ' ---- the key fold: case, diacritic and dash folding, spacing -----------------------------------------------

        ''' <summary>
        ''' The key a table row is looked up by: lower case; the diacritics of LATIN letters removed (a Cyrillic
        ''' <c>й</c> or a Greek <c>ά</c> keeps its mark - the published keys do); every dash a plain hyphen; runs of
        ''' white space one space; trimmed; composed (NFC) so the same text typed either way is one key. Idempotent, and
        ''' applied to the table keys when the index is built as well as to every input.
        ''' </summary>
        Friend Shared Function FoldKey(text As String) As String
            If String.IsNullOrEmpty(text) Then Return String.Empty

            Dim decomposed As String = SafeNormalize(text.ToLowerInvariant(), NormalizationForm.FormD)
            Dim sb As New StringBuilder(decomposed.Length)
            Dim baseIsLatin As Boolean = False
            Dim pendingSpace As Boolean = False

            For Each c As Char In decomposed
                Dim code As Integer = AscW(c)
                If code >= &H300 AndAlso code <= &H36F Then
                    If Not baseIsLatin Then sb.Append(c)
                    Continue For
                End If

                If Char.IsWhiteSpace(c) Then
                    If sb.Length > 0 Then pendingSpace = True
                    baseIsLatin = False
                    Continue For
                End If

                If pendingSpace Then
                    sb.Append(" "c)
                    pendingSpace = False
                End If

                If Char.GetUnicodeCategory(c) = UnicodeCategory.DashPunctuation Then
                    sb.Append("-"c)
                Else
                    sb.Append(c)
                End If
                baseIsLatin = IsLatinLetter(c)
            Next

            Return SafeNormalize(sb.ToString(), NormalizationForm.FormC)
        End Function

        ' Normalize throws on a lone surrogate, which a playlist decoded from broken bytes can carry; such a value is
        ' folded as it stands (it will name nothing) instead of failing the whole catalogue build.
        Private Shared Function SafeNormalize(text As String, form As NormalizationForm) As String
            Try
                Return text.Normalize(form)
            Catch ex As ArgumentException
                Return text
            End Try
        End Function

        ' A language piece reads every punctuation mark as a space ("#english", "english.", "português (brasil)",
        ' "язык: русский"); letters, digits, combining marks, the joiners of Indic and Persian scripts, the surrogates of
        ' supplementary scripts and the hyphen stay.
        Private Shared Function CleanPiece(folded As String) As String
            Dim sb As New StringBuilder(folded.Length)
            Dim pendingSpace As Boolean = False

            For Each c As Char In folded
                If KeepsInWord(c) Then
                    If pendingSpace AndAlso sb.Length > 0 Then sb.Append(" "c)
                    pendingSpace = False
                    sb.Append(c)
                ElseIf Char.GetUnicodeCategory(c) = UnicodeCategory.Format Then
                    ' a byte-order mark or a zero-width space is invisible, not a word break
                Else
                    pendingSpace = True
                End If
            Next

            Return sb.ToString()
        End Function

        Private Shared Function KeepsInWord(c As Char) As Boolean
            If c = "-"c Then Return True
            If c = ChrW(&H200C) OrElse c = ChrW(&H200D) Then Return True
            If Char.IsLetterOrDigit(c) OrElse Char.IsSurrogate(c) Then Return True
            Select Case Char.GetUnicodeCategory(c)
                Case UnicodeCategory.NonSpacingMark, UnicodeCategory.SpacingCombiningMark, UnicodeCategory.EnclosingMark
                    Return True
                Case Else
                    Return False
            End Select
        End Function

        Private Shared Function TryNameOrAlias(key As String, found As List(Of String)) As Boolean
            Dim targets As String() = Nothing
            If Tables.LanguageNames.Contains(key) Then
                AddUnique(found, key)
                Return True
            End If
            If Tables.LanguageAliases.TryGetValue(key, targets) Then
                For Each target As String In targets
                    AddUnique(found, target)
                Next
                Return True
            End If
            Return False
        End Function

        Private Shared Sub AddUnique(found As List(Of String), name As String)
            If Not found.Contains(name) Then found.Add(name)
        End Sub

        Private Shared Function IsLatinLetter(c As Char) As Boolean
            Return (c >= "a"c AndAlso c <= "z"c) OrElse
                   (c >= "A"c AndAlso c <= "Z"c) OrElse
                   (c >= ChrW(&HC0) AndAlso c <= ChrW(&H24F)) OrElse
                   (c >= ChrW(&H1E00) AndAlso c <= ChrW(&H1EFF))
        End Function

        Private Shared Function IsAsciiLetter(c As Char) As Boolean
            Return (c >= "a"c AndAlso c <= "z"c) OrElse (c >= "A"c AndAlso c <= "Z"c)
        End Function

    End Class

End Namespace
#End If
