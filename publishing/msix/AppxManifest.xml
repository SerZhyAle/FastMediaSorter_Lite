<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package manifest for Fast Media Sorter & Sharing for Windows (Microsoft Store / sideload; the Store name stays FastMediaSorter LITE).

  This wraps FastMediaSorter_LITE.exe - the .NET 10 x64 mainline viewer, published self-contained
  (the runtime is inside the exe) - plus its offline payload (LibVLC, Tesseract tessdata, flag
  assets) as a FULL-TRUST desktop app. The package is x64-only and carries the mainline ALONE: the
  net48 FastMediaSorter_x86.exe sibling that ships next to it in the GitHub/winget package exists
  for Windows 7/8.1 and 32-bit machines, which cannot get an MSIX from the Store anyway -
  msix\build-msix.ps1 excludes it from the stage.
  Every Win32 API the app uses keeps working - native LibVLC playback (the mainline's only video
  engine; the retired IE WebBrowser control is not hosted at all), System.Drawing/GDI+, arbitrary
  file-system access for sorting media (including \\server shares), and the optional local HTTP
  calls to an Ollama / LibreTranslate endpoint - all guarded by the single `runFullTrust`
  restricted capability.

  Under MSIX the install dir is READ-ONLY, but FastMediaSorter already writes everything mutable
  (downloaded tessdata, OCR cache, settings) under %LOCALAPPDATA%\SZA\FastMediaSorter (see
  src/Ocr/TesseractOcrEngine.vb OcrPaths) and the registry, both of which are virtualized and
  writable per-package - so no app code change is needed.

  The __PLACEHOLDERS__ are filled in by msix\build-msix.ps1 at pack time:
    __IDENTITY_NAME__     Package identity Name - MUST match the value reserved for you in
                          Partner Center (Product > Product identity > "Package/Identity/Name").
    __PUBLISHER__         Publisher - MUST match exactly (Partner Center "Package/Identity/Publisher",
                          e.g. CN=ABCD1234-...). For local self-signed testing it must instead match
                          the test certificate's subject (build-msix.ps1 -SelfSign keeps them equal).
    __PUBLISHER_DISPLAY__ Human-readable publisher name (Partner Center "Package/Properties/PublisherDisplayName").
    __VERSION__           4-part version with the 4th part = 0 (the Store reserves the revision).
                          build-msix.ps1 derives it from the exe's YY.M.D.HHmm stamp.
  The DisplayName below stays "FastMediaSorter LITE" (the reserved Store name) - do NOT
  rename it or the submission is rejected. The product's visible name changed (ticket 111),
  but the owner decided on 2026-10-03 that the Store name does not: only the in-app
  inscriptions and the Partner Center listing DESCRIPTION text carry the new name; see
  docs/guides/PRODUCT_NAMING.md and docs/guides/STORE_PUBLISHING.md. The Share Manager
  application further down keeps the Share Manager name (an in-package label, not the
  Store name).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop2 rescap">

  <Identity
    Name="__IDENTITY_NAME__"
    Publisher="__PUBLISHER__"
    Version="__VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>FastMediaSorter LITE</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 10.0.17763 (1809) is a safe Store floor for desktop MSIX. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="FastMediaSorterLITE" Executable="FastMediaSorter_LITE.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="FastMediaSorter LITE"
        Description="Sort, view and share your images and videos: slideshow, panel navigation, one-key move/copy/rename/delete, on-image OCR translation, and sharing folders with your phone."
        BackgroundColor="#171B26"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- Let users set FastMediaSorter as a handler / default for common image formats.
             Mirrors the per-user associations the Inno installer registers - only formats
             the x64 mainline can DISPLAY (Main_Form.FileAssociation.vb): no .svg, which
             neither viewer decodes. .tif stays: GDI+ reads it and the viewer's own lists
             gain it too (owner decision 2026-09-25, ticket 055 I-02). -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="fastmediasorterimages">
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.jpg</uap:FileType>
              <uap:FileType>.jpeg</uap:FileType>
              <uap:FileType>.png</uap:FileType>
              <uap:FileType>.gif</uap:FileType>
              <uap:FileType>.bmp</uap:FileType>
              <uap:FileType>.tif</uap:FileType>
              <uap:FileType>.tiff</uap:FileType>
              <uap:FileType>.ico</uap:FileType>
              <uap:FileType>.webp</uap:FileType>
              <uap:FileType>.heic</uap:FileType>
              <uap:FileType>.heif</uap:FileType>
              <uap:FileType>.avif</uap:FileType>
              <uap:FileType>.jxl</uap:FileType>
              <uap:FileType>.wmf</uap:FileType>
              <uap:FileType>.emf</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <!-- Live-broadcast descriptors a phone or a watch sends (spec 023, LIVE-BROADCAST section 4.2): the
             .fmsbcast extension with its declared MIME type. Declarative, so Windows offers the app in Open with
             and the user chooses; nothing here claims a default. Only this x64 mainline exe opens them - the
             package never carries the x86 fallback. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="fastmediasorterlivebroadcast">
            <uap:DisplayName>Live broadcast</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType ContentType="application/vnd.fms.bcast+json">.fmsbcast</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>

    <!-- Second app in the SAME package: the Android Folder Share companion
         ("Share Manager - Fast Media Sorter & Sharing", net10 self-contained exe). One MSIX,
         one Store product, two Start-menu tiles. The bundled Go SFTP worker
         (companion\fms-share-worker.exe) is just a payload file this app launches. -->
    <Application Id="FastMediaSorterShareManager" Executable="FastMediaSorterCompanion.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Share Manager - Fast Media Sorter &amp; Sharing"
        Description="Share your PC folders with the Android app over a local SFTP server, paired by scanning a QR code."
        BackgroundColor="#171B26"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- Optional logon autostart, disabled by default (opt-in). Inside an MSIX
             container an HKCU\Run write is virtualized away, so autostart must be a
             manifest StartupTask; the user enables it in Settings > Startup apps. -->
        <uap5:Extension Category="windows.startupTask" Executable="FastMediaSorterCompanion.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="FastMediaSorterShareManagerAutostart" Enabled="false" DisplayName="Share Manager - Fast Media Sorter &amp; Sharing" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <!-- Package-level extensions. Inbound firewall allow for the bundled SFTP worker
       so LAN / internet peers can reach a share - the MSIX equivalent of the Inno
       installer's netsh step (a netsh/HKCU change can't be made from inside the
       container). windows.firewallRules MUST be declared here, under <Package>, not
       under an <Application>. Still gated by the app's own opt-in before a share runs. -->
  <Extensions>
    <desktop2:Extension Category="windows.firewallRules">
      <desktop2:FirewallRules Executable="companion\fms-share-worker.exe">
        <desktop2:Rule Direction="in" IPProtocol="TCP" Profile="all" />
      </desktop2:FirewallRules>
    </desktop2:Extension>
  </Extensions>

  <Capabilities>
    <!-- Full-trust desktop app: keeps native LibVLC playback, GDI+,
         user-level file access for media sorting, and optional local translation HTTP calls. -->
    <rescap:Capability Name="runFullTrust" />
    <!-- Live broadcaster audio capture from microphone for live streams. -->
    <DeviceCapability Name="microphone" />
    <!-- Live broadcaster camera capture from webcam for live streams. -->
    <DeviceCapability Name="webcam" />
  </Capabilities>
</Package>
