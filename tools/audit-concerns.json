{
  "_about": [
    "Concern map of the pre-release full code audit (ticket 057). Read by tools/Audit-Partition.ps1.",
    "Paths are repository-relative with forward slashes; patterns are globs: '*' stays inside one folder, '**' crosses folders, matching ignores case.",
    "A file is classified in this order: skipped directory -> excluded -> data -> the FIRST concern whose pattern matches. A class A file that matches no concern is reported as unmapped and counted as uncovered.",
    "Concern order matters twice: first match wins, and a concern smaller than a quarter of the line limit is merged into the concern before it (the one after it, for the first).",
    "groupAliases keeps a Main_Form partial and its pure helper in one slice when their names differ: the partial Main_Form.X.vb has group key X, any other file the part of its name before the first dot."
  ],
  "roots": [
    "src/**/*.vb",
    "publishing/installer/*.ps1",
    "publishing/installer/*.iss"
  ],
  "classBRoots": [
    "tests/**/*.vb",
    "tests/**/*.ps1",
    "tools/**/*.ps1",
    "build.ps1",
    ".github/**/*.yml",
    "publishing/msix/*.ps1",
    "publishing/store/*.ps1"
  ],
  "skipDirs": [ "bin", "obj", "packages", "TestResults", "ocr-cache" ],
  "excluded": [
    {
      "pattern": "**/*.Designer.vb",
      "reason": "generated by the WinForms designer and never edited by hand; its behaviour is audited through the partial that owns the form"
    }
  ],
  "data": [
    {
      "pattern": "src/Localization/Localization.*.vb",
      "except": [ "src/Localization/Localization.Persistence.vb", "src/Localization/Localization.Registry.vb" ],
      "coveredBy": "LocalizationParityTests, LocalizationCoverageTests",
      "sampledBy": "L-localization"
    },
    {
      "pattern": "src/FastMediaSorterCompanion/Localization/Localization.*.vb",
      "except": [ "src/FastMediaSorterCompanion/Localization/Localization.Registry.vb" ],
      "coveredBy": "LocalizationParityTests, LocalizationCoverageTests",
      "sampledBy": "L-localization"
    }
  ],
